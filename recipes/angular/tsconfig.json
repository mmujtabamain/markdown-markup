{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"]
}
