{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "mkp-recipe": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "loader": { ".md": "text" }
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "mkp-recipe:build" } }
      }
    }
  }
}
