# The tidy tree of 18.2, fed by reader state: each step adds nodes, keyed items glide to their new
# places, and the arrows are measured again as they move.
fn leaf(id: text, label: text): tnode = {id: id, label: label, kids: []}

growing@1 "A tree that grows a level at a time while its arrows follow the moving nodes."
  stage = steps 5 play=6s "growth"
  b = {id: "b", label: "left", kids: if(stage >= 2, [leaf("d", "x"), leaf("e", "y")], [])}
  c = {id: "c", label: "right", kids: if(stage >= 3, [leaf("f", "z")], [])}
  late = if(stage == 4, [b, leaf("g", "new"), c], [b, c])
  root = {id: "a", label: "root", kids: if(stage >= 1, late, [])}
  tree node=root
  text "Step \val{stage + 1}: \val{len(root.kids)} children at the top." tone=muted
