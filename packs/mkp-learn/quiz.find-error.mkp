quiz.find-error@1 "A worked solution with a mistake in it: the reader picks the wrong step, checked as soon as it is picked, and sees why, and the fix."
  in question text "the problem the solution sets out to solve"
  in lines list(record line {text: text, wrong: bool = false, why: text = "", fix: text = ""}) "the steps; mark the wrong one, with why and the corrected step"
  in label text = "Question" "the caption before the title: what the question belongs to (Practice, Review)"
  in title text = "Find the mistake" "the header's title, what the reader does"
  in help text = "One step is wrong. Which?" "under the question, small: how to answer"
  in hints list(record hint {text: text})
  in next slot "the caller's own buttons, after the question's in its bar (a set's Next)"
  out correct
  out wrong
  signal answered {correct: bool, step: int} "sent on every check, with the picked step from 1"
  var picked int = -1
  var result choice(none|pass|fail) = none
  var calm color = none
  n = len(lines)
  locked = result != none
  faults = filter(range(0, n - 1), k => lines[k].wrong)
  fn explain(k: int): text = "Step " + (k + 1) + " is wrong" + if(lines[k].why == "", ".", ": " + lines[k].why + ".") + if(lines[k].fix == "", "", " It should read " + lines[k].fix + ".")
  fn verdict(k: int): color = if(locked and picked == k, if(lines[k].wrong, ok, bad), ink)
  say = if(result == none, "Pick the step with the mistake.", if(result == pass, "**Correct.** " + explain(max(picked, 0)),
      "**Not quite.** Step \val{picked + 1} is fine" + if(picked >= 0 and lines[max(picked, 0)].why != "", ": " + lines[max(picked, 0)].why + ".", ".") + " Look again."))
  mood = if(result == none, calm, if(result == pass, ok, bad))
  sol = map(faults, k => explain(k))
  project md = (question + "\n\n" + join(map(range(0, n - 1), k => "" + (k + 1) + ". " + lines[k].text), "\n")
      + "\n\n:::details \"Answer\"\n" + join(map(faults, k => explain(k)), "\n\n") + "\n:::\n")
  frame kind=label title=title tone=mood
    fill actions
      quiz.hints hints=(map(hints, h => h.text)) if=(len(hints) > 0)
      quiz.answer items=sol word="answer"
    stack pad=l gap=m
      stack gap=xs
        text question weight=medium size=large
        text help size=small tone=muted if=(help != "")
      stack gap=s
        each k in 0..(n - 1)
          stack dim=(locked and picked != k)
            press id=("step" + (k + 1)) kind=radio selected=(picked == k) if=(not locked and lines[k].wrong)
              flex gap=m align=baseline wrap=false
                text ("" + (k + 1)) font=mono size=small tone=muted
                text lines[k].text
              @click set picked=k result=pass send answered correct=true step=(k + 1) emit correct
            press id=("step" + (k + 1)) kind=radio selected=(picked == k) if=(not locked and not lines[k].wrong)
              flex gap=m align=baseline wrap=false
                text ("" + (k + 1)) font=mono size=small tone=muted
                text lines[k].text
              @click set picked=k result=fail send answered correct=false step=(k + 1) emit wrong
            # answered: the pick stands until Try again
            press id=("step" + (k + 1)) kind=radio selected=(picked == k) tone=(verdict(k)) if=locked
              flex gap=m align=baseline wrap=false
                text ("" + (k + 1)) font=mono size=small tone=muted
                text lines[k].text
    fill bar
      # the line says what to do or how it went; on a narrow screen the buttons wrap under it
      flex gap=s align=center justify=between grow
        flex gap=s align=baseline wrap=false grow basis=s
          icon name=check tone=ok size=small if=(result == pass)
          icon name=cross tone=bad size=small if=(result == fail)
          text say tone=(if(result == none, muted, ink))
        flex gap=s align=center
          press id=again if=(result == fail)
            icon name=reset size=small
            text "Try again"
            @click set picked=-1 result=none
          slot next
