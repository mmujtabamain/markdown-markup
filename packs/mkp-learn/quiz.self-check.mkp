quiz.self-check@1 "A question to answer in your head or on paper: the model answer waits blurred until revealed, then the reader rates themselves."
  in question text "the question"
  in answer text "the model answer, with maths"
  in prompt text = "Answer it yourself first, then compare." "what the bar says before the answer is shown"
  in label text = "Self-check" "the caption before the title: what the question belongs to"
  in title text = "Answer it yourself" "the header's title, what the reader does"
  in next slot "the caller's own buttons, after the question's in its bar (a set's Next)"
  out correct
  out wrong
  signal answered {correct: bool, rating: text} "sent when the reader rates themselves: got it, partly or not yet"
  var open bool = false
  var rating choice(none|got|partly|missed) = none
  var calm color = none
  say = if(not open, prompt, if(rating == none, "How did you do? Rate yourself honestly.", if(rating == got, "**Good.** Come back to it in a few days to be sure.",
      if(rating == partly, "**Partly.** Compare your answer step by step with this one, and try it again later.", "**Not yet.** Work through the answer, then try the question again later."))))
  mood = if(rating == none, calm, if(rating == got, ok, if(rating == partly, info, bad)))
  project md = question + "\n\n:::details \"Answer\"\n" + answer + "\n:::\n"
  frame kind=label title=title tone=mood
    stack pad=l gap=m
      text question weight=medium
      # always there at its size: blurred until revealed, so revealing moves nothing
      stack gap=xs pad=m stroke=muted radius=card fill=surface blur=(not open)
        text "Model answer" font=mono size=small tone=muted caps=true
        text answer
      flex gap=m align=center dim=(not open)
        text "How did you do?" size=small tone=muted
        flex gap=xs
          press id=got kind=option selected=(rating == got) disabled=(not open)
            text "Got it"
            @click set rating=got send answered correct=true rating="got it" emit correct
          press id=partly kind=option selected=(rating == partly) disabled=(not open)
            text "Partly"
            @click set rating=partly send answered correct=false rating="partly" emit wrong
          press id=missed kind=option selected=(rating == missed) disabled=(not open)
            text "Not yet"
            @click set rating=missed send answered correct=false rating="not yet" emit wrong
    fill bar
      # the line says what to do or how it went; on a narrow screen the buttons wrap under it
      flex gap=s align=center justify=between grow
        flex gap=s align=baseline wrap=false grow basis=s
          icon name=check tone=ok size=small if=(rating == got)
          text say tone=(if(open, ink, muted))
        flex gap=s align=center
          press id=reveal emphasis=high if=(not open)
            icon name=eye size=small
            text "Reveal"
            @click set open=true
          press id=hide if=(open)
            icon name=reset size=small
            text "Ask me again"
            @click set open=false rating=none
          slot next
