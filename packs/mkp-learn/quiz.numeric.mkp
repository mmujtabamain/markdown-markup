quiz.numeric@1 "A question with a numeric answer, known wrong answers, hints and a worked solution."
  in question text "the question, with maths"
  in answer num "the right value"
  in tolerance num = 0.000001 "how close counts as right"
  in wrongs list(record wrong {value: num, why: text}) "known wrong answers and why"
  in hints list(record hint {text: text})
  in solutions list(record solution {text: text})
  out correct
  out wrong
  signal answered {correct: bool, value: num} "sent on every check"
  var entry text = ""
  var tries int = 0
  var hinted int = 0
  var result choice(none|pass|fail) = none
  var solved bool = false
  got = parse(entry, [])()
  right = abs(got - answer) <= tolerance
  known = find(wrongs, w => abs(w.value - got) <= tolerance, {value: 0, why: ""})
  stack gap=m pad=m stroke=muted radius=card
    text question
    flex gap=s align=center
      field entry kind=number label="your answer"
      press if=(right)
        text "Check"
        @click set tries=(tries + 1) result=pass send answered correct=true value=got emit correct
      press if=(not right)
        text "Check"
        @click set tries=(tries + 1) result=fail send answered correct=false value=got emit wrong
    text "Right." tone=ok if=(result == pass)
    text "Not quite." tone=bad if=(result == fail and known.why == "")
    text known.why tone=bad if=(result == fail and known.why != "")
    each k in 0..(hinted - 1)
      text hints[k].text tone=muted
    flex gap=s if=(hinted < len(hints) or (len(solutions) > 0 and not solved))
      press if=(hinted < len(hints))
        text "Hint"
        @click set hinted=(hinted + 1)
      press if=(len(solutions) > 0 and not solved)
        text "Show the solution"
        @click set solved=true
    stack gap=s if=(solved)
      each sol in solutions
        text sol.text
