part quiz.hints@1 "Hints one at a time, in a popover over the page, so a hint never pushes anything down: the anchor is a lightbulb and how many are shown."
  in hints list(text) "the hints, in the order they are given"
  var shown int = 0
  n = len(hints)
  overlay mode=popover emphasis=low label=("Hints, " + shown + " of " + n + " shown")
    flex gap=xs align=center wrap=false
      icon name=lightbulb size=small
      text ("" + shown + "/" + n) font=mono size=small tone=muted
    @open set shown=(max(shown, 1))
    fill body
      stack gap=s
        each k in 0..(shown - 1)
          stack gap=xs
            text ("Hint " + (k + 1)) font=mono size=small tone=warn caps=true
            text hints[k]
          divider
        flex gap=s justify=between align=center
          text (if(shown < n, "" + (n - shown) + " more", "That is every hint.")) size=small tone=muted
          press emphasis=low if=(shown < n)
            icon name=lightbulb size=small
            text "Another hint"
            @click set shown=(shown + 1)

part quiz.answer@1 "The worked solution in a popover over the page, behind one more press so it is never read by accident."
  in items list(text) "the solution, one paragraph each"
  in word text = "solution" "what it is called: solution, answer, order"
  in plain bool = false "the anchor says Show the solution in words (in a bar); else it is a book icon (in a header)"
  in spoil bool = true "ask once more before showing it; false: show it at once (after a wrong answer)"
  var shown bool = false
  overlay mode=popover emphasis=(if(plain, normal, low)) label=("Show the " + word)
    icon name=book size=small if=(not plain)
    flex gap=s align=center wrap=false if=plain
      icon name=book size=small
      text ("Show " + word)
    fill body
      stack gap=s
        flex gap=s align=center if=(spoil and not shown)
          stack grow basis=s
            text ("Have a real try first: the " + word + " helps most once you have been stuck for a while.") size=small tone=muted
          press
            icon name=eye size=small
            text ("Show the " + word)
            @click set shown=true
        stack gap=s if=(shown or not spoil)
          each p in items
            text p
