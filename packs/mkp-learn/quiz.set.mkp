quiz.set@1 "A set of questions one at a time, with a running score; the first try at each counts, and finishing sends the score."
  in title text = "" "shown above the set"
  in items list(record item {kind: choice(pick|numeric|expression), question: text, answer: text = "", vars: list(text) = ["x"], multiple: bool = false,
      options: list(record option {text: text, right: bool = false, why: text = ""}), solution: text = ""}) "the questions: pick has options, numeric and expression have an answer"
  out finished {correct: int, total: int}
  signal score {correct: int, total: int} "sent when the reader finishes"
  var at int = 0
  var firsts dict(bool) = {}
  var done bool = false
  n = len(items)
  tried = len(keys(firsts))
  right = len(filter(keys(firsts), k => firsts[k]))
  fn key(k: int): text = "" + k
  fn ans(k: int): text = if(items[k].kind == pick, join(map(filter(items[k].options, o => o.right), o => o.text), "; "), if(items[k].kind == expression, "`" + items[k].answer + "`", items[k].answer))
  project md = (if(title == "", "", "**" + title + "**\n\n") + join(map(range(0, n - 1), k => "" + (k + 1) + ". " + items[k].question
      + if(items[k].kind == pick, join(map(items[k].options, o => "\n   - " + o.text), ""), "")), "\n")
      + "\n\n:::details \"Answers\"\n" + join(map(range(0, n - 1), k => "" + (k + 1) + ". " + ans(k) + if(items[k].solution == "", "", " — " + items[k].solution)), "\n") + "\n:::\n")
  stack gap=m
    flex justify=between align=center gap=m
      text title weight=bold if=(title != "")
      text "Question \val{at + 1} of \val{n} · score \val{right} of \val{tried}" tone=muted
    progress tried n show=fraction label="answered"
    each k in 0..(n - 1)
      stack if=(k == at)
        switch on=(items[k].kind)
          case pick
            quiz.choice question=(items[k].question) multiple=(items[k].multiple)
              each o in items[k].options
                option o.text right=(o.right) why=(o.why)
              solution (items[k].solution) if=(items[k].solution != "")
              @correct set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), true)))
              @wrong set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), false)))
          case numeric
            quiz.numeric question=(items[k].question) answer=(parse(items[k].answer, [])())
              solution (items[k].solution) if=(items[k].solution != "")
              @correct set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), true)))
              @wrong set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), false)))
          else
            quiz.expression question=(items[k].question) answer=(items[k].answer) vars=(items[k].vars)
              solution (items[k].solution) if=(items[k].solution != "")
              @correct set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), true)))
              @wrong set firsts=(if(has(firsts, key(k)), firsts, put(firsts, key(k), false)))
    flex gap=s align=center
      stepper at last=(n - 1)
      press id=finish if=(tried == n and not done)
        text "Finish"
        @click set done=true send score correct=right total=n emit finished correct=right total=n
    stack gap=xs pad=m stroke=ok radius=card if=done
      text "You scored \val{right} out of \val{n}." weight=bold tone=ok
      text "Only your first try at each question counts." tone=muted size=small
