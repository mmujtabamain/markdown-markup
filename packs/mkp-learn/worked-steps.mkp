worked-steps@1 "A worked solution revealed one step at a time, each with its reason, ending in the result. Every step keeps its place from the start, blurred until it is reached, so nothing moves as it is stepped."
  in problem text "what is being solved"
  in lines list(record line {text: text, why: text = ""}) "the steps, in order, with the reason for each"
  in result text = "" "the conclusion, shown after the last step"
  in label text = "Worked example" "the frame's caption"
  in title text = "Step by step" "the header's title"
  at = steps (len(lines)) "step"
  last = len(lines) - 1
  status = if(at < last, "**Step " + (at + 1) + " of " + len(lines) + ".** " + (last - at) + if(last - at == 1, " more step.", " more steps."),
      if(result != "", "**Done.** " + result, "**Done.** That is every step."))
  project md = (problem + "\n\n" + join(map(range(0, len(lines) - 1), k => "" + (k + 1) + ". " + lines[k].text + if(lines[k].why == "", "", " *(" + lines[k].why + ")*")), "\n")
      + if(result == "", "", "\n\n**" + result + "**") + "\n")
  frame kind=label title=title status=status
    stack pad=l gap=m
      text problem weight=medium
      stack gap=s
        each k in 0..(len(lines) - 1)
          flex gap=m align=baseline wrap=false pad=m radius=card stroke=(if(k == at, info, muted)) tint=(if(k == at, info, surface)) blur=(k > at)
            text ("" + (k + 1)) font=mono size=small tone=(if(k == at, info, muted))
            stack gap=xs grow
              text lines[k].text
              text lines[k].why tone=muted size=small if=(lines[k].why != "")
      flex gap=s align=baseline pad=m radius=card tint=ok blur=(at < last) if=(result != "")
        icon name=check tone=ok size=small
        text result weight=medium
