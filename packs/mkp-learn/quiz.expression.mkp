quiz.expression@1 "A question answered with an expression, checked for equivalence (so 2(x+1) and 2x+2 both count), with known wrong answers, hints and a solution."
  in question text "the question, with maths"
  in answer text "the right expression, as the reader would type it, e.g. 2x + 2"
  in vars list(text) = ["x"] "the variables the answer may use"
  in shown text = "" "the right answer written with maths (\"$3x^2 + 2$\"), for the solution and Markdown; empty shows the typed form"
  in label text = "Question" "the caption before the title: what the question belongs to (Exercise, Practice)"
  in title text = "Type an expression" "the header's title, what the reader does"
  in help text = "Type `*` or nothing for times, `^` for powers, and `sqrt(…)`, `sin(…)` and so on." "under the question, small: how to type the answer"
  in caption text = "" "over the field, in capitals: what to type (the derivative)"
  in wrongs list(record wrong {value: text, why: text}) "known wrong answers and why"
  in hints list(record hint {text: text})
  in solutions list(record solution {text: text})
  in next slot "the caller's own buttons, after the question's in its bar (a set's Next)"
  out correct
  out wrong
  signal answered {correct: bool, value: text} "sent on every check"
  var entry text = ""
  var result choice(none|pass|fail|unread) = none
  var calm color = none
  # it can be read when it is equivalent to itself (a typing slip, or a name outside vars, is not)
  readable = entry != "" and equivalent(entry, entry, vars)
  right = readable and equivalent(entry, answer, vars)
  known = find(wrongs, w => readable and equivalent(entry, w.value, vars), {value: "", why: ""})
  formal = if(shown == "", "`" + answer + "`", shown)
  names = if(len(vars) == 0, "a number", "an expression in " + join(vars, ", "))
  say = if(result == pass, "**Correct.** It is equal to " + formal + ".", if(result == fail, "**Not quite.** " + if(known.why != "", known.why, "That isn't equal to the answer for every value."),
      if(result == unread, "That can't be read as " + names + " yet.", "Type " + names + ", then press Check.")))
  mood = if(result == none, calm, if(result == pass, ok, if(result == fail, bad, info)))
  sol = ["The answer is " + formal + "."] + map(solutions, s => s.text)
  project md = (question + "\n\n:::details \"Answer\"\n" + formal
      + join(map(solutions, s => "\n\n" + s.text), "") + "\n:::\n")
  frame kind=label title=title tone=mood
    fill actions
      quiz.hints hints=(map(hints, h => h.text)) if=(len(hints) > 0)
      quiz.answer items=sol
    stack pad=l gap=m
      stack gap=xs
        text question weight=medium
        text help size=small tone=muted if=(help != "")
      stack gap=xs
        text caption font=mono size=small tone=muted caps=true if=(caption != "")
        field entry label=(if(caption != "", caption, "your answer")) placeholder=names width=m
          @change set result=none
        # its own line, always there, so a typing slip is pointed out without moving anything
        flex gap=xs align=center wrap=false
          icon name=alert tone=warn size=small if=(entry != "" and not readable)
          text (if(entry == "" or readable, "", "Not " + names + " yet: check the brackets and the names.")) size=small tone=warn lines=1
    fill bar
      # the line says what to do or how it went; on a narrow screen the buttons wrap under it
      flex gap=s align=center justify=between grow
        flex gap=s align=baseline wrap=false grow basis=s
          icon name=check tone=ok size=small if=(result == pass)
          icon name=cross tone=bad size=small if=(result == fail)
          text say tone=(if(result == none, muted, ink))
        flex gap=s align=center
          quiz.answer items=sol plain=true spoil=false if=(result == fail)
          press id=check_ok emphasis=high if=(right)
            icon name=check size=small
            text "Check"
            @click set result=pass send answered correct=true value=entry emit correct
          press id=check emphasis=high disabled=(entry == "") if=(not right and (readable or entry == ""))
            icon name=check size=small
            text "Check"
            @click set result=fail send answered correct=false value=entry emit wrong
          press id=check_unread emphasis=high if=(entry != "" and not readable)
            icon name=check size=small
            text "Check"
            @click set result=unread
          slot next
