quiz.expression@1 "A question answered with an expression, checked for equivalence (so 2(x+1) and 2x+2 both count), with known wrong answers, hints and a solution."
  in question text "the question, with maths"
  in answer text "the right expression, as the reader would type it, e.g. 2x + 2"
  in vars list(text) = ["x"] "the variables the answer may use"
  in shown text = "" "the right answer written with maths (\"$3x^2 + 2$\"), for the solution and Markdown; empty shows the typed form"
  in wrongs list(record wrong {value: text, why: text}) "known wrong answers and why"
  in hints list(record hint {text: text})
  in solutions list(record solution {text: text})
  out correct
  out wrong
  signal answered {correct: bool, value: text} "sent on every check"
  var entry text = ""
  var result choice(none|pass|fail) = none
  var hinted int = 0
  var solved bool = false
  right = entry != "" and equivalent(entry, answer, vars)
  known = find(wrongs, w => entry != "" and equivalent(entry, w.value, vars), {value: "", why: ""})
  formal = if(shown == "", "`" + answer + "`", shown)
  project md = (question + "\n\n:::details \"Answer\"\n" + formal
      + join(map(solutions, s => "\n\n" + s.text), "") + "\n:::\n")
  stack gap=m pad=m stroke=muted radius=card
    text question
    flex gap=s align=center
      field entry label="your answer" placeholder=(if(len(vars) == 0, "an expression", "an expression in " + join(vars, ", ")))
        @change set result=none
      press id=check_ok if=(right) disabled=(entry == "")
        text "Check"
        @click set result=pass send answered correct=true value=entry emit correct
      press id=check if=(not right) disabled=(entry == "")
        text "Check"
        @click set result=fail send answered correct=false value=entry emit wrong
    text "Type `*` or nothing for times, `^` for powers, and `sqrt(…)`, `sin(…)` and so on." tone=muted size=small
    text "Right." tone=ok if=(result == pass)
    text "Not quite: that isn't equal to the answer for every value." tone=bad if=(result == fail and known.why == "")
    text known.why tone=bad if=(result == fail and known.why != "")
    each k in 0..(hinted - 1)
      text hints[k].text tone=muted
    flex gap=s
      press if=(hinted < len(hints))
        text "Hint"
        @click set hinted=(hinted + 1)
      press if=(not solved)
        text "Show the solution"
        @click set solved=true
    stack gap=s if=(solved)
      text ("The answer is " + formal + ".")
      each s in solutions
        text s.text
