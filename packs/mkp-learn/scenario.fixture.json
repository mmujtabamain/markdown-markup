{
 "widget": "scenario@1",
 "cases": {
  "outage": {
   "summary": "An on-call scenario: a failing service, three choices, a good and a bad ending.",
   "props": {
    "title": "The pager goes off",
    "scenes": [
     {
      "id": "start",
      "text": "Error rates on the checkout service jumped five minutes after a deploy."
     },
     {
      "id": "logs",
      "text": "The logs show a new config key missing in production."
     },
     {
      "id": "rollback",
      "text": "Errors drop back to normal within a minute. You write up what happened.",
      "ending": "good"
     },
     {
      "id": "restart",
      "text": "The errors come straight back: the cause is still deployed.",
      "ending": "bad"
     },
     {
      "id": "hand",
      "text": "The fix is undocumented and the next deploy breaks again.",
      "ending": "neutral"
     }
    ],
    "links": [
     {
      "from": "start",
      "label": "Roll the deploy back",
      "to": "rollback",
      "note": "You start the rollback."
     },
     {
      "from": "start",
      "label": "Restart the servers",
      "to": "restart",
      "note": "The servers restart."
     },
     {
      "from": "start",
      "label": "Read the logs first",
      "to": "logs"
     },
     {
      "from": "logs",
      "label": "Roll back",
      "to": "rollback"
     },
     {
      "from": "logs",
      "label": "Add the key by hand",
      "to": "hand",
      "note": "It works, until the next deploy."
     }
    ]
   },
   "play": [
    {
     "set": {
      "at": "logs",
      "trail": [
       "start"
      ]
     }
    },
    {
     "wait": 100
    }
   ]
  },
  "start": {
   "summary": "A two-scene scenario at its start.",
   "props": {
    "scenes": [
     {
      "id": "a",
      "text": "Is $\\sqrt{2}$ rational?"
     },
     {
      "id": "yes",
      "text": "Right: it is irrational.",
      "ending": "good"
     },
     {
      "id": "no",
      "text": "Suppose $\\sqrt 2 = p/q$ in lowest terms… that leads to a contradiction.",
      "ending": "bad"
     }
    ],
    "links": [
     {
      "from": "a",
      "label": "Yes",
      "to": "no"
     },
     {
      "from": "a",
      "label": "No",
      "to": "yes"
     }
    ]
   }
  },
  "bad-ending": {
   "props": {
    "scenes": [
     {
      "id": "a",
      "text": "x",
      "ending": "great"
     }
    ]
   },
   "expect": {
    "errors": [
     "mkp.enum"
    ]
   }
  }
 }
}