theorem@1 "A theorem card: its kind and name in the header, the statement, and the proof under it, blurred until the reader asks for it (or open from the start), so showing it moves nothing."
  fields kind name
  in kind choice(theorem|lemma|proposition|corollary|definition|claim) = theorem
  in name text = "" "e.g. Pythagoras"
  in statement text "the statement, with maths"
  in proof text = "" "the proof; empty for none"
  in open bool = false "start with the proof shown"
  var flipped bool = false
  shown = if(flipped, not open, open)
  word = if(kind == theorem, "Theorem", if(kind == lemma, "Lemma", if(kind == proposition, "Proposition", if(kind == corollary, "Corollary", if(kind == definition, "Definition", "Claim")))))
  title = word + if(name == "", "", " (" + name + ")")
  project md = ("**" + title + ".** " + statement + if(proof == "", "", "\n\n:::details \"Proof\"\n" + proof + " ∎\n:::") + "\n")
  frame kind=word title=name status=(if(proof == "", "", if(shown, "", "Try to prove it before you look.")))
    stack pad=l gap=m
      text statement
      stack gap=xs pad=m radius=card tint=muted blur=(not shown) if=(proof != "")
        text "Proof" font=mono size=small tone=muted caps=true
        text proof
        text "∎" tone=muted align=end
    fill bar
      stack grow if=(proof != "" and shown)
      press id=proof emphasis=(if(shown, low, normal)) if=(proof != "")
        icon name=eye size=small
        text (if(shown, "Hide the proof", "Show the proof"))
        @click set flipped=(not flipped)
