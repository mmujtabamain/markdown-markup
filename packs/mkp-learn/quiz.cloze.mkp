part quiz.gap@1 "One blank in a cloze: a short field that reports what is typed, and a tick or cross once checked."
  in checked bool = false "whether the cloze has been checked"
  in ok bool = false "whether this blank is right"
  in label text = "blank"
  in width size = s "the field's width: s in running text, m for an answer on its own"
  out typed {value: text}
  var entry text = ""
  flex gap=xs align=center wrap=false
    field entry label=label placeholder=label width=width
      @change emit typed value=change.value
    # always there, so checking moves nothing in the running text
    stack
      icon name=check tone=ok size=small label="right" if=(checked and ok)
      icon name=cross tone=bad size=small label="wrong" if=(checked and not ok)
      icon name=dot tone=muted size=small if=(not checked)

quiz.cloze@1 "Fill in the blanks: text pieces and fields flowing as one paragraph, checked as exact text (with other spellings that count), numbers or expressions. One blank and no text is a short answer: a word, a name."
  in prompt text = "" "the question or instruction above the text"
  in pieces list(record piece {text: text, answer: text = "", also: list(text) = []}) "each piece is some text, followed by a blank when it has an answer; also lists other spellings that count"
  in match choice(exact|number|expression) = exact "how a blank is checked"
  in vars list(text) = ["x"] "the variables, when match is expression"
  in tolerance num = 0.000001 "how close counts, when match is number"
  in label text = "Question" "the caption before the title: what the question belongs to (Quiz, Practice)"
  in title text = "" "the header's title, what the reader does; empty: Fill in the blanks, or Type it for a single blank"
  in help text = "" "under the prompt, small: how to answer"
  in praise text = "" "what the verdict says when every blank is right; empty: the answers"
  in wrongs list(record wrong {value: text, why: text}) "known wrong entries (in any blank) and why"
  in hints list(record hint {text: text})
  in solutions list(record solution {text: text})
  in next slot "the caller's own buttons, after the question's in its bar (a set's Next)"
  out correct
  out wrong
  signal answered {correct: bool, values: list(text)} "sent on every check, with every blank's entry"
  var entries dict(text) = {}
  var result choice(none|pass|fail) = none
  var calm color = none
  n = len(pieces)
  gaps = filter(range(0, n - 1), k => pieces[k].answer != "")
  # a single blank with no text around it is a short answer, given a wide field
  lone = len(gaps) == 1 and len(filter(pieces, p => p.text != "")) == 0
  fn entry(k: int): text = get(entries, "" + k, "")
  fn same(a: text, b: text): bool = if(match == number, abs(parse(a, [])() - parse(b, [])()) <= tolerance, if(match == expression, equivalent(a, b, vars), a == b))
  fn ok(k: int): bool = entry(k) != "" and (same(entry(k), pieces[k].answer) or len(filter(pieces[k].also, a => same(entry(k), a))) > 0)
  good = len(filter(gaps, k => ok(k)))
  right = good == len(gaps)
  values = map(gaps, k => entry(k))
  known = find(wrongs, w => len(filter(gaps, k => entry(k) != "" and same(entry(k), w.value))) > 0, {value: "", why: ""})
  heading = if(title != "", title, if(lone, "Type it", "Fill in the blanks"))
  filled = join(map(pieces, p => p.text + if(p.answer == "", "", " **" + p.answer + "**")), " ")
  say = if(result == none, if(lone, "Type your answer, then press Check.", "Fill in every blank, then press Check."),
      if(result == pass, "**Correct.** " + if(praise != "", praise, if(lone, at(pieces, 0, {text: "", answer: "", also: []}).answer + ".", "Every blank is right.")),
      "**Not quite.** " + if(known.why != "", known.why, if(lone, "Check the spelling, or try a hint.", "" + good + " of " + len(gaps) + " right; the crosses mark the rest."))))
  mood = if(result == none, calm, if(result == pass, ok, bad))
  sol = [filled] + map(solutions, s => s.text)
  project md = (if(prompt == "", "", prompt + "\n\n") + join(map(pieces, p => p.text + if(p.answer == "", "", " \\_\\_\\_\\_\\_")), " ")
      + "\n\n:::details \"Answer\"\n" + filled
      + join(map(solutions, s => "\n\n" + s.text), "") + "\n:::\n")
  frame kind=label title=heading tone=mood
    fill actions
      quiz.hints hints=(map(hints, h => h.text)) if=(len(hints) > 0)
      quiz.answer items=sol word=(if(len(gaps) == 1, "answer", "answers"))
    stack pad=l gap=m
      stack gap=xs if=(prompt != "" or help != "")
        text prompt weight=medium if=(prompt != "")
        text help size=small tone=muted if=(help != "")
      flex wrap align=center gap=s
        each k in 0..(n - 1)
          text pieces[k].text if=(pieces[k].text != "")
          quiz.gap ok=(ok(k)) checked=(result != none) label=(if(lone, "your answer", "blank " + (indexof(gaps, k) + 1))) width=(if(lone, m, s)) if=(pieces[k].answer != "")
            @typed set entries=(put(entries, "" + k, typed.value)) result=none
    fill bar
      # the line says what to do or how it went; on a narrow screen the buttons wrap under it
      flex gap=s align=center justify=between grow
        flex gap=s align=baseline wrap=false grow basis=s
          icon name=check tone=ok size=small if=(result == pass)
          icon name=cross tone=bad size=small if=(result == fail)
          text say tone=(if(result == none, muted, ink))
        flex gap=s align=center
          quiz.answer items=sol word=(if(len(gaps) == 1, "answer", "answers")) plain=true spoil=false if=(result == fail)
          press id=check_ok emphasis=high if=(right)
            icon name=check size=small
            text "Check"
            @click set result=pass send answered correct=true values=values emit correct
          press id=check emphasis=high disabled=(len(filter(gaps, k => entry(k) != "")) == 0) if=(not right)
            icon name=check size=small
            text "Check"
            @click set result=fail send answered correct=false values=values emit wrong
          slot next
