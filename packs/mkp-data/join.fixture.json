{ "widget": "join@1", "cases": {
  "staff-depts": { "summary": "Staff joined to departments on the department code; one person's department is missing.",
    "props": {
      "left": { "name": "staff", "cols": ["name", "dept"], "rows": [["Ada", "E"], ["Brook", "S"], ["Cy", "E"], ["Dee", "X"]] },
      "right": { "name": "depts", "cols": ["code", "title"], "rows": [["E", "Engineering"], ["S", "Sales"], ["O", "Ops"]] },
      "on": "dept", "righton": "code" },
    "play": [{ "set": { "pos": 1 } }, { "wait": 300 }, { "set": { "pos": 3 } }] },
  "left-outer": { "summary": "A left outer join: the unmatched row is kept with NULLs, and one row matches twice.",
    "props": {
      "left": { "name": "orders", "cols": ["id", "item"], "rows": [["1", "pen"], ["2", "ink"], ["3", "pad"]] },
      "right": { "name": "stock", "cols": ["item", "shop"], "rows": [["pen", "north"], ["pen", "south"], ["pad", "north"]] },
      "on": "item", "kind": "leftouter" },
    "play": [{ "set": { "pos": 2 } }] },
  "no-key": { "summary": "The key column is required.",
    "props": { "left": { "cols": ["a"], "rows": [["1"]] }, "right": { "cols": ["a"], "rows": [["1"]] } },
    "expect": { "errors": ["mkp.missing-input"] } } } }
