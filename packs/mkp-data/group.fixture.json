{ "widget": "group@1", "cases": {
  "sales": { "summary": "Sales grouped by region with a count, a total and the largest sale.",
    "props": { "table": { "name": "sales", "cols": ["region", "rep", "amount"],
        "rows": [["north", "Ada", "120"], ["south", "Brook", "80"], ["north", "Cy", "95"], ["east", "Dee", "40"], ["south", "Eli", "60"]] },
      "by": "region",
      "aggs": [{ "func": "count", "as": "n" }, { "func": "sum", "col": "amount", "as": "total" }, { "func": "max", "col": "amount" }] },
    "play": [{ "set": { "view": 1 } }, { "wait": 400 }, { "set": { "view": 2 } }] },
  "no-aggs": { "summary": "Grouping alone: the rows gathered under each key, then the distinct keys.",
    "props": { "table": { "cols": ["colour", "shape"], "rows": [["red", "circle"], ["blue", "square"], ["red", "square"]] }, "by": "colour", "aggs": [] },
    "play": [{ "set": { "view": 1 } }] },
  "bad-func": { "summary": "An unknown aggregate is refused.",
    "props": { "table": { "cols": ["a"], "rows": [["1"]] }, "by": "a", "aggs": [{ "func": "median", "col": "a" }] },
    "expect": { "errors": ["mkp.enum"] } } } }
