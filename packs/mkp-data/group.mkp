group@1 "Rows grouped by a key with aggregates: step from the rows, to the rows gathered into groups, to one row per group."
  in table rel "the relation to group"
  in by text "the column to group by"
  in aggs list(record agg {func: choice(count|sum|avg|min|max), col: text = "", as: text = ""}) "aggregates per group"

  cols = table.cols
  base = map(range(0, len(table.rows) - 1), i => {id: "r" + i, cells: table.rows[i]})
  fn gkey(r) = cell(cols, r.cells, by)
  gkeys = fold(base, [], (ks, r) => if(indexof(ks, gkey(r)) >= 0, ks, ks + [gkey(r)]))
  fn members(k) = filter(base, r => gkey(r) == k)
  fn summary(k) = join(map(aggs, a => agglabel(a) + " " + shownum(aggval(cols, a, map(members(k), r => r.cells)))), ", ")
  outcols = [by] + map(aggs, a => agglabel(a))
  fn outcells(k) = [k] + map(aggs, a => shownum(aggval(cols, a, map(members(k), r => r.cells))))

  view = steps 3 "stage"
  rows = if(view == 0, map(base, r => rrowof(r.id, r.cells, false)),
      if(view == 1, flatten(map(gkeys, k => [rrowhead("h:" + k, by + " = " + k + if(len(aggs) == 0, "", " · " + summary(k)))] +
          map(members(k), r => rrowof(r.id, r.cells, false)))),
        map(gkeys, k => rrowof("h:" + k, outcells(k), true))))
  shown = if(view == 2, outcols, cols)
  notes = ["" + len(base) + " rows, in the order given.", "The rows gathered into " + len(gkeys) + " groups by " + by + ".",
      "One row per group: " + by + " and its aggregates."]

  project md = ("**Grouped by " + by + "**\n\n" + mdtable(cols, mdrows(len(cols), flatten(map(gkeys, k =>
      [rrowhead("h:" + k, by + " = " + k)] + map(members(k), r => rrowof(r.id, r.cells, false)))), false)) +
      "\n**One row per group**\n\n" + mdtable(outcols, map(gkeys, k => outcells(k))))

  stack gap=m
    text notes[view]
    reltable shown rows
