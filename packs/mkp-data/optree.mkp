# an operator of a relational-algebra tree: its symbol (maths welcome), what it yields, and its inputs
type optnode = {id: text, op: text, note: text = "", kids: list(optnode)}

# the operators in evaluation order: every input before the operator that reads it. A stack walk
# (node, then its last input first) reversed; a recursive fn would read better but crashes the checker.
fn popnode(s: {st: list(optnode), out: list(optnode)}): {st: list(optnode), out: list(optnode)} = if(len(s.st) == 0, s,
    {st: first(s.st, len(s.st) - 1) + s.st[len(s.st) - 1].kids, out: s.out + [s.st[len(s.st) - 1]]})
fn postorder(n: optnode): list(optnode) = reverse(iterate({st: [n], out: []}, 400, s => popnode(s)).out)

part opnode@1 "One operator above its inputs; the current operator is outlined, and evaluated ones are bold."
  fields node
  in node optnode "the operator and its inputs"
  in at text = "" "the id of the operator being evaluated"
  in done list(text) = [] "the ids already evaluated"
  stack align=center gap=l
    stack id=(node.id)
      stack pad=s stroke=accent radius=card if=(node.id == at)
        text node.op weight=bold
      stack pad=s stroke=muted radius=card if=(node.id != at)
        text node.op weight=(if(indexof(done, node.id) >= 0, bold, regular)) tone=muted
    flex gap=l justify=center
      each k in node.kids key=k.id
        opnode node=k at=at done=done
  each k in node.kids key=k.id
    arrow from=(k.id) to=(node.id)

optree@1 "A relational-algebra operator tree, evaluated bottom-up one operator at a time."
  fields root
  in root optnode "the root operator"
  order = postorder(root)
  pos = steps (len(order)) "operator"
  cur = order[pos]
  done = map(first(order, pos), n => n.id)
  project mermaid = ("flowchart BT\n" + join(map(order, n => "  " + n.id + "[\"" + n.op + "\"]"), "\n") + "\n" +
      join(flatten(map(order, n => map(n.kids, k => "  " + k.id + " --> " + n.id))), "\n"))
  project md = join(map(range(0, len(order) - 1), k => "" + (k + 1) + ". " + order[k].op + if(order[k].note == "", "", ": " + order[k].note)), "\n") + "\n"
  stack gap=l
    opnode root at=cur.id done=done
    stack gap=xs pad=m stroke=muted radius=card
      text ("Step " + (pos + 1) + " of " + len(order) + ": " + cur.op) weight=bold
      text cur.note if=(cur.note != "")
