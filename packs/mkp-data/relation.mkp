# Relations shared by the pack: a relation is named columns and rows of text cells.
type rel = {name: text = "", cols: list(text), rows: list(list(text))}
# one drawn row: an id so it keeps its identity between steps, its cells, and how it is marked
type rrow = {id: text, cells: list(text), mark: choice(plain|on|off|head) = plain}

# a cell of a row by column name, or "" when the relation has no such column
fn cell(cols: list(text), cells: list(text), name: text): text = at(cells, indexof(cols, name), "")
# a text cell read as a number (nan when it is not one)
fn number(t: text): num = parse(t, [])()
# a number shown whole when it is whole, else with two decimals
fn shownum(x: num): text = if(x == round(x), format(x, 0), format(x, 2))
# compares two cells: as numbers when both are numbers, else as text
fn compare(a: text, op: text, b: text): bool = if(number(a) == number(a) and number(b) == number(b),
    if(op == "eq", number(a) == number(b), if(op == "ne", number(a) != number(b), if(op == "lt", number(a) < number(b),
      if(op == "le", number(a) <= number(b), if(op == "gt", number(a) > number(b), number(a) >= number(b)))))),
    if(op == "eq", a == b, if(op == "ne", a != b, if(op == "lt", a < b, if(op == "le", a <= b, if(op == "gt", a > b, a >= b))))))
# an aggregate {func, col, as} over rows of cells: count, sum, avg, min or max of a column
fn aggvalues(cols, a, rs) = map(rs, r => number(cell(cols, r, a.col)))
fn aggval(cols, a, rs) = if(a.func == "count", len(rs), if(a.func == "sum", sum(aggvalues(cols, a, rs)),
    if(a.func == "avg", mean(aggvalues(cols, a, rs)), if(a.func == "min", min(aggvalues(cols, a, rs)), max(aggvalues(cols, a, rs))))))
# an aggregate's column name in the result, and how SQL writes it
fn agglabel(a) = if(a.as != "", a.as, a.func + "(" + if(a.col == "", "*", a.col) + ")")
fn aggsql(a) = a.func + "(" + if(a.col == "", "*", a.col) + ")" + if(a.as != "", " AS " + a.as, "")
# a GFM table
fn mdtable(cols: list(text), rows: list(list(text))): text = ("| " + join(cols, " | ") + " |\n|" +
    join(map(cols, c => " --- "), "|") + "|\n" + join(map(rows, r => "| " + join(r, " | ") + " |"), "\n") + "\n")
# drawn rows as Markdown table rows: dropped rows left out, headings bold across, marked rows bold when asked
fn mdrows(n: int, rows: list(rrow), bold: bool): list(list(text)) = map(filter(rows, r => r.mark != off),
    r => if(r.mark == head, ["**" + r.cells[0] + "**"] + map(range(2, n), x => ""),
      if(bold and r.mark == on, map(r.cells, c => "**" + c + "**"), r.cells)))
# a drawn row, plain or marked
fn rrowof(id: text, cells: list(text), hl: bool): rrow = {id: id, cells: cells, mark: if(hl, on, plain)}
# a drawn row that is dropped (shown muted)
fn rrowoff(id: text, cells: list(text)): rrow = {id: id, cells: cells, mark: off}
# a heading row across the table
fn rrowhead(id: text, label: text): rrow = {id: id, cells: [label], mark: head}
# a comparison's symbol
fn opsym(op: text): text = if(op == "eq", "=", if(op == "ne", "<>", if(op == "lt", "<", if(op == "le", "<=", if(op == "gt", ">", ">=")))))
# a value as SQL writes it: numbers bare, text quoted
fn sqlval(v: text): text = if(number(v) == number(v), v, "'" + v + "'")

part reltable@1 "A relation drawn as a table: a header band, keyed rows that keep their identity between steps, rows marked on washed (and the current one barred), rows marked off struck through, heading rows across, and number columns right-aligned."
  fields cols rows
  in cols list(text) "the column names (inline Markdown, so maths works)"
  in rows list(rrow) "the rows, each with an id"
  in title text = "" "a caption above the table"
  in bar bool = false "a bar on the left of the rows marked on: they are the current one"
  in pressable bool = false "a row is pressed to pick it"
  in maths bool = false "the column names are TeX"
  out picked {row: int}
  n = max(1, min(12, len(cols)))
  # a column of numbers only is right-aligned and monospaced
  fn numeric(c: int): bool = (len(filter(rows, r => r.mark != head)) > 0 and
      fold(rows, true, (ok, r) => ok and (r.mark == head or number(at(r.cells, c, "")) == number(at(r.cells, c, "")))))
  fn side(c: int): choice(start|center|end) = if(numeric(c), end, start)
  # each column's share of the width, by how much it has to say (monospaced numbers are wider); maths
  # headings are counted short, as they typeset narrower than their TeX
  fn longest(c: int): num = fold(rows, 0, (a, r) => max(a, if(r.mark == head, 0, len(at(r.cells, c, "")))))
  fn chars(c: int): num = max(if(maths, 2, len(at(cols, c, "")) * 1.1), longest(c) * if(numeric(c), 1.3, 1)) + 3
  fit = len(cols) <= 12
  spans = if(fit, gridshares(map(range(0, n - 1), c => chars(c))), map(range(0, n - 1), c => 1))
  across = max(1, min(12, fold(spans, 0, (a, w) => a + w)))
  heads = map(range(0, n - 1), c => {label: at(cols, c, ""), align: side(c), badge: "", lit: false, span: spans[c], rule: false})
  fn drawn(k: int) = {id: rows[k].id, key: false, glyph: "", gtone: "", gspan: 0, wash: if(rows[k].mark == on, "info", ""), struck: rows[k].mark == off,
      current: bar and rows[k].mark == on, bar: bar, dim: false, note: "", nspan: 0, across: across,
      cells: map(range(0, n - 1), c => {v: at(rows[k].cells, c, ""), wash: if(rows[k].mark == on, "info", ""), tone: "ink", glyph: "", gtone: "",
        outline: false, mono: numeric(c), align: side(c), span: spans[c], rule: false})}
  stack
    flex pad=s if=(title != "")
      text title font=mono size=small tone=muted caps=true
    gridhead heads across=across bar=bar maths=maths
    divider
    # keyed by id and place: a part's inputs keep the each binding they were first drawn with, so a
    # row that moves (sorted) gets a new instance rather than an old place's cells
    each k in range(0, len(rows) - 1) key=(rows[k].id + "@" + k)
      stack id=(rows[k].id)
        flex pad=s gap=s tint=muted align=center if=(rows[k].mark == head)
          text ""
          text (at(rows[k].cells, 0, "")) size=small weight=bold
        press kind=plain label=("pick " + rows[k].id) selected=(rows[k].mark == on) if=(pressable and rows[k].mark != head)
          gridrow (drawn(k))
          @click emit picked row=k
        gridrow (drawn(k)) if=(not pressable and rows[k].mark != head)
      divider
    flex pad=m if=(len(rows) == 0)
      text "No rows." tone=muted

relation@1 "A relation: its columns and rows as a table, with some rows highlighted."
  fields head rows
  in head list(text) "the column names"
  in rows list(list(text)) "the rows, one list of cells each"
  in name text = "" "the relation's name, over its rows"
  in marked list(int) = [] "rows to highlight, counted from 0"
  in title text = "" "the header's title; empty: the relation's name"
  drawn = map(range(0, len(rows) - 1), i => rrowof("r" + i, rows[i], indexof(marked, i) >= 0))
  project md = if(name == "", "", "**" + name + "**\n\n") + mdtable(head,
      map(range(0, len(rows) - 1), i => if(indexof(marked, i) >= 0, map(rows[i], c => "**" + c + "**"), rows[i])))
  frame kind="Relation" title=(if(title != "", title, if(name == "", "A relation", name)))
    pane title=(if(name == "", "rows", "relation **" + name + "**")) note=("" + len(rows) + " rows" + if(len(marked) == 0, "", " · " + len(marked) + " marked"))
      reltable head drawn
