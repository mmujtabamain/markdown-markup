join@1 "Two relations and their join on a key: step through the left rows and see each one's matches join the result."
  in left rel "the left relation"
  in right rel "the right relation"
  in on text "the key column of the left relation"
  in righton text = "" "the key column of the right relation, when its name differs"
  in kind choice(inner|leftouter) = inner "inner keeps matched rows only; leftouter keeps every left row"
  in title text = "" "the header's title; by default the query"

  rkey = if(righton == "", on, righton)
  lname = if(left.name == "", "l", left.name)
  rname = if(right.name == "", "r", right.name)
  fn lkey(i) = cell(left.cols, left.rows[i], on)
  fn matches(i) = filter(range(0, len(right.rows) - 1), j => cell(right.cols, right.rows[j], rkey) == lkey(i))
  # the right columns the result keeps (not the key again), named apart from the left's
  rkeep = filter(range(0, len(right.cols) - 1), c => right.cols[c] != rkey)
  outcols = left.cols + map(rkeep, c => if(indexof(left.cols, right.cols[c]) >= 0, rname + "." + right.cols[c], right.cols[c]))
  fn rpart(j) = map(rkeep, c => if(j < 0, "NULL", at(right.rows[j], c, "")))
  # every joined pair in order of the left rows; an unmatched left row pairs with -1 in a left outer join
  pairs = flatten(map(range(0, len(left.rows) - 1), i =>
      if(len(matches(i)) == 0 and kind == leftouter, [{i: i, j: -1}], map(matches(i), j => {i: i, j: j}))))

  pos = steps (len(left.rows)) play=1200ms "left row"
  hits = matches(pos)
  sql = "SELECT * FROM " + lname + if(kind == leftouter, " LEFT JOIN ", " JOIN ") + rname + " ON " + lname + "." + on + " = " + rname + "." + rkey
  # the lines so far: the current row's strong, the ones before it faded
  fn linetone(): choice(ok|warn|bad|info|accent|muted) = info
  fn linelook(): choice(solid|dashed|dotted) = solid
  lines = map(filter(pairs, p => p.j >= 0 and p.i <= pos), p => {from: p.i, to: p.j, tone: linetone(), line: linelook(), label: "", bold: p.i == pos, dim: p.i < pos})
  lit = ["L" + pos] + map(hits, j => "R" + j)
  done = len(filter(pairs, p => p.i <= pos))
  # a right row picked goes to the first left row it matches
  fn firstfor(j: int): int = at(filter(range(0, len(left.rows) - 1), i => lkey(i) == cell(right.cols, right.rows[j], rkey)), 0, pos)
  fn row(p) = left.rows[p.i] + rpart(p.j)

  project md = ("`" + sql + "`\n\n**" + lname + "**\n\n" + mdtable(left.cols, left.rows) + "\n**" + rname + "**\n\n" +
      mdtable(right.cols, right.rows) + "\n**result** (" + len(pairs) + " rows)\n\n" +
      mdtable(outcols, map(pairs, p => row(p))))

  frame kind="Join" title=(if(title == "", "`" + sql + "`", title)) status=("**" + on + " = " + lkey(pos) + "** " + if(len(hits) == 0,
      "matches no row of " + rname + if(kind == leftouter, ", so the row is kept with NULLs.", ", so it adds nothing."),
      "matches " + len(hits) + " row" + if(len(hits) == 1, "", "s") + " of " + rname + "."))
    stack
      # as wide as the frame, or as the tables when they need more: then the stage scrolls
      flex wrap=false
        rowpanes left right lines lit=lit ids=false leftnote=("key " + on) rightnote=("key " + rkey) grow
          @picked set pos=(if(picked.side == "L", picked.row, firstfor(picked.row)))
      divider
      # a pane in a row of its own: panes share a row's width
      flex align=stretch wrap=false
        pane title="result" note=(done + " of " + len(pairs) + " rows") grow
          stack
            grid cols=(max(1, min(12, len(outcols)))) gap=s pad=m tint=muted
              each c in 0..(len(outcols) - 1)
                text (outcols[c]) size=small tone=muted caps=true wrap=false
            # every row of the result is there from the start, blurred until its left row is reached
            each k in 0..(len(pairs) - 1)
              divider
              grid cols=(max(1, min(12, len(outcols)))) gap=s pad=m align=center tint=(if(pairs[k].i == pos, info, surface)) blur=(pairs[k].i > pos)
                each c in 0..(len(outcols) - 1)
                  text (at(row(pairs[k]), c, "")) literal=true align=start tone=(if(pairs[k].j < 0 and c >= len(left.cols), muted, ink))
            text "No rows." tone=muted if=(len(pairs) == 0)
