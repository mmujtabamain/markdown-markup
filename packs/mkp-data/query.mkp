# one stage of a query: its clause, what it did, and the rows it leaves
type qstage = {sql: text, note: text, cols: list(text), rows: list(rrow)}

query@1 "Step through a query's stages (from, where, group, select, order) with each stage's rows computed."
  in table rel "the relation the query reads"
  in where list(record cond {col: text, op: choice(eq|ne|lt|le|gt|ge) = eq, value: text}) "conditions, all of which must hold"
  in groupby text = "" "the column to group by"
  in aggs list(record agg {func: choice(count|sum|avg|min|max), col: text = "", as: text = ""}) "aggregates per group"
  in select list(text) = [] "the columns kept when not grouping; empty keeps all"
  in orderby text = "" "the column the result is sorted by"
  in desc bool = false "sort largest first"
  in title text = "A query, stage by stage" "the header's title"

  cols = table.cols
  # from: every row, with an id it keeps through the stages
  base = map(range(0, len(table.rows) - 1), i => {id: "r" + i, cells: table.rows[i]})
  # where: the rows every condition holds for
  fn holds(r) = fold(where, true, (ok, c) => ok and compare(cell(cols, r.cells, c.col), c.op, c.value))
  kept = filter(base, r => holds(r))
  # group: the distinct keys in order of first appearance, and each group's rows
  grouping = groupby != "" or len(aggs) > 0
  fn gkey(r) = if(groupby == "", "all", cell(cols, r.cells, groupby))
  gkeys = fold(kept, [], (ks, r) => if(indexof(ks, gkey(r)) >= 0, ks, ks + [gkey(r)]))
  fn members(k) = filter(kept, r => gkey(r) == k)
  # select: the output columns and rows
  outcols = if(grouping, if(groupby == "", [], [groupby]) + map(aggs, a => agglabel(a)), if(len(select) == 0, cols, select))
  outrows = if(grouping,
      map(gkeys, k => rrowof("g:" + k, if(groupby == "", [], [k]) + map(aggs, a => shownum(aggval(cols, a, map(members(k), r => r.cells)))), false)),
      map(kept, r => rrowof(r.id, map(outcols, c => cell(cols, r.cells, c)), false)))
  # order: numerically when every value is a number, else as text
  fn okey(r) = cell(outcols, r.cells, orderby)
  numeric = fold(outrows, true, (ok, r) => ok and number(okey(r)) == number(okey(r)))
  asc = if(numeric, sort(outrows, r => number(okey(r))), sort(outrows, r => okey(r)))
  ordered = if(desc, reverse(asc), asc)

  stages = ([{sql: "FROM " + if(table.name == "", "t", table.name), note: "" + len(base) + " rows", cols: cols,
        rows: map(base, r => rrowof(r.id, r.cells, false))}] +
      if(len(where) == 0, [], [{sql: "WHERE " + join(map(where, c => c.col + " " + opsym(c.op) + " " + sqlval(c.value)), " AND "),
        note: "keeps " + len(kept) + " of " + len(base) + " rows", cols: cols,
        rows: map(base, r => if(holds(r), rrowof(r.id, r.cells, true), rrowoff(r.id, r.cells)))}]) +
      if(not grouping, [], [{sql: if(groupby == "", "GROUP (all rows as one group)", "GROUP BY " + groupby),
        note: "" + len(gkeys) + " group" + if(len(gkeys) == 1, "", "s"), cols: cols,
        rows: flatten(map(gkeys, k => [rrowhead("h:" + k, if(groupby == "", "all rows", groupby + " = " + k) + " · " + len(members(k)) + " rows")] +
          map(members(k), r => rrowof(r.id, r.cells, false))))}]) +
      [{sql: "SELECT " + if(grouping, join(if(groupby == "", [], [groupby]) + map(aggs, a => aggsql(a)), ", "),
          if(len(select) == 0, "*", join(select, ", "))),
        note: if(grouping, "one row per group", "" + len(outcols) + " columns"), cols: outcols, rows: outrows}] +
      if(orderby == "", [], [{sql: "ORDER BY " + orderby + if(desc, " DESC", ""), note: "sorted " + if(numeric, "as numbers", "as text"),
        cols: outcols, rows: ordered}]))

  pos = steps (len(stages)) "stage"
  stage = stages[pos]

  project md = ("```sql\n" + join(map(stages, s => s.sql), "\n") + "\n```\n\n" +
      join(map(range(0, len(stages) - 1), k => "**" + (k + 1) + ". " + stages[k].sql + "** (" + stages[k].note + ")\n\n" +
        mdtable(stages[k].cols, mdrows(len(stages[k].cols), stages[k].rows, false))), "\n"))

  frame kind="Query" title=title status=("**" + stage.sql + "** — " + stage.note + ".")
    flex align=stretch
      pane title="Query" note=("stage " + (pos + 1) + " of " + len(stages)) grow basis=m
        stack gap=xs pad=s
          each k in 0..(len(stages) - 1)
            press kind=plain id=("stage" + k) label=(stages[k].sql) selected=(k == pos)
              stack if=(k == pos)
                flex pad=s gap=m radius=card stroke=info tint=info align=baseline wrap=false
                  text ("" + (k + 1)) font=mono size=small tone=info
                  text (stages[k].sql) font=mono weight=bold literal=true align=start
              stack if=(k != pos)
                flex pad=s gap=m radius=card align=baseline wrap=false
                  text ("" + (k + 1)) font=mono size=small tone=muted
                  text (stages[k].sql) font=mono tone=(if(k < pos, ink, muted)) literal=true align=start
              @click set pos=k
      pane title="Rows" note=(stage.note) grow basis=m
        reltable stage.cols stage.rows
