datagrid@1 "Records under a header row: columns aligned and monospaced, rows and cells marked with a glyph and a word in a tone, a legend of the marks, a side pane whose items light the rows that have them, and an optional current row that steps through the rows and plays."
  in title text = "Rows" "the header's title"
  in kind text = "Table" "what kind of thing it is, said small before the title"
  in name text = "" "the table's name, over its rows"
  in cols list(record col {label: text, align: choice(start|center|end) = start, mono: bool = false, badge: text = "", lit: bool = false, divider: bool = false, width: int 0..6 = 0}) "the columns: a heading, its alignment, monospaced, a badge after the heading (FK), lit as the sort key, a rule on its left, and its share of the width (out of 12 with the ids and notes; 0 in every column: by what they hold)"
  in rows list(record row {id: text, cells: list(text), mark: text = "", note: text = ""}) "the rows: an id, a cell per column, a mark (the id of one of the marks) and a note at the end"
  in marks list(record mark {id: text, glyph: text, label: text, tone: choice(info|ok|warn|bad|muted|accent) = info, struck: bool = false}) = [] "the legend: what a mark means; a row with it is washed in its tone and shows its glyph, or is struck through when the mark is struck"
  in values list(record value {value: text, tone: choice(info|ok|warn|bad|muted|accent)}) = [] "cells washed by what they say; muted shows the value faded instead (off, unset, NULL)"
  in cellmarks list(record cellmark {row: text, col: text, glyph: text = "", label: text = "", tone: choice(info|ok|warn|bad|muted|accent) = bad, outline: bool = false}) = [] "single cells marked, by row id and column heading: a glyph, what it means, a tone (a wash, or an outline)"
  in ids choice(keys|names|off) = keys "the gutter of row ids: small keys, names, or no gutter"
  in idhead text = "" "the gutter's heading"
  in side text = "" "a side pane's title: its items are the values of the column `match`, and picking one lights the rows that have it"
  in match text = "" "the column the side pane's items come from"
  in hint text = "" "what the bar says while nothing is picked"
  in follow bool = false "step through the rows: the current one is lit, the ones passed take the mark `done`, and the bar plays it"
  in start int = 0 "the row it starts at, from 0"
  in done text = "" "the mark a passed row takes"
  in pending list(text) = [] "the columns whose cells read — until their row is passed"
  in verb text = "At" "the status while following: the verb, the row's id, its cells"
  in window int 0..50 = 0 "how many rows show at once while following, kept around the current one (0: all)"
  in height size = none "the stage's height; none fits the rows"
  in key bool = true "a legend of the marks under the rows (marks without a glyph are left out)"

  fn tonewash(t: text): color = if(t == "ok", ok, if(t == "warn", warn, if(t == "bad", bad, if(t == "info", info, if(t == "muted", muted, if(t == "accent", accent, surface))))))

  n = len(cols)
  labels = map(cols, c => c.label)
  gutter = ids != off
  notes = len(filter(rows, r => r.note != "")) > 0
  # shares of the width (a grid of at most 12 columns): as given, or, when no column gives one, by how
  # much each column has to say (monospaced text is wider), with room for padding and glyphs
  auto = fold(cols, true, (a, c) => a and c.width == 0)
  fn longest(c: int): num = fold(rows, 0, (a, r) => max(a, len(at(r.cells, c, ""))))
  fn chars(c: int): num = max(len(cols[c].label) * 1.1 + if(cols[c].badge == "", 0, len(cols[c].badge) + 6) + if(cols[c].lit, 2, 0),
      longest(c) * if(cols[c].mono, 1.3, 1)) + 3
  gchars = if(gutter, fold(rows, len(idhead), (a, r) => max(a, len(r.id))) * if(ids == keys, 1.05, 1.3) + if(len(marks) > 0, 2, 0) + 3, 0)
  nchars = if(notes, min(28, fold(rows, 0, (a, r) => max(a, len(r.note)))) * 0.6 + 3, 0)
  # the columns' weights, then the gutter's and the notes' (0 when there are none), shared out of 12
  # a grid that has little to say still spans the pane: the slack goes to the notes, or else to the
  # last column of text that starts at the left
  needs = map(range(0, n - 1), c => chars(c)) + [gchars, nchars]
  texts = filter(range(0, n - 1), c => "" + cols[c].align == "start" and not cols[c].mono)
  filler = if(notes, n + 1, if(len(texts) > 0, last(texts), n - 1))
  slack = max(0, 48 - fold(needs, 0, (a, w) => a + w))
  weights = map(range(0, n + 1), i => needs[i] + if(i == filler, slack, 0))
  shares = gridshares(weights)

  asked = map(range(0, n - 1), c => if(auto, shares[c], if(cols[c].width == 0, 2, cols[c].width)))
  gasked = if(not gutter, 0, if(auto, shares[n], 2))
  nasked = if(not notes, 0, if(auto, shares[n + 1], 3))
  widths = fold(asked, 0, (a, w) => a + w) + gasked + nasked
  fit = widths <= 12
  across = max(1, min(12, if(fit, widths, n + if(gutter, 1, 0) + if(notes, 1, 0))))
  gspan = if(fit, gasked, min(1, gasked))
  nspan = if(fit, nasked, min(1, nasked))
  fn wide(c: int): int = if(fit, asked[c], 1)
  # the least width, in characters: where the tightest column (not the one taking the slack) just
  # fits its share, and no less than what all of them have to say
  spans = map(range(0, n - 1), c => wide(c)) + [gspan, nspan]
  tightest = fold(range(0, n + 1), 0, (a, i) => if(i == filler or spans[i] == 0, a, max(a, needs[i] * across / spans[i])))
  strut = join(map(range(1, max(1, round(0.8 max(tightest, fold(needs, 0, (a, w) => a + w))))), i => " "), "")

  pos = steps (max(1, len(rows))) play=8s = (max(0, min(len(rows) - 1, start))) "row"
  var pick text = ""

  # a mark, by its id ("" is none)
  fn mglyph(id: text): text = at(map(filter(marks, m => m.id == id), m => m.glyph), 0, "")
  fn mlabel(id: text): text = at(map(filter(marks, m => m.id == id), m => m.label), 0, "")
  fn mtone(id: text): text = at(map(filter(marks, m => m.id == id), m => "" + m.tone), 0, "")
  fn mstruck(id: text): bool = at(map(filter(marks, m => m.id == id), m => m.struck), 0, false)

  # a row: its mark now, current, lit from the side pane, struck, and its wash
  mi = indexof(labels, match)
  fn mark(k: int): text = if(follow and k < pos and done != "", done, rows[k].mark)
  fn current(k: int): bool = follow and k == pos
  fn linked(k: int): bool = pick != "" and at(rows[k].cells, mi, "") == pick
  fn struck(k: int): bool = mstruck(mark(k))
  fn rwash(k: int): text = if(current(k) or linked(k), "info", if(struck(k), "", mtone(mark(k))))

  # a cell: what it says now, its mark, the tone its value gives it, and its wash
  fn pend(k: int, c: int): bool = follow and k >= pos and indexof(pending, labels[c]) >= 0
  fn raw(k: int, c: int): text = if(pend(k, c), "—", at(rows[k].cells, c, ""))
  fn cms(k: int, c: int) = filter(cellmarks, m => m.row == rows[k].id and m.col == labels[c])
  fn vtone(k: int, c: int): text = at(map(filter(values, v => v.value == raw(k, c)), v => "" + v.tone), 0, "")
  fn faded(k: int, c: int): bool = pend(k, c) or vtone(k, c) == "muted"
  fn ctone(k: int, c: int): text = at(map(cms(k, c), m => "" + m.tone), 0, "")
  fn outlined(k: int, c: int): bool = at(map(cms(k, c), m => m.outline), 0, false)
  fn cwash(k: int, c: int): text = if(current(k) or linked(k) or struck(k), rwash(k),
      if(len(cms(k, c)) > 0 and not outlined(k, c), ctone(k, c), if(vtone(k, c) != "" and vtone(k, c) != "muted", vtone(k, c), rwash(k))))
  fn dcell(k: int, c: int) = {v: raw(k, c), wash: cwash(k, c), tone: if(faded(k, c), "muted", "ink"), glyph: at(map(cms(k, c), m => m.glyph), 0, ""),
      gtone: ctone(k, c), outline: outlined(k, c), mono: cols[c].mono or faded(k, c), align: cols[c].align, span: wide(c), rule: cols[c].divider}

  # the rows shown: all, or a window kept around the current one; the last is faded when more follow
  first = if(follow and window > 0, max(0, min(len(rows) - window, pos - 1)), 0)
  last = if(follow and window > 0, min(len(rows) - 1, first + window - 1), len(rows) - 1)
  shown = range(first, last)
  fn drawn(k: int) = {id: rows[k].id, key: ids == keys, glyph: mglyph(mark(k)), gtone: mtone(mark(k)), gspan: gspan, wash: rwash(k), struck: struck(k),
      current: current(k), bar: follow, dim: follow and window > 0 and k == last and last < len(rows) - 1, note: rows[k].note, nspan: nspan, across: across,
      cells: map(range(0, n - 1), c => dcell(k, c))}
  head = map(range(0, n - 1), c => {label: cols[c].label, align: cols[c].align, badge: cols[c].badge, lit: cols[c].lit, span: wide(c), rule: cols[c].divider})

  legend = if(key, filter(marks, m => m.glyph != ""), [])

  # the side pane's items: the column's values in order of first appearance
  items = if(mi < 0, [], fold(rows, [], (xs, r) => if(indexof(xs, at(r.cells, mi, "")) >= 0, xs, xs + [at(r.cells, mi, "")])))
  lit = len(filter(range(0, len(rows) - 1), k => linked(k)))
  fn says(k: int): text = join(filter(map(range(0, n - 1), c => if(pend(k, c), "", at(rows[k].cells, c, ""))), v => v != ""), " · ")
  status = if(follow and len(rows) > 0, verb + " **" + rows[pos].id + "** · " + says(pos),
      if(side == "", "", if(pick == "", hint, "**" + pick + "** · " + lit + " of " + len(rows) + " rows")))

  fn mdcell(k: int, c: int): text = at(rows[k].cells, c, "") + at(map(cms(k, c), m => " " + m.glyph + if(m.label == "", "", " (" + m.label + ")")), 0, "")
  fn mdrow(k: int): list(text) = map(if(gutter, [rows[k].id + if(rows[k].mark == "", "", " " + mglyph(rows[k].mark) + " " + mlabel(rows[k].mark))], []) +
      map(range(0, n - 1), c => mdcell(k, c)) + if(notes, [rows[k].note], []), x => if(mstruck(rows[k].mark) and x != "", "~~" + x + "~~", x))
  project md = (if(name == "", "", "**" + name + "**\n\n") + mdtable(if(gutter, [if(idhead == "", "id", idhead)], []) + labels + if(notes, ["note"], []),
      map(range(0, len(rows) - 1), k => mdrow(k))) +
      if(len(marks) == 0, "", "\n" + join(map(marks, m => m.glyph + " " + m.label), " · ") + "\n"))

  frame kind=kind title=title height=height status=status
    flex align=stretch
      pane title=(if(name == "", "", "table **" + name + "**")) note=(if(name == "", "", "" + len(rows) + " rows")) grow basis=l
        # a row holding the table, so a pane narrower than the table scrolls sideways instead of
        # squeezing its cells over each other: a blank line of figure spaces (they don't break) sets
        # the least width, from how much the columns have to say
        flex wrap=false
          stack grow
            gridhead head gutter=idhead gspan=gspan nspan=nspan across=across bar=follow
            divider
            each k in shown key=rows[k].id
              press kind=plain id=(rows[k].id) label=("go to " + rows[k].id) selected=(current(k)) if=follow
                gridrow (drawn(k))
                @click set pos=k
              gridrow (drawn(k)) if=(not follow)
              divider
            flex pad=m if=(len(rows) == 0)
              text "No rows." tone=muted
            text strut font=mono size=small literal=true wrap=false
        fill footer
          flex gap=s align=center if=(len(legend) > 0)
            each m in legend key=m.id
              flex pad=xs gap=s radius=pill tint=(tonewash("" + m.tone)) align=center wrap=false
                text ""
                text (m.glyph) size=small tone=ink wrap=false
                text (m.label) size=small tone=ink wrap=false
                text ""
      pane title=side basis=s if=(side != "")
        stack gap=xs pad=s
          each it in items key=it
            press kind=plain id=(match + ":" + it) label=it selected=(pick == it)
              flex pad=s radius=card tint=(if(pick == it, info, surface))
                text it
              @click set pick=(if(pick == it, "", it))
    fill bar
      switch on=follow
        case true
          controls pos
