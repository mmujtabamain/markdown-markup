{ "widget": "query@1", "cases": {
  "by-dept": { "summary": "Staff earning at least 80, grouped by department with a count and an average, largest average first.",
    "props": { "table": { "name": "staff", "cols": ["id", "name", "dept", "salary"],
        "rows": [["1", "Ada", "Eng", "120"], ["2", "Brook", "Sales", "80"], ["3", "Cy", "Eng", "95"], ["4", "Dee", "Ops", "70"], ["5", "Eli", "Sales", "88"], ["6", "Fay", "Eng", "60"]] },
      "where": [{ "col": "salary", "op": "ge", "value": "80" }],
      "groupby": "dept",
      "aggs": [{ "func": "count", "as": "n" }, { "func": "avg", "col": "salary", "as": "mean" }],
      "orderby": "mean", "desc": true },
    "play": [{ "set": { "pos": 1 } }, { "wait": 300 }, { "set": { "pos": 2 } }, { "wait": 300 }, { "set": { "pos": 4 } }] },
  "filter-project": { "summary": "Engineers' names and salaries, sorted by name: no grouping.",
    "props": { "table": { "name": "staff", "cols": ["id", "name", "dept", "salary"],
        "rows": [["1", "Ada", "Eng", "120"], ["2", "Brook", "Sales", "80"], ["3", "Cy", "Eng", "95"], ["6", "Fay", "Eng", "60"]] },
      "where": [{ "col": "dept", "value": "Eng" }], "select": ["name", "salary"], "orderby": "salary" },
    "play": [{ "set": { "pos": 3 } }] },
  "total": { "summary": "One aggregate over all rows: the total of a column.",
    "props": { "table": { "name": "orders", "cols": ["item", "qty"], "rows": [["pen", "3"], ["ink", "2"], ["pad", "5"]] },
      "aggs": [{ "func": "sum", "col": "qty", "as": "total" }] } },
  "bad-op": { "summary": "An unknown comparison is refused.",
    "props": { "table": { "cols": ["a"], "rows": [["1"]] }, "where": [{ "col": "a", "op": "like", "value": "1" }] },
    "expect": { "errors": ["mkp.enum"] } } } }
