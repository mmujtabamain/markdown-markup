# The rows of a data grid, shared by datagrid and reltable: a header band and rows of cells on a grid
# of `across` columns, each cell spanning its share. Tones travel as names ("ok", "warn", "" for none),
# because a record from YAML can't hold a colour.

# shares of a 12-column grid in proportion to weights, by largest remainder, so they add up to 12; each
# weight above 0 gets at least one (and then they may add up to more)
fn gridwhole(ws: list(num)): num = max(1, fold(ws, 0, (a, w) => a + w))
fn gridfloor(w: num, whole: num): int = if(w <= 0, 0, max(1, floor(12 w / whole)))
fn gridspare(ws: list(num)): int = 12 - fold(ws, 0, (a, w) => a + gridfloor(w, gridwhole(ws)))
fn gridextra(ws: list(num)): list(int) = first(sort(filter(range(0, len(ws) - 1), i => ws[i] > 0),
    i => gridfloor(ws[i], gridwhole(ws)) - 12 ws[i] / gridwhole(ws)), max(0, gridspare(ws)))
fn gridshares(ws: list(num)): list(int) = map(range(0, len(ws) - 1), i => gridfloor(ws[i], gridwhole(ws)) + if(indexof(gridextra(ws), i) >= 0, 1, 0))

part gridhead@1 "A data grid's header row: a band of column headings, each aligned, with a badge, lit as the sort key (a diamond), or with a rule on its left."
  fields cols
  in cols list({label: text, align: choice(start|center|end), badge: text, lit: bool, span: int, rule: bool}) "the headings, each with its share of the across columns"
  in gutter text = "" "the gutter's heading"
  in gspan int 0..12 = 0 "the gutter's share (0: no gutter)"
  in nspan int 0..12 = 0 "the notes' share (0: no notes)"
  in across int 1..12 = 1 "columns in all"
  in bar bool = false "room for a current row's bar on the left"
  in maths bool = false "the headings are TeX"
  flex align=stretch wrap=false tint=muted
    stack pad=xs tint=muted if=bar
    grid cols=across align=stretch grow
      flex span=(max(1, gspan)) gap=s pad=s align=center wrap=false if=(gspan > 0)
        text ""
        text gutter size=small weight=bold wrap=false
      each i in 0..(len(cols) - 1)
        flex span=(max(1, cols[i].span)) align=stretch wrap=false
          stack pad=xs tint=ink if=(cols[i].rule)
          flex gap=s pad=s align=center justify=(cols[i].align) tint=(if(cols[i].lit, info, muted)) grow
            text ""
            text (cols[i].label) size=small weight=bold if=(not maths)
            text "$\val{cols[i].label}$" size=small weight=bold if=maths
            flex pad=xs gap=s radius=pill tint=info align=center wrap=false if=(cols[i].badge != "")
              text ""
              text (cols[i].badge) font=mono size=small tone=info wrap=false
              text ""
            text "◆" size=small tone=info if=(cols[i].lit)
            text ""
      stack span=(max(1, nspan)) if=(nspan > 0)

part gridrow@1 "One row of a data grid, drawn as it is marked: a gutter with its id and its mark's glyph, its cells, a note at its end; washed in a tone, struck through, faded, or current with a bar on its left."
  fields row
  in row {id: text, key: bool, glyph: text, gtone: text, gspan: int, wash: text, struck: bool, current: bool, bar: bool, dim: bool, note: text, nspan: int, across: int, cells: list({v: text, wash: text, tone: text, glyph: text, gtone: text, outline: bool, mono: bool, align: choice(start|center|end), span: int, rule: bool})} "the row as drawn: its id (a key is small and muted, a name is not), its mark's glyph and tone, the gutter's and notes' shares, its wash, struck, current, the bar's room, faded, its note, columns in all, and its cells (value, wash, ink, glyph, outlined, monospaced, alignment, share, a rule on the left)"
  # a tone's name as a wash, and as ink ("" and unknown names: none)
  fn tonewash(t: text): color = if(t == "ok", ok, if(t == "warn", warn, if(t == "bad", bad, if(t == "info", info, if(t == "muted", muted, if(t == "accent", accent, surface))))))
  fn toneink(t: text): color = if(t == "ok", ok, if(t == "warn", warn, if(t == "bad", bad, if(t == "info", info, if(t == "muted", muted, if(t == "accent", accent, ink))))))
  flex align=stretch wrap=false dim=(row.dim or row.struck)
    stack pad=xs fill=info if=(row.bar and row.current)
    stack pad=xs tint=(tonewash(row.wash)) if=(row.bar and not row.current)
    grid cols=(row.across) align=stretch grow
      flex span=(max(1, row.gspan)) gap=s pad=s align=center wrap=false tint=(tonewash(row.wash)) if=(row.gspan > 0)
        text ""
        text (row.id) font=mono size=(if(row.key, small, normal)) tone=(if(row.key, muted, ink)) literal=true wrap=false if=(not row.struck)
        text ("~~" + row.id + "~~") font=mono size=(if(row.key, small, normal)) tone=(if(row.key, muted, ink)) wrap=false if=(row.struck)
        text (row.glyph) size=small weight=bold tone=(toneink(row.gtone)) wrap=false if=(row.glyph != "")
      each i in 0..(len(row.cells) - 1)
        flex span=(max(1, row.cells[i].span)) align=stretch wrap=false
          stack pad=xs tint=ink if=(row.cells[i].rule)
          # outlined (a cell that is wrong, with its glyph): the same content in a box of its tone
          flex gap=s pad=s align=center wrap=false justify=(row.cells[i].align) tint=(tonewash(row.cells[i].wash)) stroke=(tonewash(row.cells[i].gtone)) grow if=(row.cells[i].outline)
            text ""
            text (row.cells[i].v) font=(if(row.cells[i].mono, mono, body)) tone=(toneink(row.cells[i].tone)) literal=true align=(row.cells[i].align)
            text (row.cells[i].glyph) size=small weight=bold tone=(toneink(row.cells[i].gtone)) wrap=false if=(row.cells[i].glyph != "")
            text ""
          flex gap=s pad=s align=center wrap=false justify=(row.cells[i].align) tint=(tonewash(row.cells[i].wash)) grow if=(not row.cells[i].outline)
            text ""
            text (row.cells[i].v) font=(if(row.cells[i].mono, mono, body)) tone=(toneink(row.cells[i].tone)) literal=true align=(row.cells[i].align) if=(not row.struck)
            text (if(row.cells[i].v == "", "", "~~" + row.cells[i].v + "~~")) font=(if(row.cells[i].mono, mono, body)) tone=(toneink(row.cells[i].tone)) align=(row.cells[i].align) if=(row.struck)
            text (row.cells[i].glyph) size=small weight=bold tone=(toneink(row.cells[i].gtone)) wrap=false if=(row.cells[i].glyph != "")
            text ""
      flex span=(max(1, row.nspan)) gap=s pad=s align=center tint=(tonewash(row.wash)) if=(row.nspan > 0)
        text ""
        text (row.note) size=small tone=muted literal=true align=start if=(not row.struck)
        text (if(row.note == "", "", "~~" + row.note + "~~")) size=small tone=muted align=start if=(row.struck)
