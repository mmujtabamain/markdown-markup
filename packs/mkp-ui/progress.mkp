progress@1 "How far along something is: a bar with its label and amount."
  fields value total label
  in value num "how much is done"
  in total num = 1 "how much there is"
  in label text = ""
  in show choice(percent|fraction|none) = percent "how the amount is written"
  in tone color = accent
  in size size = fill "the bar's width: s, m, l or fill (the default: as wide as its place)"
  done = max(0, min(1, value/total))
  amount = if(show == percent, "" + round(100 done) + "%", if(show == fraction, "" + value + " of " + total, ""))
  stack gap=xs
    flex gap=m justify=between if=(label != "" or show != none)
      text label tone=muted size=small
      text amount size=small
    canvas x=0..1 y=0..1 aspect=28 size=size label=(if(label != "", label + ": ", "progress: ") + round(100 done) + "%")
      # round ends: a circle's radius is in x units, and the bar is 28 times wider than tall
      layer opacity=0.25
        rect (1/56, 0) (1 - 1/56, 1) fill=muted stroke=none
        circle (1/56, 0.5) (1/56) fill=muted
        circle (1 - 1/56, 0.5) (1/56) fill=muted
      layer if=(done > 0)
        rect (1/56, 0) (1/56 + done (1 - 1/28), 1) fill=tone stroke=none
        circle (1/56, 0.5) (1/56) fill=tone
        circle (1/56 + done (1 - 1/28), 0.5) (1/56) fill=tone
