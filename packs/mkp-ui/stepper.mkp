part stepper@1 "Back and forward buttons over 0..last, bound to the caller's state."
  fields at last
  in at ref int "the caller's position"
  in last int "the last position"
  out moved "after either button moves"
  flex gap=s align=center
    press label="previous" disabled=(at <= 0)
      text "‹"
      @click set at=max(at - 1, 0) emit moved
    text "\val{at + 1} of \val{last + 1}" tone=muted
    press label="next" disabled=(at >= last)
      text "›"
      @click set at=min(at + 1, last) emit moved
