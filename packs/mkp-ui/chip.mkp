chip@1 "A compact outlined tag: a term, a filter or an attribute, with an optional symbol."
  fields text icon
  in text text
  in icon text = "" "a symbol or $maths$ shown before the text"
  in tone color = muted "the outline and symbol colour"
  flex pad=xs gap=s stroke=tone radius=pill align=center wrap=false
    text ""
    text icon tone=tone size=small if=(icon != "")
    text text size=small wrap=false
    text ""
