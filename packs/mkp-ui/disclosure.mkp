disclosure@1 "A titled section the reader opens and closes."
  fields title
  in title text "always shown"
  in open bool = false "start open"
  in body slot
  var flipped bool = false
  shown = if(flipped, not open, open)
  stack gap=s
    press id=header label=(title + if(shown, ", open", ", closed"))
      flex gap=s align=center wrap=false
        text (if(shown, "▾", "▸")) tone=muted
        text title weight=medium
      @click set flipped=(not flipped)
    stack pad=m if=shown
      slot body
