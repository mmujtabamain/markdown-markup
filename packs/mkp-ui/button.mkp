part button@1 "A button with a text label (and an optional symbol before it) that raises click."
  fields label
  in label text "what the button says"
  in icon text = "" "a symbol shown before the label"
  in tone color = none "the label's colour"
  in disabled bool = false
  out click "when pressed"
  press id=button disabled=disabled tone=tone
    flex gap=s align=center wrap=false
      text icon if=(icon != "")
      text label
    @click emit click
