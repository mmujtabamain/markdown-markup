part playback@1 "A playback bar over frames 0..last: restart, step, play and pause, bound to the caller's frame."
  fields at last
  in at ref int "the caller's frame"
  in last int "the last frame"
  in pace choice(slow|normal|fast) = normal "time per frame: 1.2 s, 0.6 s or 0.25 s"
  in loop bool = false "start again after the last frame"
  out moved "after any button or Play moves the frame"
  next = if(at >= last, if(loop, 0, last), at + 1)
  # three clocks; each flip of one moves a frame
  tslow = steps 2 play=2400ms loop=repeat "slow clock"
    @change set going=(loop or next < last) at=next emit moved
  tnormal = steps 2 play=1200ms loop=repeat "clock"
    @change set going=(loop or next < last) at=next emit moved
  tfast = steps 2 play=500ms loop=repeat "fast clock"
    @change set going=(loop or next < last) at=next emit moved
  # flipping going pauses every clock, so Play is: going on, then start one
  going = toggle "playing"
    @change pause tslow pause tnormal pause tfast
  flex gap=xs align=center
    stack hidden
      controls tslow tnormal tfast going
    press id=restart label="restart" disabled=(at <= 0 and not going)
      text "⏮"
      @click set going=false at=0 emit moved
    press id=back label="previous frame" disabled=(at <= 0)
      text "‹"
      @click set going=false at=(max(at - 1, 0)) emit moved
    press id=play_slow label="play" if=(pace == slow and not going)
      text "▶"
      @click set at=(if(at >= last, 0, at)) going=true play tslow
    press id=play label="play" if=(pace == normal and not going)
      text "▶"
      @click set at=(if(at >= last, 0, at)) going=true play tnormal
    press id=play_fast label="play" if=(pace == fast and not going)
      text "▶"
      @click set at=(if(at >= last, 0, at)) going=true play tfast
    press id=pause label="pause" if=going
      text "⏸"
      @click set going=false
    press id=forward label="next frame" disabled=(at >= last)
      text "›"
      @click set going=false at=(min(at + 1, last)) emit moved
    text "\val{at + 1} / \val{last + 1}" tone=muted size=small
