part tabs@1 "Tabs over panes; each tab has a title and content."
  in pages list(record tab {title: text} slot)
  var at int = 0
  stack gap=s
    flex gap=xs
      each t in 0..(len(pages) - 1)
        press kind=tab selected=(t == at)
          text pages[t].title
          @click set at=t
    slot pages[at].slot
