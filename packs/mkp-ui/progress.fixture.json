{
  "widget": "progress@1",
  "cases": {
    "percent": {
      "summary": "Seven of ten steps done, as a percentage.",
      "props": {
        "value": 7,
        "total": 10,
        "label": "Lessons"
      }
    },
    "fraction": {
      "summary": "Progress written as a fraction, in the success colour.",
      "props": {
        "value": 3,
        "total": 8,
        "label": "Exercises",
        "show": "fraction",
        "tone": "ok"
      }
    },
    "bare": {
      "summary": "A bare bar at one third.",
      "props": {
        "value": 0.333,
        "show": "none"
      }
    },
    "bad-show": {
      "props": {
        "value": 1,
        "show": "bars"
      },
      "expect": {
        "errors": [
          "mkp.enum"
        ]
      }
    }
  }
}
