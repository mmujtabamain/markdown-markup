{
  "widget": "slider@1",
  "cases": {
    "basic": {
      "summary": "A slider for an angle in degrees, in steps of 5.",
      "props": {
        "value": {
          "state": 30
        },
        "min": 0,
        "max": 180,
        "step": 5,
        "label": "angle",
        "unit": "°"
      }
    },
    "play": {
      "summary": "A slider for t with Play, swept for a second.",
      "props": {
        "value": {
          "state": 0
        },
        "label": "$t$",
        "digits": 2,
        "play": true
      },
      "play": [
        {
          "press": "play"
        },
        {
          "wait": 1000
        },
        {
          "press": "pause"
        }
      ]
    },
    "loop": {
      "summary": "A looping sweep of a phase.",
      "props": {
        "value": {
          "state": 0
        },
        "max": 6.28,
        "label": "phase",
        "digits": 2,
        "play": true,
        "loop": true
      },
      "play": [
        {
          "press": "play_loop"
        },
        {
          "wait": 5000
        }
      ]
    }
  }
}
