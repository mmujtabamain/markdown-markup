board@1 "Columns of cards on a tray, a kanban or a pipeline: each column shows its load against its limit (amber when full), and selecting a card moves it on to the next column unless that one is full."
  in title text = "Board" "the header's title"
  in kind text = "Board" "what kind of thing it is, said small before the title"
  in columns list(record column {id: text, label: text, limit: int 0..99 = 0}) "the columns, left to right: an id, a heading, and at most this many cards (0: no limit)"
  in cards list(record card {id: text, column: text, title: text, code: text = ""}) "the cards: an id, the column it starts in, its title and a small code above it"
  in hint text = "Select a card to move it on." "what the bar says before anything is moved"
  in height size = none "the stage's height; none fits the board"

  # where each card has been moved to (by id), what the bar says, and the card whose move was refused
  var moved dict(text) = {}
  var said text = ""
  var refused text = ""

  ids = map(columns, c => c.id)
  limits = map(columns, c => c.limit)
  names = map(columns, c => c.label)
  fn where(id: text, start: text): text = get(moved, id, start)
  fn load(col: text): int = len(filter(cards, k => where(k.id, k.column) == col))
  fn full(i: int): bool = at(limits, i, 0) > 0 and load(at(ids, i, "")) >= at(limits, i, 0)
  # a card's next column (its index), whether it is in the last one, and whether the next one is full
  fn onto(id: text, start: text): int = indexof(ids, where(id, start)) + 1
  fn final(id: text, start: text): bool = onto(id, start) >= len(columns)
  fn blocked(id: text, start: text): bool = not final(id, start) and full(onto(id, start))
  # the tallest a column is at the start, or may be by its limit: every tray keeps room for that many
  room = max(fold(limits, 0, (a, x) => max(a, x)), fold(ids, 0, (a, col) => max(a, len(filter(cards, k => k.column == col)))))
  lines = if(fold(cards, 0, (a, k) => max(a, len(k.title))) > 22, 2, 1)
  status = if(said == "", hint, said)

  project md = join(map(columns, c => "**" + c.label + "** (" + load(c.id) + if(c.limit > 0, " of " + c.limit, "") + ")\n\n" +
      join(map(filter(cards, k => where(k.id, k.column) == c.id), k => "- " + if(k.code == "", "", "`" + k.code + "` ") + k.title), "\n") +
      if(load(c.id) == 0, "_(empty)_", "")), "\n\n") + "\n"

  frame kind=kind title=title height=height status=status
    # trays side by side, each at least about 16 characters wide (a blank line of figure spaces, which
    # don't break), so a narrow screen scrolls the board sideways rather than squeezing its cards
    flex gap=s pad=s align=stretch wrap=false
      each i in range(0, len(columns) - 1) key=ids[i]
        stack gap=xs pad=xs radius=card tint=muted grow
          flex justify=between align=center gap=s pad=s wrap=false
            text (names[i]) size=small weight=bold wrap=false
            flex pad=xs radius=pill fill=surface stroke=surface align=center wrap=false if=(not full(i))
              text ""
              text ("" + load(ids[i])) font=mono size=small wrap=false
              text ("/" + limits[i]) font=mono size=small tone=muted wrap=false if=(limits[i] > 0)
              text ""
            flex pad=xs radius=pill tint=warn align=center wrap=false if=(full(i))
              text ""
              text ("" + load(ids[i]) + "/" + limits[i]) font=mono size=small tone=warn weight=medium wrap=false
              text ""
          each k in filter(cards, k => where(k.id, k.column) == ids[i]) key=k.id
            press kind=plain id=(k.id) label=(k.id + ": " + k.title) disabled=(final(k.id, k.column))
              flex pad=s gap=s radius=card align=center wrap=false fill=surface stroke=(if(refused == k.id, warn, muted)) dim=(final(k.id, k.column))
                stack grow
                  text (k.code) font=mono size=small tone=muted lines=1 align=start
                  text (k.title) tone=(if(blocked(k.id, k.column), muted, ink)) lines=lines align=start
                icon name=check tone=ok label="done" if=(final(k.id, k.column))
                icon name=ban tone=warn label="blocked: the next column is full" if=(blocked(k.id, k.column))
                icon name=right label="move on" if=(not final(k.id, k.column) and not blocked(k.id, k.column))
              @click set said=(if(blocked(k.id, k.column), names[onto(k.id, k.column)] + " is full (" + limits[onto(k.id, k.column)] + "). Finish something there first.", "Moved **" + k.id + "** on to " + at(names, onto(k.id, k.column), "") + ".")) refused=(if(blocked(k.id, k.column), k.id, "")) moved=(if(blocked(k.id, k.column), moved, put(moved, k.id, at(ids, onto(k.id, k.column), ""))))
          # empty places, so a tray keeps its height as cards come and go
          each e in range(1, room - load(ids[i])) key=e
            flex pad=s gap=s align=center wrap=false
              stack grow
                text "" size=small lines=1
                text "" lines=lines
          text "                " font=mono size=small literal=true wrap=false
