
# one Fruchterman–Reingold step: nodes push each other apart, edges pull their ends together,
# a weak pull keeps loose parts near the centre, and no node moves further than temp
fn push(ps: list(point), i: int, k: num): point = fold(range(0, len(ps) - 1), (0, 0), (acc, j) =>
    if(j == i, acc, acc + (ps[i] - ps[j]) * (k^2 / max(dist(ps[i], ps[j])^2, 0.0001))))
fn pull(ps: list(point), nb: list(int), i: int, k: num): point = fold(nb, (0, 0), (acc, j) =>
    acc + (ps[i] - ps[j]) * (dist(ps[i], ps[j]) / k))
fn cap(d: point, temp: num): point = d * (min(dist(d, (0, 0)), temp) / max(dist(d, (0, 0)), 0.000000001))
fn relax(ps: list(point), adj: list(list(int)), k: num, temp: num): list(point) = map(range(0, len(ps) - 1), i =>
    ps[i] + cap(push(ps, i, k) - pull(ps, adj[i], i, k) - ps[i] * 0.05, temp))

# stretch a layout to fill [-w, w] × [-h, h]
fn fit(ps: list(point), w: num, h: num): list(point) = map(ps, p => (
    if(max(map(ps, q => q.x)) > min(map(ps, q => q.x)),
      -w + 2 w (p.x - min(map(ps, q => q.x)))/(max(map(ps, q => q.x)) - min(map(ps, q => q.x))), 0),
    if(max(map(ps, q => q.y)) > min(map(ps, q => q.y)),
      -h + 2 h (p.y - min(map(ps, q => q.y)))/(max(map(ps, q => q.y)) - min(map(ps, q => q.y))), 0)))

network@1 "A graph laid out by forces: edges act as springs and nodes repel, so clusters show; replay the layout settling, and choose a node to light it and its links."
  budget 20000000
  fields nodes edges
  in nodes list({id: text, label: text, kind: text = "", icon: text = "none", tone: text = "", note: text = "", detail: text = ""}) "each node's id and what it shows; a kind, icon, tone and note as graph's nodes have (no icon by default), and detail, said in the bar when it is chosen"
  in edges list(record link {from: text, to: text, label: text = ""}) "pairs of node ids, with an optional label"
  in directed bool = true "arrows (true) or plain lines (false)"
  in seed int = 1 "change it for a different starting layout"
  in size size = l
  in kind text = "Network" "what kind of diagram it is, said small before the title"
  in title text = "" "the title"
  pick = steps (len(nodes)) = -1 "node"
  settle = slider 0..1 step=0.01 play=3s = 1 "layout"
  ids = map(nodes, n => n.id)
  n = len(nodes)
  # edges between two known, different nodes, as index pairs
  good = filter(edges, e => indexof(ids, e.from) >= 0 and indexof(ids, e.to) >= 0 and e.from != e.to)
  adj = map(range(0, n - 1), i => map(filter(good, e => e.from == ids[i] or e.to == ids[i]),
    e => if(e.from == ids[i], indexof(ids, e.to), indexof(ids, e.from))))
  k = 1.6/sqrt(max(n, 1))
  # start on a circle with a little jitter, then 120 steps, each allowed to move a little less
  start = map(range(0, n - 1), i => (cos(2 pi i/n) + 0.2 rand(seed, i), sin(2 pi i/n) + 0.2 rand(seed, i + 1000)))
  frames = scan({p: start, t: 0.4}, 120, s => {p: relax(s.p, adj, k, s.t), t: 0.97 s.t})
  pos = fit(frames[round(settle (len(frames) - 1))].p, 1.22, 0.84)
  chosen = if(pick >= 0 and pick < n, nodes[pick].id, "")
  joins = map(good, e => {from: e.from, to: e.to})
  cards = map(range(0, n - 1), j => card({id: nodes[j].id, label: nodes[j].label, kind: nodes[j].kind, icon: nodes[j].icon, tone: nodes[j].tone,
      shape: "", note: nodes[j].note, group: ""}, j, litnode(nodes[j].id, chosen, joins)))
  links = map(good, e => {from: e.from, to: e.to, label: e.label, lit: litline(e.from, e.to, chosen), dim: chosen != "" and not litline(e.from, e.to, chosen)})
  project mermaid = ("flowchart LR\n" + join(map(nodes, n => "  " + n.id + "[\"" + n.label + "\"]"), "\n") + "\n"
    + join(map(good, e => "  " + e.from + if(directed, " -->", " ---") + if(e.label != "", "|" + e.label + "|", "") + " " + e.to), "\n"))
  frame kind=kind title=title status=(if(chosen == "", told("", ""), told(nodes[pick].label, if(nodes[pick].detail != "", nodes[pick].detail, nodes[pick].note))))
    fill actions
      controls settle
    zoom
      netmap pos=pos cards=cards links=links ids=ids directed=directed size=size pick=pick

part netmap@1 "A network's nodes where its layout puts them, with their lines: what network draws behind its view lock."
  in pos list(point) "each node's place, in the order of ids"
  in ids list(text)
  in cards list({id: text, label: text, icon: text, tone: text, shape: text, note: text, group: text, k: int, lit: text}) "every node, looked up and lit"
  in links list({from: text, to: text, label: text, lit: bool, dim: bool})
  in directed bool = true
  in size size = l
  in pick ref int "the caller's chosen node, by place; -1 for none"
  canvas x=-1.5..1.5 y=-1..1 size=size label=("a network of " + len(ids) + " nodes and " + len(links) + " links")
    layer if=(not directed)
      each e in links key=(e.from + ">" + e.to)
        line (pos[indexof(ids, e.from)]) (pos[indexof(ids, e.to)]) stroke=(if(e.lit, info, muted)) width=(if(e.lit, 2.5, if(e.dim, 0.75, 1.5)))
    layer
      each nd in cards key=nd.id
        place (pos[indexof(ids, nd.id)])
          gnode nd
            @picked set pick=(if(pick == picked.k, -1, picked.k))
  each e in links key=(e.from + ">" + e.to)
    # an empty label would still draw its chip's background over the line
    arrow from=(e.from) to=(e.to) label=(e.label) tone=(if(e.lit, info, muted)) bold=(e.lit) dim=(e.dim) if=(directed and e.label != "")
    arrow from=(e.from) to=(e.to) tone=(if(e.lit, info, muted)) bold=(e.lit) dim=(e.dim) if=(directed and e.label == "")
