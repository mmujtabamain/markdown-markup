{
  "widget": "sequence@1",
  "cases": {
    "oauth": {
      "summary": "Signing in with OAuth: the app, the browser and the identity provider trade a code for tokens, message by message.",
      "props": {
        "title": "Signing in with OAuth",
        "unit": "ms",
        "actors": [
          { "id": "browser", "label": "Browser" },
          { "id": "app", "label": "App server" },
          { "id": "idp", "label": "Identity provider" }
        ],
        "messages": [
          { "from": "app", "to": "browser", "label": "Redirect to /authorize", "time": "0", "note": "The app sends the user to the identity provider." },
          { "from": "browser", "to": "idp", "label": "GET /authorize?client_id…", "time": "12", "note": "The browser follows the redirect." },
          { "from": "idp", "label": "User signs in", "time": "1800", "note": "Password and second factor, on the provider’s own page." },
          { "from": "idp", "to": "browser", "label": "302 → callback?code=…", "time": "1830", "note": "A one-time code comes back through the browser." },
          { "from": "browser", "to": "app", "label": "GET /callback?code=…", "time": "1845", "note": "The app receives the code." },
          { "from": "app", "to": "idp", "label": "POST /token (code + secret)", "time": "1860", "note": "Server to server: the code is traded for tokens." },
          { "from": "idp", "to": "app", "label": "access + id token", "time": "1905", "note": "The app now knows who the user is." }
        ]
      }
    },
    "tcp-lost": {
      "summary": "A TCP handshake whose SYN-ACK is lost: the client's timer fires and it sends the SYN again.",
      "props": {
        "title": "A handshake that loses its SYN-ACK",
        "unit": "ms",
        "actors": [ { "id": "client", "label": "Client" }, { "id": "server", "label": "Server" } ],
        "messages": [
          { "from": "client", "to": "server", "label": "SYN seq=100", "time": "0", "note": "The client opens: its first sequence number is 100." },
          { "from": "server", "to": "client", "label": "SYN-ACK seq=300 ack=101", "lost": true, "time": "40", "note": "The reply is dropped on the way back." },
          { "from": "client", "label": "Retransmit timer fires", "time": "1000", "note": "No SYN-ACK within one second." },
          { "from": "client", "to": "server", "label": "SYN seq=100 (again)", "time": "1000", "note": "Same sequence number: it is the same request." },
          { "from": "server", "to": "client", "label": "SYN-ACK seq=300 ack=101", "time": "1040", "note": "This time it arrives." },
          { "from": "client", "to": "server", "label": "ACK ack=301", "time": "1080", "note": "Both sides are ESTABLISHED." }
        ]
      },
      "play": [{ "set": { "pos": 1 } }]
    },
    "chat": {
      "summary": "A chat message delivered and read: one tick when the server has it, two when it is delivered, blue when it is read.",
      "props": {
        "title": "A message, delivered and read",
        "unit": "s",
        "actors": [ { "id": "alice", "label": "Alice" }, { "id": "server", "label": "Chat server" }, { "id": "bob", "label": "Bob" } ],
        "messages": [
          { "from": "alice", "to": "server", "label": "send \"on my way\"", "time": "0.00", "note": "One tick: the server has it." },
          { "from": "server", "label": "store + fan out", "time": "0.02", "note": "Saved once, then pushed to every device of the recipient." },
          { "from": "server", "to": "bob", "label": "push", "time": "0.05", "note": "Two ticks: delivered." },
          { "from": "bob", "to": "server", "label": "read receipt", "time": "4.10", "note": "Bob opens the chat." },
          { "from": "server", "to": "alice", "label": "read", "time": "4.12", "note": "Blue ticks." }
        ]
      },
      "play": [{ "set": { "pos": 3 } }]
    },
    "request": {
      "summary": "A browser asks a server, which asks a database and replies.",
      "props": {
        "actors": [
          { "id": "b", "label": "Browser" },
          { "id": "s", "label": "Server" },
          { "id": "db", "label": "Database" }
        ],
        "messages": [
          { "from": "b", "to": "s", "label": "GET /orders", "reply": false },
          { "from": "s", "to": "s", "label": "check session", "reply": false },
          { "from": "s", "to": "db", "label": "SELECT orders", "reply": false },
          { "from": "db", "to": "s", "label": "rows", "reply": true },
          { "from": "s", "to": "b", "label": "200 OK", "reply": true }
        ]
      },
      "play": [{ "set": { "pos": 4 } }]
    },
    "handshake": {
      "summary": "A two-party handshake.",
      "props": {
        "actors": [ { "id": "client", "label": "" }, { "id": "server", "label": "" } ],
        "messages": [
          { "from": "client", "to": "server", "label": "SYN", "reply": false },
          { "from": "server", "to": "client", "label": "SYN-ACK", "reply": true },
          { "from": "client", "to": "server", "label": "ACK", "reply": false }
        ]
      }
    }
  }
}
