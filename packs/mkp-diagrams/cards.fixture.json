    "database-schema": {
      "summary": "A shop's tables: orders point at customers, order items at orders and products, each foreign key a crow's foot at its many side.",
      "props": {
        "kind": "Schema",
        "title": "A shop",
        "caption": "4 tables · 3 foreign keys",
        "cards": [
          {
            "id": "customers",
            "rows": [
              {
                "id": "id",
                "badges": [
                  "PK"
                ],
                "meta": "uuid"
              },
              {
                "id": "email",
                "meta": "text"
              },
              {
                "id": "country",
                "meta": "char(2)"
              }
            ]
          },
          {
            "id": "orders",
            "rows": [
              {
                "id": "id",
                "badges": [
                  "PK"
                ],
                "meta": "uuid"
              },
              {
                "id": "customer_id",
                "badges": [
                  "FK"
                ],
                "meta": "uuid"
              },
              {
                "id": "placed_at",
                "meta": "timestamptz"
              }
            ]
          },
          {
            "id": "order_items",
            "rows": [
              {
                "id": "order_id",
                "badges": [
                  "PK",
                  "FK"
                ],
                "meta": "uuid"
              },
              {
                "id": "product_id",
                "badges": [
                  "PK",
                  "FK"
                ],
                "meta": "uuid"
              },
              {
                "id": "qty",
                "meta": "int"
              }
            ]
          },
          {
            "id": "products",
            "rows": [
              {
                "id": "id",
                "badges": [
                  "PK"
                ],
                "meta": "uuid"
              },
              {
                "id": "name",
                "meta": "text"
              },
              {
                "id": "price",
                "meta": "numeric"
              }
            ]
          }
        ],
        "links": [
          {
            "from": "orders.customer_id",
            "to": "customers.id",
            "tail": "many"
          },
          {
            "from": "order_items.order_id",
            "to": "orders.id",
            "tail": "many"
          },
          {
            "from": "order_items.product_id",
            "to": "products.id",
            "tail": "many"
          }
        ]
      }
