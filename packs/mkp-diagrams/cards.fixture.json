    "class-diagram": {
      "summary": "Shapes on a canvas: circles and rectangles are kinds of shape, a shape has an origin point, and a canvas holds any number of shapes.",
      "props": {
        "kind": "Classes",
        "title": "Shapes on a canvas",
        "caption": "5 classes",
        "cards": [
          {
            "id": "Shape",
            "aside": "«abstract»",
            "rows": [
              {
                "id": "origin",
                "meta": "Point"
              },
              {
                "id": "area",
                "label": "area()",
                "meta": "number"
              }
            ]
          },
          {
            "id": "Circle",
            "rows": [
              {
                "id": "r",
                "meta": "number"
              },
              {
                "id": "area",
                "label": "area()",
                "meta": "number"
              }
            ]
          },
          {
            "id": "Rect",
            "rows": [
              {
                "id": "w",
                "meta": "number"
              },
              {
                "id": "h",
                "meta": "number"
              },
              {
                "id": "area",
                "label": "area()",
                "meta": "number"
              }
            ]
          },
          {
            "id": "Point",
            "rows": [
              {
                "id": "x",
                "meta": "number"
              },
              {
                "id": "y",
                "meta": "number"
              }
            ]
          },
          {
            "id": "Canvas",
            "rows": [
              {
                "id": "shapes",
                "meta": "Shape[]"
              },
              {
                "id": "draw",
                "label": "draw()",
                "meta": "void"
              }
            ]
          }
        ],
        "links": [
          {
            "from": "Circle",
            "to": "Shape",
            "head": "hollow",
            "tone": "muted"
          },
          {
            "from": "Rect",
            "to": "Shape",
            "head": "hollow",
            "tone": "muted"
          },
          {
            "from": "Shape.origin",
            "to": "Point",
            "tone": "info"
          },
          {
            "from": "Canvas.shapes",
            "to": "Shape",
            "tail": "one",
            "head": "many",
            "tone": "info",
            "label": "0..*"
          }
        ]
      }
    },
    "service-map": {
      "summary": "Checkout calls: the web app calls two services over gRPC, the orders service charges an external payments API, which calls back by webhook.",
      "props": {
        "kind": "Services",
        "title": "Checkout calls",
        "caption": "4 services · 4 calls",
        "cards": [
          {
            "id": "web",
            "aside": "Next.js",
            "rows": [
              {
                "id": "checkout",
                "label": "POST /checkout"
              },
              {
                "id": "account",
                "label": "GET /account"
              }
            ]
          },
          {
            "id": "orders",
            "title": "orders-svc",
            "aside": "Go",
            "rows": [
              {
                "id": "create",
                "label": "CreateOrder"
              },
              {
                "id": "paid",
                "label": "OnPaid"
              }
            ]
          },
          {
            "id": "users",
            "title": "users-svc",
            "aside": "Go",
            "rows": [
              {
                "id": "get",
                "label": "GetUser"
              }
            ]
          },
          {
            "id": "pay",
            "title": "payments",
            "aside": "external",
            "external": true,
            "rows": [
              {
                "id": "charge",
                "label": "POST /charges"
              },
              {
                "id": "hook",
                "label": "webhook"
              }
            ]
          }
        ],
        "links": [
          {
            "from": "web.checkout",
            "to": "orders.create",
            "label": "gRPC"
          },
          {
            "from": "web.account",
            "to": "users.get",
            "label": "gRPC"
          },
          {
            "from": "orders.create",
            "to": "pay.charge",
            "label": "HTTPS",
            "tone": "warn"
          },
          {
            "from": "pay.hook",
            "to": "orders.paid",
            "line": "dashed",
            "tone": "warn",
            "label": "async"
          }
        ]
      }
    },
