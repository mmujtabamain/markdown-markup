{
  "widget": "graph@1",
  "cases": {
    "push-to-live": {
      "summary": "A build pipeline from push to live, left to right: a decision with a retry loop back to the tests, and the security scan beside them.",
      "props": {
        "kind": "Pipeline",
        "title": "From push to live",
        "dir": "right",
        "nodes": [
          {
            "id": "push",
            "label": "Push",
            "kind": "start",
            "detail": "A commit lands on a branch."
          },
          {
            "id": "build",
            "label": "Build image",
            "icon": "box",
            "detail": "Docker build, cached by layer."
          },
          {
            "id": "test",
            "label": "Tests",
            "kind": "process",
            "detail": "Unit and integration suites in parallel."
          },
          {
            "id": "green",
            "label": "All green?",
            "kind": "decision",
            "detail": "Tests and the scan must both pass; a flaky test may be retried."
          },
          {
            "id": "scan",
            "label": "Security scan",
            "icon": "shield",
            "tone": "accent",
            "detail": "Dependencies and the image, beside the tests."
          },
          {
            "id": "deploy",
            "label": "Deploy",
            "icon": "cloud",
            "tone": "info",
            "note": "canary 10%",
            "detail": "Rolled out to one tenth of traffic first."
          },
          {
            "id": "done",
            "label": "Live",
            "kind": "end",
            "detail": "The new version takes all traffic."
          }
        ],
        "edges": [
          {
            "from": "push",
            "to": "build"
          },
          {
            "from": "build",
            "to": "test"
          },
          {
            "from": "build",
            "to": "scan"
          },
          {
            "from": "test",
            "to": "green"
          },
          {
            "from": "scan",
            "to": "green"
          },
          {
            "from": "green",
            "to": "deploy",
            "label": "yes"
          },
          {
            "from": "deploy",
            "to": "done"
          },
          {
            "from": "green",
            "to": "test",
            "label": "retry",
            "line": "dashed",
            "muted": true,
            "back": true
          }
        ]
      },
      "play": [
        {
          "press": "pick.next"
        },
        {
          "wait": 300
        },
        {
          "press": "pick.next"
        },
        {
          "press": "pick.next"
        },
        {
          "press": "pick.next"
        }
      ]
    },
