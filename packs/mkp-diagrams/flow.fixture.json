  "cases": {
    "login": {
      "summary": "Signing in: a decision with a retry loop back up the chart.",
      "props": {
        "steps": [
          {
            "id": "start",
            "label": "Start",
            "kind": "start",
            "detail": "The visitor opens the sign-in page."
          },
          {
            "id": "ask",
