          },
          {
            "id": "home",
            "label": "Show the home page",
            "kind": "step",
            "detail": "Signed in: the home page opens."
          },
          {
            "id": "lock",
            "label": "Lock the account",
            "kind": "step",
            "detail": "Locked until the owner resets the password."
