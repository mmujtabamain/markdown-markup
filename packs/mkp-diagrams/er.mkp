fn mark(c: text, left: bool): text = if(c == "one", "||", if(c == "zero_one", if(left, "|o", "o|"),
    if(c == "many", if(left, "}|", "|{"), if(left, "}o", "o{"))))
fn count(c: text): text = if(c == "one", "1", if(c == "zero_one", "0..1", if(c == "many", "1..*", "0..*")))

er@1 "An entity–relationship diagram: entities with their attributes and keys, joined by named relationships with their cardinalities."
  fields entities rels
  in entities list(record entity {name: text, attrs: list(record attr {type: text, name: text, kind: choice(plain|pk|fk) = plain})}) "tables and their columns; kind marks primary and foreign keys"
  in rels list(record rel {a: text, b: text, label: text = "", left: choice(one|zero_one|many|zero_many) = one, right: choice(one|zero_one|many|zero_many) = zero_many}) "a's side is left, b's side is right"
  names = map(entities, e => e.name)
  good = filter(rels, r => indexof(names, r.a) >= 0 and indexof(names, r.b) >= 0)
  # rows by relationship, as in a layered graph
  links = map(filter(good, r => r.a != r.b), r => {from: r.a, to: r.b})
  rank0 = ranks(map(entities, e => {id: e.name, label: e.name}), links)
  # an entity nothing points at sits just above the nearest thing it points to, so its line stays short
  fn below(nm: text): list(int) = map(filter(links, l => l.from == nm), l => rank0[l.to])
  fn rank(nm: text): int = if(len(filter(links, l => l.to == nm)) == 0 and len(below(nm)) > 0, max(min(below(nm)) - 1, 0), rank0[nm])
  depth = max([0] + map(names, nm => rank(nm)))
  layers = filter(map(range(0, depth), k => map(filter(entities, e => rank(e.name) == k), e => e.name)), r => len(r) > 0)
  # each relationship's name and cardinalities go in a row between the entities, beside its line,
  # and a line that spans rows runs through a lane in each (route.mkp)
  named = map(good, r => {from: r.a, to: r.b, label: if(r.label != "", r.label + " ", "") + count("" + r.left) + ":" + count("" + r.right)})
  lay = route(layers, named)
  byname = index(entities, e => e.name)
  fn tag(c: text): text = if(c == "pk", "PK", if(c == "fk", "FK", ""))
  # in text, each entity's columns, then the relationships with their cardinalities
  project md = (join(map(entities, e => "**" + e.name + "**: " + join(map(e.attrs, c => if(c.kind != plain, tag("" + c.kind) + " ", "")
      + c.name + " `" + c.type + "`"), ", ")), "\n\n")
    + if(len(good) > 0, "\n\n" + join(map(good, r => "- " + r.a + " " + if(r.label != "", r.label + " ", "") + r.b + ", `"
      + count("" + r.left) + ":" + count("" + r.right) + "`"), "\n"), ""))
  project mermaid = ("erDiagram\n"
    + join(map(good, r => "  " + r.a + " " + mark("" + r.left, true) + "--" + mark("" + r.right, false) + " " + r.b + " : \"" + r.label + "\""), "\n") + "\n"
    + join(map(entities, e => "  " + e.name + " {\n" + join(map(e.attrs, c => "    " + c.type + " " + c.name
        + if(c.kind != plain, " " + tag("" + c.kind), "")), "\n") + "\n  }"), "\n"))
  stack gap=xl align=center
    each k in 0..(len(lay.rows) - 1)
      flex gap=xl justify=center align=stretch
        each g in lay.rows[k] key=g.id
          switch on=(g.kind)
            case "node"
              flex wrap=false
                stack id=(g.id) stroke=ink radius=card fill=surface
                  stack pad=s
                    text g.id weight=bold align=center
                  stack pad=s gap=xs
                    # each over a nested record list is refused, so copy the attributes into plain records
                    each c in map(byname[g.id].attrs, a => {type: a.type, name: a.name, kind: "" + a.kind}) key=c.name
                      flex gap=m justify=between wrap=false
                        flex gap=s wrap=false
                          text (tag(c.kind)) font=mono size=small tone=accent if=(c.kind != "plain")
                          text c.name size=small wrap=false
                        text c.type font=mono size=small tone=muted wrap=false
            case "label"
              flex gap=s align=stretch wrap=false
                stack id=(g.id)
                text g.label size=small tone=muted wrap=false
            else
              stack id=(g.id)
  each k in 0..(len(named) - 1)
    arrow from=(named[k].from) to=(named[k].to) via=(lay.via[k])
