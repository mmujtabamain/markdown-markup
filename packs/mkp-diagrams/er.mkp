fn mark(c: text, left: bool): text = if(c == "one", "||", if(c == "zero_one", if(left, "|o", "o|"),
    if(c == "many", if(left, "}|", "|{"), if(left, "}o", "o{"))))
fn count(c: text): text = if(c == "one", "1", if(c == "zero_one", "0..1", if(c == "many", "1..*", "0..*")))

er@1 "An entity–relationship diagram: entities as cards of their attributes and keys, in columns by their relationships, joined row to row with crow's feet; picking an attribute or an entity lights its relationships."
  fields entities rels
  in entities list(record entity {name: text, attrs: list(record attr {type: text, name: text, kind: choice(plain|pk|fk|pkfk) = plain})}) "tables and their columns; kind marks primary and foreign keys (pkfk: both)"
  in rels list(record rel {a: text, b: text, label: text = "", left: choice(one|zero_one|many|zero_many) = one, right: choice(one|zero_one|many|zero_many) = zero_many,
      acol: text = "", bcol: text = ""}) "a's side is left, b's side is right; acol and bcol name the attribute the line meets on each side (by default the foreign key, when the entity has one, and the primary key on the other side)"
  in title text = "Entities and relationships" "the header's title"
  in caption text = "" "a line under the header; by default how many entities and relationships there are"
  in lit text = "" "what starts lit: an entity, or entity.attribute"
  var pick text = lit
  names = map(entities, e => e.name)
  good = filter(rels, r => indexof(names, r.a) >= 0 and indexof(names, r.b) >= 0)
  byname = index(entities, e => e.name)
  fn tag(c: text): text = if(c == "pk", "PK", if(c == "fk", "FK", if(c == "pkfk", "PK, FK", "")))
  fn many(c: text): bool = c == "many" or c == "zero_many"
  fn keyed(nm: text, k: text): list(text) = map(filter(byname[nm].attrs, c => "" + c.kind == k or "" + c.kind == "pkfk"), c => c.name)
  # the side that holds the foreign key: the many side, else the one with a foreign key, else b
  fn fromb(r): bool = if(many("" + r.right) != many("" + r.left), many("" + r.right),
      not (len(keyed(r.a, "fk")) > 0 and len(keyed(r.b, "fk")) == 0))
  # where a line meets an entity: the attribute named, else its only key of that kind, else its title
  fn col(nm: text, given: text, k: text): text = if(given != "", nm + "." + given, if(len(keyed(nm, k)) == 1, nm + "." + keyed(nm, k)[0], nm))
  cards = map(entities, e => {id: e.name, title: e.name, aside: "", external: false,
      rows: map(e.attrs, c => {id: c.name, label: c.name, badges: if("" + c.kind == "pkfk", ["PK", "FK"], if("" + c.kind == "plain", [], [tag("" + c.kind)])), meta: c.type})})
  fn end(c: text): choice(arrow|hollow|one|many|none) = if(many(c), many, one)
  fn linktone(): choice(accent|info|ok|warn|bad|muted|ink) = accent
  fn linkline(): choice(solid|dashed|dotted) = solid
  links = map(good, r => if(fromb(r),
      {from: col(r.b, r.bcol, "fk"), to: col(r.a, r.acol, "pk"), tail: end("" + r.right), head: end("" + r.left), label: r.label, tone: linktone(), line: linkline()},
      {from: col(r.a, r.acol, "fk"), to: col(r.b, r.bcol, "pk"), tail: end("" + r.left), head: end("" + r.right), label: r.label, tone: linktone(), line: linkline()}))
  # in text, each entity's columns, then the relationships with their cardinalities
  project md = (join(map(entities, e => "**" + e.name + "**: " + join(map(e.attrs, c => if("" + c.kind != "plain", tag("" + c.kind) + " ", "")
      + c.name + " `" + c.type + "`"), ", ")), "\n\n")
    + if(len(good) > 0, "\n\n" + join(map(good, r => "- " + r.a + " " + if(r.label != "", r.label + " ", "") + r.b + ", `"
      + count("" + r.left) + ":" + count("" + r.right) + "`"), "\n"), ""))
  project mermaid = ("erDiagram\n"
    + join(map(good, r => "  " + r.a + " " + mark("" + r.left, true) + "--" + mark("" + r.right, false) + " " + r.b + " : \"" + r.label + "\""), "\n") + "\n"
    + join(map(entities, e => "  " + e.name + " {\n" + join(map(e.attrs, c => "    " + c.type + " " + c.name
        + if("" + c.kind != "plain", " " + tag("" + c.kind), "")), "\n") + "\n  }"), "\n"))
  frame kind="Schema" title=title status=(cardsay(cards, links, pick, "Pick an attribute or an entity to light its relationships."))
    pane title=(if(caption != "", caption, len(entities) + " entit" + if(len(entities) == 1, "y", "ies") + " · " + len(good) + " relationship" + if(len(good) == 1, "", "s")))
      # as wide as the pane, or as the cards when they need more: then the pane scrolls, rather
      # than the zoom cutting them off
      flex wrap=false
        stack grow
          zoom
            cardsview cards links pick=pick
