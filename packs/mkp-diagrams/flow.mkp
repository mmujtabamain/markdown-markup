flow@1 "A flowchart: start and end, steps, decisions and input/output, in rows from the start, joined by labelled arrows. Choose a box to light it and its arrows."
  fields steps links
  in steps list(record step {id: text, label: text, kind: choice(start|step|decision|io|end) = step, icon: text = "", tone: text = "", note: text = "", detail: text = ""}) "the boxes, by id; a kind gives each its icon, tone and shape, and icon, tone (info, ok, warn, bad, accent, neutral) and note change them; detail is said in the bar when it is chosen"
  in links list(record link {from: text, to: text, label: text = "", line: choice(solid|dashed|dotted) = solid}) "arrows between ids, with an optional label such as yes or no, and a dashed or dotted line"
  in dir choice(down|right) = down "which way the chart runs"
  in kind text = "Flowchart" "what kind of chart it is, said small before the title"
  in title text = "" "the title"
  ids = map(steps, s => s.id)
  good = filter(links, l => indexof(ids, l.from) >= 0 and indexof(ids, l.to) >= 0)
  marked = map(filter(steps, s => s.kind == start), s => s.id)
  heads = filter(ids, id => len(filter(good, l => l.to == id)) == 0)
  starts = if(len(marked) > 0, marked, if(len(heads) > 0, heads, first(ids, 1)))
  plain = map(good, l => {from: l.from, to: l.to})
  lv0 = levels(ids, starts, plain)
  # a link to the same row or an earlier one is a loop back only if its target leads round to its
  # source; any other link runs down the chart, so its target goes below it
  fn loops(l): bool = lv0[l.to] <= lv0[l.from] and levels(ids, [l.to], plain)[l.from] < 1000
  onward = filter(good, l => not loops(l))
  # rows by the longest path along the links that run down, from the start; anything unreachable
  # goes in rows after the rest
  reached = filter(ids, id => lv0[id] < 1000)
  lr = ranks(map(reached, id => {id: id}), filter(onward, l => lv0[l.from] < 1000 and lv0[l.to] < 1000))
  reach = max([0] + map(reached, id => lr[id]))
  lu = ranks(map(filter(ids, id => lv0[id] >= 1000), id => {id: id}), filter(onward, l => lv0[l.from] >= 1000 and lv0[l.to] >= 1000))
  fn lv(id: text): int = if(lv0[id] >= 1000, reach + 1 + lu[id], lr[id])
  depth = max([0] + map(ids, id => lv(id)))
  layers = filter(map(range(0, depth), r => map(filter(steps, s => lv(s.id) == r), s => s.id)), l => len(l) > 0)
  # lanes for links that cross rows or run back up, and labels in rows of their own (route.mkp)
  lay = route(layers, good)
  byid = index(steps, s => s.id)
  # left to right, a loop back sits first in each column it crosses (nodes.mkp)
  rows = backfirst(lay.rows, flatten(map(filter(range(0, len(good) - 1), k => loops(good[k])), k => lay.via[k])), dir == right)

  # the chosen box, by its place in steps; -1 while none is
  pick = steps (len(steps)) = -1 "step"
  chosen = if(pick >= 0 and pick < len(steps), steps[pick].id, "")
  cards = map(range(0, len(steps) - 1), k => card({id: steps[k].id, label: steps[k].label, kind: if(steps[k].kind == step, "process", "" + steps[k].kind),
      icon: steps[k].icon, tone: steps[k].tone, shape: "", note: steps[k].note, group: ""}, k, litnode(steps[k].id, chosen, plain)))
  lines = map(range(0, len(good) - 1), k => {from: good[k].from, to: good[k].to, via: lay.via[k], line: good[k].line,
      lit: litline(good[k].from, good[k].to, chosen), head: true, dim: chosen != "" and not litline(good[k].from, good[k].to, chosen)})
  fn shape(s: {id: text, label: text, kind: text}): text = if(s.kind == "start" or s.kind == "end", "([\"" + s.label + "\"])",
      if(s.kind == "decision", "{\"" + s.label + "\"}", if(s.kind == "io", "[/\"" + s.label + "\"/]", "[\"" + s.label + "\"]")))
  # in text, each box with where its links go (the labels sit in the layout, so they are said here)
  project md = join(map(steps, s => "- " + s.label + if(len(filter(good, l => l.from == s.id)) > 0,
      " → " + join(map(filter(good, l => l.from == s.id), l => byid[l.to].label + if(l.label != "", " (" + l.label + ")", "")), "; "), "")), "\n")
  project mermaid = ("flowchart " + if(dir == down, "TD", "LR") + "\n"
    + join(map(steps, s => "  " + s.id + shape({id: s.id, label: s.label, kind: "" + s.kind})), "\n") + "\n"
    + join(map(good, l => "  " + l.from + " -->" + if(l.label != "", "|" + l.label + "|", "") + " " + l.to), "\n"))
  frame kind=kind title=title status=(if(chosen == "", told("", ""), told(byid[chosen].label, if(byid[chosen].detail != "", byid[chosen].detail, byid[chosen].note))))
    zoom
      stack pad=l align=center
        layers rows=rows cards=cards lines=lines dir=dir hot=(flatten(map(filter(lines, l => l.lit), l => l.via))) faded=(flatten(map(filter(lines, l => l.dim), l => l.via))) pick=pick
