sequence@1 "A sequence diagram that plays: participants as lanes with dashed lifelines, one row per message with its time, the current message lit and the ones to come faint. A message to its own sender is a note on its lane; a lost one stops half way with a cross; replies are dashed."
  fields actors messages
  in actors list(record actor {id: text, label: text = ""}) "the participants, left to right (up to six)"
  in messages list(record message {from: text, to: text = "", label: text = "", reply: bool = false, lost: bool = false, time: text = "", note: text = ""}) "in the order they are sent: to its own sender (or to none) is a note on that lane; lost never arrives; time is the left column's text; note is said in the bar while it is current"
  in title text = "Who sends what" "the header's title"
  in unit text = "" "the time's unit, said after it in the bar (ms, s)"
  in size size = l "kept for older documents: the diagram is as tall as its rows"

  ids = map(first(actors, 6), a => a.id)
  na = max(len(ids), 1)
  fn name(a: {id: text, label: text}): text = if(a.label != "", a.label, a.id)
  names = map(first(actors, 6), a => name({id: a.id, label: a.label}))
  msgs = filter(messages, mm => indexof(ids, mm.from) >= 0 and (mm.to == "" or indexof(ids, mm.to) >= 0))
  m = len(msgs)
  pos = steps (max(m, 1)) play=1000ms "message"
  blank = {from: "", to: "", label: "", reply: false, lost: false, time: "", note: ""}
  now = at(msgs, pos, blank)

  # the time column: every time padded to one width (mono), so the lanes line up under the header
  tw = max([0] + map(msgs, mm => len(mm.time)))
  fn pad(t: text): text = join(map(range(1, tw - len(t)), j => " "), "") + t
  fn lane(id: text): int = indexof(ids, id)
  fn who(id: text): text = at(names, lane(id), id)

  # one row per message, in half-lanes: lane c's centre is boundary 2c+1 of 2na half-lanes; a row's
  # line runs from boundary p to boundary q, its label centred between them, and its ends are anchors
  # at the end of the cell before p and the start of the cell after q
  rows = map(range(0, m - 1), k => {
    id: "m" + k, k: k, mm: msgs[k],
    a: lane(msgs[k].from),
    b: if(msgs[k].to == "" or msgs[k].to == msgs[k].from, lane(msgs[k].from), lane(msgs[k].to))})
  fn local(r) = r.a == r.b
  fn lost(r) = r.mm.lost and r.a != r.b
  fn rightward(r) = r.b > r.a
  fn leftnote(r) = r.a == na - 1 and na > 1
  fn p(r) = if(local(r), 2 r.a, if(lost(r), min(2 r.a + 1, r.a + r.b + 1), 2 min(r.a, r.b) + 1))
  fn q(r) = if(local(r), 2 r.a + 2, if(lost(r), max(2 r.a + 1, r.a + r.b + 1), 2 max(r.a, r.b) + 1))
  fn ink(k: int): color = if(k == pos, info, ink)

  status = if(m == 0, "No messages.", "**" + now.label + "**" + if(now.time == "", "", " · " + now.time + if(unit == "", "", " " + unit)) +
      if(now.note != "", " — " + now.note, if(now.to == "" or now.to == now.from, " · on " + who(now.from), " · " + who(now.from) + " → " + who(now.to))))

  project mermaid = ("sequenceDiagram\n"
    + join(map(first(actors, 6), a => "  participant " + a.id + if(a.label != "", " as " + a.label, "")), "\n") + "\n"
    + join(map(msgs, mm => if(mm.to == "" or mm.to == mm.from, "  Note right of " + mm.from + ": " + mm.label,
        "  " + mm.from + if(mm.lost, "-x", if(mm.reply, "-->>", "->>")) + mm.to + ": " + if(mm.time == "", "", mm.time + if(unit == "", "", " " + unit) + " · ") + mm.label)
      + if(mm.note == "", "", "\n  Note over " + mm.from + if(mm.to == "" or mm.to == mm.from, "", "," + mm.to) + ": " + mm.note)), "\n"))

  project md = join(map(range(0, m - 1), k => "" + (k + 1) + ". " + if(msgs[k].time == "", "", "`" + msgs[k].time + if(unit == "", "", " " + unit) + "` ") +
      if(msgs[k].to == "" or msgs[k].to == msgs[k].from, "on " + who(msgs[k].from), who(msgs[k].from) + " → " + who(msgs[k].to)) + ": **" + msgs[k].label + "**" +
      if(msgs[k].lost, " (lost)", "") + if(msgs[k].note == "", "", " — " + msgs[k].note)), "\n") + "\n"

  frame kind="Sequence" title=title status=status
    # every message at once: when, who, what and why
    fill details
      stack gap=m
        each r in rows key=r.id
          stack
            text (if(r.mm.time == "", "", r.mm.time + if(unit == "", "", " " + unit) + " · ") + if(local(r), "on " + who(r.mm.from), who(r.mm.from) + " → " + who(r.mm.to))) size=small tone=muted
            text (r.mm.label + if(lost(r), " (lost)", "")) literal=true weight=medium
            text (r.mm.note) size=small if=(r.mm.note != "")
    stack
      # the lanes' names, and the top of each lifeline
      flex gap=m align=end wrap=false pad=s
        text (pad("")) font=mono size=small literal=true if=(tw > 0)
        stack grow
          grid cols=(na)
            each c in 0..(na - 1)
              text (at(names, c, "")) font=mono size=small tone=muted caps=true align=center
          grid cols=(2 na)
            each h in 0..(2 na - 1)
              flex justify=end
                stack id=("top" + floor(h / 2)) if=(mod(h, 2) == 0)
      # one row per message: the current one lit, the ones to come faint; pressing a row goes to it
      each r in rows key=r.id
        press kind=plain selected=(r.k == pos) label=(if(r.mm.time == "", "", r.mm.time + if(unit == "", "", " " + unit) + ": ") + r.mm.label)
          @click set pos=(r.k)
          flex gap=m align=center wrap=false pad=s tint=(if(r.k == pos, info, surface)) dim=(r.k > pos)
            text (pad(r.mm.time)) font=mono size=small tone=(if(r.k == pos, ink, muted)) literal=true if=(tw > 0)
            stack grow
              grid cols=(2 na)
                # before the line: its left end
                stack gap=xs span=(p(r)) if=(p(r) > 0)
                  text "" size=small lines=1
                  flex justify=end
                    stack id=(r.id + if(rightward(r), "a", "b")) if=(not local(r))
                # the label over the line, or a note on its lane: a dot and the text beside it
                stack gap=xs span=(q(r) - p(r))
                  flex justify=center if=(not local(r))
                    text (r.mm.label) size=small literal=true wrap=false tone=(ink(r.k)) weight=(if(r.k == pos, bold, regular))
                  # beside the dot on the side with room: the left of the last lane, else the right
                  grid cols=11 if=(local(r))
                    stack span=5 if=(not leftnote(r))
                    flex justify=end span=5 if=(leftnote(r))
                      text (r.mm.label) size=small literal=true wrap=false tone=(ink(r.k)) weight=(if(r.k == pos, bold, regular))
                    flex justify=center align=center
                      stack pad=s radius=pill fill=(ink(r.k))
                    text (r.mm.label) size=small literal=true wrap=false span=5 tone=(ink(r.k)) weight=(if(r.k == pos, bold, regular)) if=(not leftnote(r))
                # after the line: its right end
                stack gap=xs span=(2 na - q(r)) if=(2 na - q(r) > 0)
                  text "" size=small lines=1
                  flex justify=start
                    stack id=(r.id + if(rightward(r), "b", "a")) if=(not local(r))
              # under the last row, the bottom of each lifeline
              grid cols=(2 na) if=(r.k == m - 1)
                each h in 0..(2 na - 1)
                  flex justify=end
                    stack id=("bot" + floor(h / 2)) if=(mod(h, 2) == 0)
      stack pad=s
  each c in 0..(na - 1)
    arrow from=("top" + c) to=("bot" + c) head=none line=dashed tone=muted dim=true
  each r in rows key=r.id
    arrow from=(r.id + "a") to=(r.id + "b") if=(not local(r) and not lost(r)) tone=(ink(r.k)) bold=(r.k == pos) dim=(r.k > pos) line=(if(r.mm.reply, dashed, solid))
    # a lost message stops half way, with a bar across its end
    arrow from=(r.id + "a") to=(r.id + "b") if=(lost(r)) head=one tone=(ink(r.k)) bold=(r.k == pos) dim=(r.k > pos) line=(if(r.mm.reply, dashed, solid))
