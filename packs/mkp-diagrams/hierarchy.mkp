# a tree's nodes level by level, walked with a work list
# (a recursive fn over the recursive tnode type overflows the checker)
fn levelorder(t: hnode): list(hnode) = iterate({todo: [t], out: []}, 2000, s => if(len(s.todo) == 0, s,
    {todo: slice(s.todo, 1, len(s.todo)) + s.todo[0].kids, out: s.out + [s.todo[0]]})).out

# the Mermaid lines for a tree
fn treelines(t: hnode): list(text) = flatten(map(levelorder(t), n => ["  " + n.id + "[\"" + n.label + "\"]"]
    + map(n.kids, k => "  " + n.id + " --> " + k.id)))

hierarchy@1 "A tidy tree for documents: each node centred above its children, joined by lines; choose a node to light it, its parent and its children."
  fields root
  in root hnode "the root node, with kids nested inside; each may have a kind, icon, tone, note and detail, as graph's nodes do"
  in heads bool = true "arrow heads on the lines (an org chart reads better without)"
  in kind text = "Tree" "what kind of diagram it is, said small before the title"
  in title text = "" "the title"
  all = levelorder(root)
  order = map(all, n => n.id)
  # the chosen node, level by level; -1 while none is
  pick = steps (len(all)) = -1 "node"
  now = if(pick >= 0 and pick < len(all), all[pick], root)
  project mermaid = "flowchart TD\n" + join(treelines(root), "\n")
  project md = join(map(all, n => "- " + n.label + if(n.note != "", " (" + n.note + ")", "") + if(len(n.kids) > 0, " → " + join(map(n.kids, k => k.label), ", "), "")), "\n")
  frame kind=kind title=title status=(if(pick < 0, told("", ""), told(now.label, if(now.detail != "", now.detail, now.note))))
    zoom
      flex justify=center pad=l
        htree node=root chosen=(if(pick < 0, "", now.id)) order=order heads=heads
          @picked set pick=(if(pick == picked.k, -1, picked.k))
