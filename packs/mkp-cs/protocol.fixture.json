{
  "widget": "protocol@1",
  "cases": {
    "tcp": {
      "summary": "A TCP client's connection states, through opening and closing a connection.",
      "props": {
        "states": [
          "CLOSED",
          "SYN_SENT",
          "ESTABLISHED",
          "FIN_WAIT",
          "TIME_WAIT"
        ],
        "moves": [
          {
            "from": "CLOSED",
            "to": "SYN_SENT",
            "on": "connect"
          },
          {
            "from": "SYN_SENT",
            "to": "ESTABLISHED",
            "on": "syn_ack"
          },
          {
            "from": "SYN_SENT",
            "to": "CLOSED",
            "on": "timeout"
          },
          {
            "from": "ESTABLISHED",
            "to": "FIN_WAIT",
            "on": "close"
          },
          {
            "from": "FIN_WAIT",
            "to": "TIME_WAIT",
            "on": "fin"
          },
          {
            "from": "TIME_WAIT",
            "to": "CLOSED",
            "on": "expire"
          }
        ],
        "run": [
          "connect",
          "syn_ack",
          "close",
          "fin",
          "expire"
        ],
        "title": "A TCP client's connection"
      },
      "play": [
        {
          "set": {
            "pos": 2
          }
        },
        {
          "wait": 300
        },
        {
          "set": {
            "pos": 5
          }
        }
      ]
    },
    "turnstile": {
      "summary": "A turnstile, with an event that has no transition from where it is.",
      "props": {
        "states": [
          "locked",
          "open"
        ],
        "moves": [
          {
            "from": "locked",
            "to": "open",
            "on": "coin"
          },
          {
            "from": "open",
            "to": "locked",
            "on": "push"
          }
        ],
        "run": [
          "push",
          "coin",
          "push"
        ],
        "title": "A coin turnstile"
      },
      "play": [
        {
          "set": {
            "pos": 1
          }
        }
      ]
    },
    "order": {
      "summary": "An order's life as states, left to right: paid, packed, shipped and delivered, cancelled on a timeout or a refund, and back to packed when it is returned; one run goes round the return once.",
      "props": {
        "kind": "States",
        "title": "An order's life",
        "dir": "right",
        "states": [
          "Placed",
          "Paid",
          "Packed",
          "Shipped",
          "Delivered",
          "Cancelled"
        ],
        "moves": [
          {
            "from": "Placed",
            "to": "Paid",
            "on": "pay"
          },
          {
            "from": "Paid",
            "to": "Packed",
            "on": "pick"
          },
          {
            "from": "Packed",
            "to": "Shipped",
            "on": "hand over"
          },
          {
            "from": "Shipped",
            "to": "Delivered",
            "on": "scan at door"
          },
          {
            "from": "Placed",
            "to": "Cancelled",
            "on": "timeout",
            "line": "dotted"
          },
          {
            "from": "Paid",
            "to": "Cancelled",
            "on": "refund",
            "line": "dotted"
          },
          {
            "from": "Shipped",
            "to": "Packed",
            "on": "returned",
            "line": "dashed"
          }
        ],
        "run": [
          "pay",
          "pick",
          "hand over",
          "returned",
          "hand over",
          "scan at door"
        ],
        "marks": [
          {
            "state": "Placed",
            "tone": "ok"
          },
          {
            "state": "Paid",
            "tone": "info"
          },
          {
            "state": "Shipped",
            "tone": "info"
          },
          {
            "state": "Delivered",
            "tone": "ok"
          },
          {
            "state": "Cancelled",
            "tone": "bad"
          }
        ]
      },
      "play": [
        {
          "set": {
            "pos": 4
          }
        }
      ]
    }
  }
}
