trace@1 "A program trace: the code beside the state at each step, the note, every variable and the output so far."
  in code list(text) "the program, one line each"
  in lang text = "" "the language, in the header and the Markdown code block"
  in title text = "Step through it" "the header's title"
  in vars list(text) "the variables shown, in order; their rows never come or go, so nothing moves as it plays"
  in run list(record snap {line: int, values: list(text), output: text = "", note: text = "", watch: list(text) = []}) "one record per step: the line about to run (from 1), each variable's value (— while unset), what it printed, a note, and the variables to point out"

  pos = steps (len(run)) play=1600ms "step"
  now = run[pos]
  before = if(pos == 0, now, run[pos - 1])
  fn changed(k) = at(now.values, k, "—") != "—" and (pos == 0 or at(now.values, k, "—") != at(before.values, k, "—"))
  fn watched(k) = len(filter(now.watch, w => w == vars[k])) > 0
  fn wash(k: int): color = if(changed(k), warn, if(watched(k), info, surface))
  fn tone(k: int): color = if(changed(k), warn, if(watched(k), info, ink))
  table = map(range(0, len(vars) - 1), k => {id: vars[k], k: k, value: at(now.values, k, "—"), mark: if(changed(k), "changed", if(watched(k), "watch", ""))})
  printed = filter(map(first(run, pos + 1), s => s.output), o => o != "")

  project md = ("```" + lang + "\n" + join(code, "\n") + "\n```\n\n| step | line | " + join(vars, " | ") + " | output |\n|" +
      join(map(range(0, len(vars) + 2), c => " --- "), "|") + "|\n" +
      join(map(range(0, len(run) - 1), k => "| " + (k + 1) + " | " + run[k].line + " | " +
        join(map(range(0, len(vars) - 1), v => at(run[k].values, v, "")), " | ") + " | " + run[k].output + " |"), "\n") + "\n")

  frame kind=("Trace" + if(lang == "", "", " · " + lang)) title=title status=("**Line " + now.line + "**" + if(now.note == "", "", " — " + now.note))
    flex align=stretch
      pane title="Code" grow basis=m
        code (join(code, "\n")) line=(now.line) grow
      pane title="Variables" note=("after line " + now.line) grow basis=m
        grid cols=3 gap=s pad=m tint=muted
          text "variable" size=small tone=muted caps=true
          text "value" size=small tone=muted caps=true
        divider
        each v in table key=v.id
          stack
            grid cols=3 gap=s pad=m align=center tint=(wash(v.k))
              text (v.id) font=mono literal=true
              text (v.value) font=mono literal=true tone=(tone(v.k)) weight=(if(v.mark == "changed", bold, regular))
              flex justify=end
                # always there, so a row is as tall with a mark as without
                flex pad=s stroke=(wash(v.k)) radius=pill
                  text (v.mark) size=small tone=(tone(v.k)) lines=1
            divider
        fill footer
          flex gap=m align=baseline
            text "output" size=small tone=muted caps=true
            text (if(len(printed) == 0, "—", join(printed, " "))) font=mono literal=true
