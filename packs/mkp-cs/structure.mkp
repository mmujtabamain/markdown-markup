# one item of a structure: an id that follows the value between steps, its label, its place and whether it is marked
type sitem = {id: text, label: text, i: int, on: bool}

# a state's items with ids: the value, plus "#n" for its n-th repeat, so equal values stay apart and each keeps its identity
fn itemsof(items: list(text), marked: list(int)): list(sitem) = map(range(0, len(items) - 1), i =>
    {id: items[i] + "#" + len(filter(range(0, i), j => j < i and items[j] == items[i])), label: items[i], i: i, on: indexof(marked, i) >= 0})

structure@1 "A data structure step by step (array, stack, queue, linked list or binary tree) in a frame: the marked items lit, a note for each step in the bar, played or stepped through."
  in kind choice(array|stack|queue|linked|tree) = array "how the items are laid out"
  in states list(record state {items: list(text), note: text = "", marked: list(int) = []}) "one state per step: the items (front, top or root first; a tree in level order with \"\" for a gap), a note, and the places to mark"
  in title text = "Step by step" "the header's title"

  pos = steps (len(states)) play=1200ms "step"
  st = states[pos]
  items = itemsof(st.items, st.marked)
  real = filter(items, it => it.label != "")
  # a tree in level order: item i has children 2i+1 and 2i+2, at depth floor(log2(i+1))
  fn depth(i) = floor(log(i + 1) / log(2) + 0.000001)
  # the largest state, so the stage keeps one size as it plays
  most = max([1] + map(states, x => len(x.items)))
  spare = map(range(1, most - len(items)), k => "spare" + k)
  maxdepth = max([0] + map(states, x => max([0] + map(filter(range(0, len(x.items) - 1), i => x.items[i] != ""), i => depth(i)))))
  edges = filter(real, it => it.i > 0 and at(st.items, floor((it.i - 1) / 2), "") != "")
  # a tree in rows of places, 2^d at depth d, each node centred over its children's; a row of more
  # than eight places is a row of groups of eight, as a grid has at most twelve columns
  fn place(i: int): {id: text, i: int, label: text, on: bool} = {id: "p" + i, i: i, label: at(st.items, i, ""), on: indexof(st.marked, i) >= 0}
  levels = map(range(0, maxdepth), d => {id: "level" + d, groups: map(range(0, max(1, floor(2^d / 8)) - 1), g => {id: "g" + d + "-" + g,
      places: map(range(2^d - 1 + 8 g, min(2^(d + 1) - 2, 2^d - 1 + 8 g + 7)), i => place(i))})})
  fn cols(n: int): int = max(1, min(12, n))
  fn listmd(s) = join(map(s.items, x => "`" + x + "`"), if(kind == linked, " → ", ", "))
  caption = if(kind == array, "Array", if(kind == stack, "Stack", if(kind == queue, "Queue", if(kind == linked, "Linked list", "Tree"))))
  status = "**Step " + (pos + 1) + "**" + if(st.note == "", "", " — " + st.note)

  project md = join(map(range(0, len(states) - 1), k => "" + (k + 1) + ". " +
      if(kind == tree, "level order: ", if(kind == stack, "top first: ", if(kind == queue, "front first: ", ""))) +
      listmd(states[k]) + if(states[k].note == "", "", " (" + states[k].note + ")")), "\n") + "\n"

  frame kind=caption title=title status=status
    stack gap=m pad=l
      switch on=kind
        case array
          # an index over every cell, as a table's header row
          grid cols=(max(1, min(12, most))) gap=xs
            each it in items key=it.id
              stack id=(it.id) gap=xs
                text ("" + it.i) font=mono size=small tone=muted align=center
                stack pad=m radius=card stroke=(if(it.on, info, muted)) tint=(if(it.on, info, surface))
                  text (it.label) weight=(if(it.on, bold, regular)) tone=(if(it.on, info, ink)) align=center
        case stack
          stack gap=xs
            each it in items key=it.id
              flex gap=m align=center wrap=false
                stack id=(it.id) pad=m radius=card stroke=(if(it.on, info, muted)) tint=(if(it.on, info, surface)) basis=s
                  text (it.label) weight=(if(it.on, bold, regular)) tone=(if(it.on, info, ink)) align=center
                text "← top" font=mono size=small tone=muted caps=true if=(it.i == 0)
            # room for the tallest state, so the frame keeps its height as it plays
            each k in spare key=k
              flex wrap=false
                stack pad=m basis=s
                  text (if(len(items) == 0 and k == "spare1", "empty", "")) tone=muted align=center lines=1
        case queue
          flex gap=s align=center
            text "front" font=mono size=small tone=muted caps=true
            each it in items key=it.id
              stack id=(it.id) pad=m radius=card stroke=(if(it.on, info, muted)) tint=(if(it.on, info, surface))
                text (it.label) weight=(if(it.on, bold, regular)) tone=(if(it.on, info, ink)) align=center
            text "back" font=mono size=small tone=muted caps=true
        case linked
          flex gap=xl align=center
            text "head" font=mono size=small tone=muted caps=true id=head
            each it in items key=it.id
              stack id=(it.id) pad=m radius=card stroke=(if(it.on, info, muted)) tint=(if(it.on, info, surface))
                text (it.label) weight=(if(it.on, bold, regular)) tone=(if(it.on, info, ink)) align=center
            text "null" font=mono size=small tone=muted id=tail
        else
          stack gap=l
            each lv in levels key=lv.id
              grid cols=(cols(len(lv.groups)))
                each gr in lv.groups key=gr.id
                  grid cols=(cols(len(gr.places)))
                    each pl in gr.places key=pl.id
                      flex justify=center
                        stack id=("node" + pl.i) pad=m radius=pill stroke=(if(pl.on, info, muted)) tint=(if(pl.on, info, surface)) if=(pl.label != "")
                          text (" " + pl.label + " ") weight=(if(pl.on, bold, regular)) tone=(if(pl.on, info, ink)) align=center wrap=false
      text "Empty." tone=muted if=(len(real) == 0 and kind != stack)
  each k in 0..(len(items) - 2)
    arrow from=(items[k].id) to=(items[k + 1].id) if=(kind == linked) tone=ink
  arrow from=head to=(items[0].id) if=(kind == linked and len(items) > 0) tone=muted
  arrow from=(items[len(items) - 1].id) to=tail if=(kind == linked and len(items) > 0) tone=muted
  each it in edges key=it.id
    arrow from=("node" + floor((it.i - 1) / 2)) to=("node" + it.i) if=(kind == tree) head=none tone=muted
