# Scales and ticks for charts: shared by chart and axes.

# a "nice" step near raw: 1, 2 or 5 times a power of ten
fn nicestep(raw: num): num = 10^floor(log(raw)) if(raw / 10^floor(log(raw)) < 1.5, 1,
    if(raw / 10^floor(log(raw)) < 3, 2, if(raw / 10^floor(log(raw)) < 7, 5, 10)))

# the multiples of step between lo and hi
fn ticks(lo: num, hi: num, step: num): list(num) = map(
    range(ceil(lo/step - 0.000001), floor(hi/step + 0.000001)), k => k step)

# a tick label: short, with k and M for thousands and millions
fn short(v: num): text = if(abs(v) >= 1000000, "" + v/1000000 + "M",
    if(abs(v) >= 10000, "" + v/1000 + "k", "" + v))

# distinct values, sorted
fn distinct(xs: list(num)): list(num) = sort(
    fold(xs, [], (acc, v) => if(indexof(acc, v) >= 0, acc, acc + [v])), v => v)
