type pt = {x: num, y: num}

chart@1 "A bar, line, dot, area or stem chart of one or more series in a frame, with a light grid, numbered axes and their names, and a key in the bar."
  fields kind
  in kind choice(bar|line|dot|area|stem) = line "how each point is drawn"
  in data list(pt) = [] "one series of points"
  in name text = "" "the name of that series (for the key and the table)"
  in series list(record series {name: text, data: list(pt)}) "more series, each in the next colour"
  in title text = "" "the frame's title; empty: what is plotted against what"
  in xlabel text = "" "what x measures"
  in ylabel text = "" "what y measures"
  in cats list(text) = [] "names for x = 0, 1, 2 …, shown instead of numbers"
  in zero bool = true "keep 0 on the y axis"
  in size size = m "how tall the plot is for its width: s short, m, l tall"

  all = (if(len(data) > 0, [{name: name, data: data}], [])
    + map(series, s => {name: s.name, data: s.data}))
  ns = len(all)
  pts = flatten(map(all, s => s.data))
  xs = map(pts, p => p.x)
  ys = map(pts, p => p.y)
  ux = distinct(xs)

  # y: nice ticks around the data (and 0)
  ylo = if(zero, min(min(ys), 0), min(ys))
  yhi = if(zero, max(max(ys), 0), max(ys))
  ystep = nicestep(if(yhi > ylo, (yhi - ylo)/4, max(abs(yhi), 1)))
  y0 = min(floor(ylo/ystep) ystep, ylo - if(yhi > ylo, 0, ystep))
  y1 = max(ceil(yhi/ystep) ystep, yhi + if(yhi > ylo, 0, ystep))
  yt = ticks(y0, y1, ystep)
  base = if(y0 <= 0 and y1 >= 0, 0, y0)

  # x: bars get a band around each x; marks get a little room at the ends
  xlo = min(xs)
  xhi = max(xs)
  band = if(len(ux) > 1, min(map(range(1, len(ux) - 1), k => ux[k] - ux[k - 1])), 1)
  pad = if(kind == bar, band/2, if(kind == dot or kind == stem, max(band/2, (xhi - xlo)/25), if(xhi > xlo, 0, 1)))
  x0 = xlo - pad
  x1 = xhi + pad
  xt = if(len(cats) > 0 or (kind == bar and len(ux) <= 16), ux, ticks(xlo, xhi, nicestep(max(xhi - xlo, 1)/5)))
  fn xtext(v: num): text = if(len(cats) > 0, at(cats, round(v), ""), short(v))

  # the view: the plot area x0..x1 by y0..y1, with room left of it for the y numbers, under it for
  # the x ones and the x axis's name, and over it for the y axis's name
  asp = if(size == s, 3, if(size == l, 1.7, 2.2))
  pw = x1 - x0
  ph = y1 - y0
  # the x axis's name gets a margin of its own past the plot's right end (some 8 a letter)
  fname = if(xlabel == "", 0, (8 len(xlabel) + 12)/720)
  vx0 = x0 - 0.1 pw
  vx1 = vx0 + 1.115 pw/(1 - fname)
  vy0 = y0 - 0.17 ph
  vy1 = y1 + 0.11 ph
  # a pixel, about, each way (a lesson column is some 720 wide)
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) asp/720

  # the colour of the k-th series: blue, orange, green, red, then round again (accent is the host's
  # own ink in some hosts, so a series never takes it)
  fn chtone(k: int): color = if(mod(k, 4) == 0, info, if(mod(k, 4) == 1, warn, if(mod(k, 4) == 2, ok, bad)))
  showdots = kind == dot or kind == stem or (kind == line and len(pts) <= 30 ns)
  # bars: each series takes a slice of the band
  bw = 0.8 band/ns
  fn bar0(si: int, p: pt): point = (p.x - 0.4 band + si bw + 1.5 px, base)
  fn bar1(si: int, p: pt): point = (p.x - 0.4 band + (si + 1) bw - 1.5 px, p.y)
  fn line(si: int): list(point) = map(sort(all[si].data, p => p.x), p => (p.x, p.y))
  fn area(si: int): list(point) = ([(first(sort(all[si].data, p => p.x), 1)[0].x, base)]
    + line(si) + [(last(sort(all[si].data, p => p.x), 1)[0].x, base)])
  auto = (join(map(filter(all, s => s.name != ""), s => s.name), " and ") + if(len(filter(all, s => s.name != "")) == 0, ylabel, "")
    + if(xlabel != "" and (ylabel != "" or len(filter(all, s => s.name != "")) > 0), " by " + xlabel, ""))
  heading = if(title != "", title, auto)
  what = (if(heading != "", heading, "chart") + ": a " + kind + " chart of "
    + join(map(all, s => if(s.name != "", s.name, "the data")), ", "))

  project md = (if(title != "", "**" + title + "**\n\n", "")
    + "| " + if(xlabel != "", xlabel, "x") + " | "
    + join(map(all, s => if(s.name != "", s.name, if(ylabel != "", ylabel, "y"))), " | ") + " |\n"
    + "|---|" + join(map(all, s => "---:"), "|") + "|\n"
    + join(map(ux, x => "| " + xtext(x) + " | " + join(map(all, s =>
        join(map(filter(s.data, p => p.x == x), p => "" + p.y), ", ")), " | ") + " |"), "\n"))

  frame kind="Chart" title=heading
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=asp size=fill label=what
        # a light grid: across at each y tick, and up at each x tick unless the marks are bars
        layer opacity=0.16
          each t in yt key=t
            line (x0, t) (x1, t) stroke=muted
          each t in xt key=t
            line (t, y0) (t, y1) stroke=muted if=(kind != bar)
        # area fills under their lines
        layer opacity=0.16 if=(kind == area)
          each si in 0..(ns - 1) key=si
            path (area(si)) closed fill=(chtone(si)) stroke=none
        # the axes along the bottom and left, the zero line when 0 is inside, tick marks
        layer
          line (x0, y0) (x1, y0) stroke=muted
          line (x0, y0) (x0, y1) stroke=muted
          line (x0, base) (x1, base) stroke=muted width=1.5 if=(base > y0)
          each t in xt key=t
            line (t, y0 - 3 py) (t, y0 + 3 py) stroke=muted
          each t in yt key=t
            line (x0 - 3 px, t) (x0 + 3 px, t) stroke=muted
        # the marks
        layer
          each si in 0..(ns - 1) key=si
            path (line(si)) stroke=(chtone(si)) width=2.2 if=(kind == line or kind == area)
            each j in 0..(len(all[si].data) - 1)
              rect (bar0(si, all[si].data[j])) (bar1(si, all[si].data[j])) fill=(chtone(si)) stroke=none if=(kind == bar)
              line (all[si].data[j].x, base) (all[si].data[j].x, all[si].data[j].y) stroke=(chtone(si)) width=2 if=(kind == stem)
              place (all[si].data[j].x, all[si].data[j].y) if=(showdots and kind == dot)
                stack pad=s radius=pill fill=(chtone(si)) stroke=surface
              place (all[si].data[j].x, all[si].data[j].y) if=(showdots and kind != dot)
                stack pad=xs radius=pill fill=(chtone(si)) stroke=surface
        # numbers and names, over everything
        layer
          each t in xt key=t
            label (t, y0 - 5 py) "$\val{t}$" tone=muted anchor=s if=(len(cats) == 0 and abs(t) < 10000)
            label (t, y0 - 5 py) (xtext(t)) tone=muted anchor=s if=(len(cats) > 0 or abs(t) >= 10000)
          each t in yt key=t
            label (x0 - 6 px, t) "$\val{t}$" tone=muted anchor=w if=(abs(t) < 10000)
            label (x0 - 6 px, t) (short(t)) tone=muted anchor=w if=(abs(t) >= 10000)
          label (vx1 - 4 px, y0 - 5 py) xlabel tone=muted anchor=sw if=(xlabel != "")
          label (x0 + 8 px, vy1 - 3 py) ylabel tone=muted anchor=se if=(ylabel != "")
    fill bar
      legend if=(ns > 1)
        each si in 0..(ns - 1)
          item (all[si].name) tone=(chtone(si))
