axes@1 "Axes in a frame, with a light grid and numbered ticks, for plotting functions of x, each named in a chip beside it, and marking points."
  in xmin num = -5
  in xmax num = 5
  in ymin num = -3
  in ymax num = 3
  in plots list(record plot {f: expr(x), label: text = ""}) "functions of x, each in the next colour and named beside its curve"
  in marks list(record mark {at: point, label: text = ""}) "points to mark and name"
  in xlabel text = "x"
  in ylabel text = "y"
  in grid bool = true
  in aspect num = 0 "width over height; 0 keeps the ranges' own shape between 1.6 and 2.8"
  in size size = m "kept for older documents: the plot fills its frame"
  in title text = "" "the frame's title; empty: the plots' names"

  xs = xmax - xmin
  ys = ymax - ymin
  asp = if(aspect > 0, aspect, chclamp(xs/ys, 1.6, 2.8))
  xstep = nicestep(xs/9)
  ystep = nicestep(ys/max(3, round(12/asp)))
  # a pixel, about, each way (a lesson column is some 720 wide)
  px = xs/720
  py = ys asp/720
  # where the axes sit: through 0 when it is in range, else along the bottom and left edges
  hasx = ymin <= 0 and ymax >= 0
  hasy = xmin <= 0 and xmax >= 0
  ax = if(hasx, 0, ymin)
  ay = if(hasy, 0, xmin)
  # numbers under the x axis when there is room, else over it; right of the y axis at the left edge
  below = ax - ymin > 20 py
  right = ay - xmin < 34 px
  yleft = ay - xmin > 110 px
  # the ticks to number: clear of the ends, and not where the other axis crosses
  xt = filter(ticks(xmin, xmax, xstep), t => t > xmin + xs/70 and t < xmax - xs/70 and not (hasy and abs(t - ay) < xstep/1000))
  yt = filter(ticks(ymin, ymax, ystep), t => t > ymin + ys/70 and t < ymax - ys/70 and not (hasx and abs(t - ax) < ystep/1000))
  xname = if(xlabel == "x", "$x$", xlabel)
  yname = if(ylabel == "y", "$y$", ylabel)
  # samples far outside the y range are dropped, so a curve leaves the plot instead of running along its edge
  fn clip(y: num): num = if(y >= ymin - 0.05 ys and y <= ymax + 0.05 ys, y, nan)
  # the colour of the k-th plot: blue, orange, green, red, then round again
  fn tone(k: int): color = if(mod(k, 4) == 0, info, if(mod(k, 4) == 1, warn, if(mod(k, 4) == 2, ok, bad)))
  # where a plot's name goes: the first spot inside the view walking along it from its own start,
  # the first plot from the right, the second from the left, the third and fourth from the middle
  fn from(k: int): num = at([0.9, 0.1, 0.5, 0.7], mod(k, 4), 0.9)
  fn way(k: int): num = at([-1, 1, 1, -1], mod(k, 4), -1)
  fn sx(k: int, j: int): num = xmin + chclamp(from(k) + way(k) 0.05 j, 0.04, 0.92) xs
  fn spot(k: int): point = find(map(range(0, 16), j => (sx(k, j), plots[k].f(sx(k, j)))),
      p => p.y == p.y and p.y > ymin + 0.06 ys and p.y < ymax - 0.16 ys, (xmin + 0.9 xs, ymax - 0.16 ys))
  named = filter(plots, p => p.label != "")
  heading = if(title != "", title, join(map(named, p => p.label), " and "))
  what = (if(title != "", title + ": ", "") + "axes from x = " + xmin + " to " + xmax + ", y = " + ymin + " to " + ymax
    + if(len(plots) > 0, ", plotting " + join(map(plots, p => if(p.label != "", p.label, "a function")), ", "), ""))

  project md = (if(title != "", "**" + title + "**\n\n", "") + "*" + what + "*"
    + if(len(marks) > 0, "\n\n| point | " + xlabel + " | " + ylabel + " |\n|---|---:|---:|\n"
      + join(map(marks, m => "| " + m.label + " | " + m.at.x + " | " + m.at.y + " |"), "\n"), ""))

  frame kind="Plot" title=heading
    zoom
      canvas x=(xmin)..(xmax) y=(ymin)..(ymax) aspect=asp size=fill label=what
        layer opacity=0.16 if=grid
          each t in ticks(xmin, xmax, xstep) key=t
            line (t, ymin) (t, ymax) stroke=muted
          each t in ticks(ymin, ymax, ystep) key=t
            line (xmin, t) (xmax, t) stroke=muted
        layer
          line (xmin, ax) (xmax, ax) stroke=muted if=hasx
          line (ay, ymin) (ay, ymax) stroke=muted if=hasy
          each t in xt key=t
            line (t, ax - 3 py) (t, ax + 3 py) stroke=muted
          each t in yt key=t
            line (ay - 3 px, t) (ay + 3 px, t) stroke=muted
        layer
          each k in 0..(len(plots) - 1) key=k
            curve ((t, clip(plots[k].f(t)))) t=(xmin)..(xmax) n=400 stroke=(tone(k)) width=2.2
          each j in 0..(len(marks) - 1) key=j
            place (marks[j].at)
              stack pad=s radius=pill fill=ink stroke=surface
        # numbers, names and chips, over everything
        layer
          each t in xt key=t
            label (t, ax - 5 py) "$\val{t}$" tone=muted anchor=s if=below
            label (t, ax + 4 py) "$\val{t}$" tone=muted anchor=n if=(not below)
          each t in yt key=t
            label (ay - 6 px, t) "$\val{t}$" tone=muted anchor=w if=(not right)
            label (ay + 6 px, t) "$\val{t}$" tone=muted anchor=e if=right
          label (ay - 5 px, ax - 5 py) "$0$" tone=muted anchor=sw if=(hasx and hasy and below and not right)
          label (xmax - 6 px, ax + if(below, 5, 26) py) xname tone=muted anchor=nw
          label (ay + if(yleft, -8, if(right, 24, 8)) px, ymax - 4 py) yname tone=muted anchor=(if(yleft, sw, se))
          each k in 0..(len(plots) - 1) key=k
            label (spot(k).x + 6 px, spot(k).y + 6 py) (plots[k].label) tone=(tone(k)) anchor=ne chip if=(plots[k].label != "")
          each j in 0..(len(marks) - 1) key=j
            label (marks[j].at.x + 6 px, marks[j].at.y + 6 py) (marks[j].label) tone=ink anchor=ne chip if=(marks[j].label != "")
