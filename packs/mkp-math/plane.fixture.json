        { "f": "2 b sin(a pi/180)/c", "after": " s in the air" } ],
      "label": "A projectile's path at the angle, speed and gravity set in the Parameters popover." },
    "play": [ { "wait": 300 }, { "set": { "c": 16 } }, { "wait": 600 } ] },
  "heat-and-region": { "summary": "Wi-Fi signal over a floor from two routers as a heat map, with the region below a usable level outlined and its level in the bar.",
