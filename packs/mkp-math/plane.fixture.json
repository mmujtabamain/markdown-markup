      "regions": [ { "f": "max(-30 - 22 log(1 + sqrt((x - 3)^2 + (y - 4)^2)), -30 - 22 log(1 + sqrt((x - 13)^2 + (y - 7)^2))) - a", "label": "weak", "at": [20.6, 1.2] } ],
