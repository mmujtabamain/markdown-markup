      "xlabel": "distance (m)", "ylabel": "height (m)",
      "params": [
        { "name": "\\theta", "label": "Angle (°)", "min": 5, "max": 85, "step": 1, "value": 40 },
        { "name": "v", "label": "Speed (m/s)", "min": 5, "max": 30, "step": 0.5, "value": 20 },
        { "name": "g", "label": "Gravity (m/s²)", "min": 1.6, "max": 24.8, "step": 0.1, "value": 9.81 } ],
      "curves": [ { "f": "(b cos(a pi/180) t, b sin(a pi/180) t - c t^2/2)", "to": "2 b sin(a pi/180)/c", "label": "path" } ],
      "points": [
        { "at": "(b^2 sin(2a pi/180)/(2c), (b sin(a pi/180))^2/(2c))", "label": "peak" },
        { "at": "(b^2 sin(2a pi/180)/c, 0)", "label": "lands", "tone": "ok" } ],
      "status": [
        { "text": "Lands at **", "f": "b^2 sin(2a pi/180)/c", "after": " m**" },
