fit@1 "Points and a line you drag through them by its two ends, each point's distance to it dashed; the bar says the squared error, the slope and what the best line gets."
  in title text = "Fit a line" "the frame's title"
  in caption text = "Fit" "what kind of figure it is, said small before the title"
  in points list(point) "the data"
  in ends list(point) = [] "where the line's two ends start; empty: level through the data's mean, near the view's sides"
  in xmin num = 0 "left edge"
  in xmax num = 10 "right edge"
  in ymin num = 0 "bottom edge"
  in ymax num = 10 "top edge"
  in xlabel text = "$x$" "the x axis's name"
  in ylabel text = "$y$" "the y axis's name"
  in aspect num = 2.5 "width over height"
  in label text = "" "what the points are, for screen readers"
  in digits int 0..6 = 2 "decimal places in the bar"

  # the best line, by least squares, and the data's middle
  count = len(points)
  mx = mean(map(points, p => p.x))
  my = mean(map(points, p => p.y))
  sxx = sum(map(points, p => (p.x - mx)^2))
  b1 = sum(map(points, p => (p.x - mx) (p.y - my)))/max(sxx, 0.000000001)
  b0 = my - b1 mx
  best = sum(map(points, p => (p.y - b0 - b1 p.x)^2))
  P = drag x=(xmin)..(xmax) y=(ymin)..(ymax) = (at(ends, 0, (xmin + 0.05 (xmax - xmin), my))) "left end"
  Q = drag x=(xmin)..(xmax) y=(ymin)..(ymax) = (at(ends, 1, (xmax - 0.05 (xmax - xmin), my))) "right end"
  slope = (Q.y - P.y)/if(abs(Q.x - P.x) < 0.000000001, 0.000000001, Q.x - P.x)
  fn L(x: num): num = P.y + slope (x - P.x)
  sse = sum(map(points, p => (p.y - L(p.x))^2))

  # the plane (plane.mkp): free units, ticks about nine across
  vx0 = xmin
  vx1 = xmax
  vy0 = ymin
  vy1 = ymax
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) aspect/720
  xstep = nice(vx1 - vx0, 9)
  ystep = nice(vy1 - vy0, max(3, round(12/aspect)))
  hasx = vy0 <= 0 and vy1 >= 0
  hasy = vx0 <= 0 and vx1 >= 0
  axy = if(hasx, 0, vy0)
  axx = if(hasy, 0, vx0)
  below = axy - vy0 > 20 py
  right = axx - vx0 < 34 px
  yleft = axx - vx0 > 110 px
  x85 = vx0 + 0.85 (vx1 - vx0)
  what = if(label != "", label, "" + count + " points and a line through them that you can drag by its ends")

  project md = ("| " + xlabel + " | " + ylabel + " |\n|---:|---:|\n" + join(map(points, p => "| " + p.x + " | " + p.y + " |"), "\n")
    + "\n\nThe best line by least squares is $y = " + num(b0, digits) + if(b1 < 0, " - ", " + ") + num(abs(b1), digits)
    + "x$, with squared error " + num(best, digits) + ".")

  frame kind=caption title=title status="Squared error **\val{num(sse, digits)}** · slope \val{num(slope, digits)} · the best line gets about \val{num(best, digits)}"
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=aspect size=fill label=what
        layer opacity=0.16
          each g in ticks(vx0, vx1, xstep) key=g
            line (g, vy0) (g, vy1) stroke=muted
          each g in ticks(vy0, vy1, ystep) key=g
            line (vx0, g) (vx1, g) stroke=muted
        layer
          line (vx0, axy) (vx1, axy) stroke=muted if=hasx
          line (axx, vy0) (axx, vy1) stroke=muted if=hasy
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            line (g, axy - 3 py) (g, axy + 3 py) stroke=muted
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            line (axx - 3 px, g) (axx + 3 px, g) stroke=muted
        # each point's distance to the line, then the line, then the points
        layer opacity=0.55
          each p in points
            line p (p.x, L(p.x)) stroke=muted width=1.5 dash
        layer
          line (vx0, L(vx0)) (vx1, L(vx1)) stroke=info width=2.2
          each p in points
            place p
              stack pad=s radius=pill fill=warn stroke=surface
        # the line's two ends, with a ring each
        layer opacity=0.2
          circle P (9 px) fill=info
          circle Q (9 px) fill=info
        layer
          circle P (9 px) stroke=info width=1.5
          circle Q (9 px) stroke=info width=1.5
          handle P tone=info
          handle Q tone=info
        layer
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            label (g, axy - 5 py) (tick(g, xstep, false)) tone=muted anchor=s if=below
            label (g, axy + 4 py) (tick(g, xstep, false)) tone=muted anchor=n if=(not below)
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            label (axx - 6 px, g) (tick(g, ystep, false)) tone=muted anchor=w if=(not right)
            label (axx + 6 px, g) (tick(g, ystep, false)) tone=muted anchor=e if=right
          label (vx1 - 6 px, axy + if(below, 5, 26) py) xlabel tone=muted anchor=nw
          label (axx + if(yleft, -8, if(right, 24, 8)) px, vy1 - 4 py) ylabel tone=muted anchor=(if(yleft, sw, se))
          label (x85 + 6 px, clamp(L(x85), vy0 + 4 py, vy1 - 24 py) + 8 py) "fit" tone=info anchor=ne chip
    fill bar
      press emphasis=low
        text "Put back"
        @click reset P Q
