orbit@1 "A point going round the unit circle and its image under f, with the image's path."
  fields f
  in f expr(z: complex): complex = z^2 "the map, in z"
  in title text = "A point going round, and its image" "the frame's title"
  in r num = 1.6 "the plane shows −r..r up and down, and twice that across"
  turn = slider 0..1 step=0.005 play=6s loop=repeat = 0.125 "turn"
  z = exp(2 pi i turn)
  fz = f(z)
  # the plane (plane.mkp): equal units, widened to the aspect
  asp = 2
  vx0 = -r asp
  vx1 = r asp
  vy0 = -r
  vy1 = r
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) asp/720
  xstep = nice(vx1 - vx0, 9)
  ystep = xstep
  fn near(p: complex): point = (p.re + 6 px, p.im + 6 py)
  frame kind="Orbit" title=title status="$\arg z = \val{num(arg(z), 2)}$ · $\lvert f(z) \rvert = \val{num(abs(fz), 2)}$ · $\arg f(z) = \val{num(arg(fz), 2)}$"
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=asp size=fill label="The unit circle with z going round it, and the path of f(z)"
        layer opacity=0.16
          each g in ticks(vx0, vx1, xstep) key=g
            line (g, vy0) (g, vy1) stroke=muted
          each g in ticks(vy0, vy1, ystep) key=g
            line (vx0, g) (vx1, g) stroke=muted
        layer
          line (vx0, 0) (vx1, 0) stroke=muted
          line (0, vy0) (0, vy1) stroke=muted
          each g in numbered(vx0, vx1, xstep, 0, true) key=g
            line (g, -3 py) (g, 3 py) stroke=muted
          each g in numbered(vy0, vy1, ystep, 0, true) key=g
            line (-3 px, g) (3 px, g) stroke=muted
        layer
          circle (0, 0) 1 stroke=muted width=1.5
          curve (f(exp(2 pi i t))) stroke=info width=2.2
          line (0, 0) z stroke=muted width=1.5 dash
          place z
            stack pad=s radius=pill fill=ink stroke=surface
          place fz
            stack pad=s radius=pill fill=info stroke=surface
        layer
          each g in numbered(vx0, vx1, xstep, 0, true) key=g
            label (g, -5 py) (tick(g, xstep, false)) tone=muted anchor=s
          each g in numbered(vy0, vy1, ystep, 0, true) key=g
            label (-6 px, g) (tick(g, ystep, true)) tone=muted anchor=w
          label (-5 px, -5 py) "$0$" tone=muted anchor=sw
          label (vx1 - 6 px, 5 py) "$\operatorname{Re}$" tone=muted anchor=nw
          label (-8 px, vy1 - 4 py) "$\operatorname{Im}$" tone=muted anchor=sw
          label (near(z)) "$z$" tone=ink anchor=ne chip
          label (near(fz)) "$f(z)$" tone=info anchor=ne chip
