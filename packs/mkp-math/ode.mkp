ode@1 "Trajectories of the system x' = f(x, y), y' = g(x, y) from start points you drag, integrated by RK4 over the direction field."
  fields f g
  in f expr(x, y) = y "x′, in x and y"
  in g expr(x, y) = (-x) "y′, in x and y"
  in xmin num = -3
  in xmax num = 3
  in ymin num = -3
  in ymax num = 3
  in time num = 8 "how long to follow each trajectory"
  in h num 0.001..1 = 0.05 "the RK4 step"
  in starts int 1..3 = 2 "how many start points"
  in a point = (1, 0) "where the first start point begins"
  in b point = (0, 2) "the second"
  in c point = (-2, -1) "the third"
  in back bool = false "also follow each trajectory backwards in time"
  in field bool = true "draw the direction field"
  in step num = 1 "grid spacing; 0 picks one"
  in title text = "Trajectories" "the frame's title"
  budget 6000000

  # the view (plane.mkp): the ranges widened about their middle, one unit as long both ways
  asp = 1.8
  xs = xmax - xmin
  ys = ymax - ymin
  wider = xs/ys < asp
  vx0 = if(wider, (xmin + xmax)/2 - ys asp/2, xmin)
  vx1 = if(wider, (xmin + xmax)/2 + ys asp/2, xmax)
  vy0 = if(wider, ymin, (ymin + ymax)/2 - xs/asp/2)
  vy1 = if(wider, ymax, (ymin + ymax)/2 + xs/asp/2)
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) asp/720
  xstep = if(step > 0, step, nice(vx1 - vx0, 9))
  ystep = xstep
  hasx = vy0 <= 0 and vy1 >= 0
  hasy = vx0 <= 0 and vx1 >= 0
  axy = if(hasx, 0, vy0)
  axx = if(hasy, 0, vx0)
  below = axy - vy0 > 20 py
  right = axx - vx0 < 34 px
  yleft = axx - vx0 > 110 px

  P = drag x=(vx0)..(vx1) y=(vy0)..(vy1) = a "start 1"
  Q = drag x=(vx0)..(vx1) y=(vy0)..(vy1) = b "start 2"
  R = drag x=(vx0)..(vx1) y=(vy0)..(vy1) = c "start 3"
  s = slider 0..1 step=0.002 play=6s loop=repeat "time"
  span = max(vx1 - vx0, vy1 - vy0)
  fn v(p: point, k: num): point = (k f(p.x, p.y), k g(p.x, p.y))
  fn add(p: point, q: point, k: num): point = (p.x + k q.x, p.y + k q.y)
  fn rk3(p: point, k1: point, k2: point, k3: point, k4: point): point = (p.x + (k1.x + 2 k2.x + 2 k3.x + k4.x)/6, p.y + (k1.y + 2 k2.y + 2 k3.y + k4.y)/6)
  fn rk2(p: point, k: num, k1: point, k2: point, k3: point): point = rk3(p, k1, k2, k3, v(add(p, k3, 1), k))
  fn rk(p: point, k: num, k1: point, k2: point): point = rk2(p, k, k1, k2, v(add(p, k2, 0.5), k))
  # one classical Runge–Kutta step of size k; a point far outside the view stops moving, which ends the scan
  fn rk4(p: point, k: num): point = if(abs(p.x - (vx0 + vx1)/2) > 4 span or abs(p.y - (vy0 + vy1)/2) > 4 span, p, rk(p, k,
      v(p, k), v(add(p, v(p, k), 0.5), k)))
  m = min(round(time/h), 4000)
  fn path(p: point, k: num): list(point) = scan(p, m, q => rk4(q, k))
  fn whole(p: point): list(point) = if(back, reverse(path(p, -h)) + path(p, h), path(p, h))
  tP = whole(P)
  tQ = if(starts >= 2, whole(Q), [])
  tR = if(starts >= 3, whole(R), [])
  # where each start point has got to at time s
  fn now(p: point): point = at(path(p, h), round(s m), p)
  nP = now(P)
  # the direction field: square cells over the whole view, 15 along the shorter side
  hf = min(vx1 - vx0, vy1 - vy0)/15
  cols = floor((vx1 - vx0)/hf + 0.000001)
  rows = floor((vy1 - vy0)/hf + 0.000001)
  fn cen(i: int, j: int): point = (vx0 + (vx1 - vx0 - cols hf)/2 + (i + 0.5) hf, vy0 + (vy1 - vy0 - rows hf)/2 + (j + 0.5) hf)
  # a short direction mark through a grid point
  fn dirn(q: point, sg: num): point = add(q, v(q, 1), sg 0.38 hf/max(sqrt(f(q.x, q.y)^2 + g(q.x, q.y)^2), 0.000000001))

  frame kind="Phase plane" title=title status="$t = \val{format(s time, 1)}$ · start 1 is at **$(\val{format(nP.x, 2)}, \val{format(nP.y, 2)})$**"
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=asp size=fill label="Trajectories of the system from start points you can drag"
        layer opacity=0.16
          each gx in ticks(vx0, vx1, xstep) key=gx
            line (gx, vy0) (gx, vy1) stroke=muted
          each gy in ticks(vy0, vy1, ystep) key=gy
            line (vx0, gy) (vx1, gy) stroke=muted
        layer
          line (vx0, axy) (vx1, axy) stroke=muted if=hasx
          line (axx, vy0) (axx, vy1) stroke=muted if=hasy
          each gx in numbered(vx0, vx1, xstep, axx, hasy) key=gx
            line (gx, axy - 3 py) (gx, axy + 3 py) stroke=muted
          each gy in numbered(vy0, vy1, ystep, axy, hasx) key=gy
            line (axx - 3 px, gy) (axx + 3 px, gy) stroke=muted
        layer if=field opacity=0.45
          each i in 0..(cols - 1)
            each j in 0..(rows - 1)
              line (dirn(cen(i, j), -1)) (dirn(cen(i, j), 1)) stroke=muted
        layer
          path tP stroke=info width=2.2
          path tQ stroke=warn width=2.2 if=(starts >= 2)
          path tR stroke=ok width=2.2 if=(starts >= 3)
          place nP
            stack pad=s radius=pill fill=info stroke=surface
          place (now(Q)) if=(starts >= 2)
            stack pad=s radius=pill fill=warn stroke=surface
          place (now(R)) if=(starts >= 3)
            stack pad=s radius=pill fill=ok stroke=surface
        # the start points, each in its trajectory's tone, with a ring
        layer opacity=0.2
          circle P (9 px) fill=info
          circle Q (9 px) fill=warn if=(starts >= 2)
          circle R (9 px) fill=ok if=(starts >= 3)
        layer
          circle P (9 px) stroke=info width=1.5
          circle Q (9 px) stroke=warn width=1.5 if=(starts >= 2)
          circle R (9 px) stroke=ok width=1.5 if=(starts >= 3)
          handle P tone=info
          handle Q tone=warn if=(starts >= 2)
          handle R tone=ok if=(starts >= 3)
        layer
          each gx in numbered(vx0, vx1, xstep, axx, hasy) key=gx
            label (gx, axy - 14 py) (tick(gx, xstep, false)) tone=muted if=below
            label (gx, axy + 14 py) (tick(gx, xstep, false)) tone=muted if=(not below)
          each gy in numbered(vy0, vy1, ystep, axy, hasx) key=gy
            label (axx - 6 px, gy) (tick(gy, ystep, false)) tone=muted anchor=w if=(not right)
            label (axx + 6 px, gy) (tick(gy, ystep, false)) tone=muted anchor=e if=right
          label (vx1 - 6 px, axy + if(below, 5, 26) py) "$x$" tone=muted anchor=nw
          label (axx + if(yleft, -8, if(right, 24, 8)) px, vy1 - 4 py) "$y$" tone=muted anchor=(if(yleft, sw, se))
          label (P.x + 10 px, P.y + 10 py) "$1$" tone=info anchor=ne chip if=(starts >= 2)
          label (Q.x + 10 px, Q.y + 10 py) "$2$" tone=warn anchor=ne chip if=(starts >= 2)
          label (R.x + 10 px, R.y + 10 py) "$3$" tone=ok anchor=ne chip if=(starts >= 3)
    fill about
      text "Each line is a trajectory from a start point you can drag, followed for $t$ from 0 to $\val{time}$ (and as far back, when it is traced both ways); the dot is where it has got to at the time in the bar. The short marks are the direction of the flow at each point."
