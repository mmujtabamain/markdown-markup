# A point clamped into a view (the canvas clips lines, but a dot or a label would sit outside it).
fn inside(w: complex, s: num): complex = {re: clamp(w.re, -s, s), im: clamp(w.im, -s, s)}

complex-map@1 "A grid or points in the z-plane and their images under w = f(z), side by side, with a point to drag."
  fields f
  in f expr(z: complex): complex = z^2 "the map, in z"
  in title text = "Where the map sends the plane" "the frame's title"
  in mode choice(grid|points) = grid "map a grid of lines, or the points you give"
  in zs list(point) = [] "the points to map in points mode"
  in r num = 1.5 "the z-plane shows −r..r each way"
  in wr num = 3 "the w-plane shows −wr..wr each way"
  in lines int 2..16 = 6 "grid lines each way, minus one"
  in step num = 1 "background grid spacing"
  p = drag x=(-r)..(r) y=(-r)..(r) = (0.5, 0.5) "z"
  zp = p.x + p.y i
  wp = f(zp)
  cs = map(range(0, lines), k => -r + 2 r k/lines)
  # each plane is a little wider than tall, with equal units (plane.mkp)
  asp = 1.25
  dz = 2 r asp/360
  dw = 2 wr asp/360
  fn zstep(s: num): num = if(step > 0, step, nice(2 s, 6))
  frame kind="Map" title=title status="$z = \val{zp}$ goes to $f(z) = \val{wp}$, with $\lvert f(z) \rvert = \val{num(abs(wp), 2)}$"
    flex align=stretch
      pane title="Domain" note="drag $z$" grow basis=m
        zoom
          canvas x=(-r asp)..(r asp) y=(-r)..(r) aspect=asp size=fill label="The z-plane: a grid or points, and a point z to drag"
            layer opacity=0.16
              each g in ticks(-r asp, r asp, zstep(r)) key=g
                line (g, -r) (g, r) stroke=muted
              each g in ticks(-r, r, zstep(r)) key=g
                line (-r asp, g) (r asp, g) stroke=muted
            layer
              line (-r asp, 0) (r asp, 0) stroke=muted
              line (0, -r) (0, r) stroke=muted
              each g in numbered(-r asp, r asp, zstep(r), 0, true) key=g
                line (g, -3 dz) (g, 3 dz) stroke=muted
              each g in numbered(-r, r, zstep(r), 0, true) key=g
                line (-3 dz, g) (3 dz, g) stroke=muted
            layer if=(mode == grid) opacity=0.7
              each c in cs key=c
                line (-r, c) (r, c) stroke=info width=1.5
                line (c, -r) (c, r) stroke=warn width=1.5
            layer if=(mode == points)
              each q in zs
                place q
                  stack pad=s radius=pill fill=warn stroke=surface
            layer opacity=0.2
              circle p (9 dz) fill=info
            layer
              circle p (9 dz) stroke=info width=1.5
              handle p tone=info
            layer
              each g in numbered(-r asp, r asp, zstep(r), 0, true) key=g
                label (g, -5 dz) (tick(g, zstep(r), false)) tone=muted anchor=s
              each g in numbered(-r, r, zstep(r), 0, true) key=g
                label (-6 dz, g) (tick(g, zstep(r), true)) tone=muted anchor=w
              label (r asp - 6 dz, 5 dz) "$\operatorname{Re} z$" tone=muted anchor=nw
              label (8 dz, r - 4 dz) "$\operatorname{Im} z$" tone=muted anchor=se
              label (zp + 12 dz + 12 dz i) "$z$" tone=info anchor=ne chip
      pane title="Image" note="$w = f(z)$" grow basis=m
        zoom
          canvas x=(-wr asp)..(wr asp) y=(-wr)..(wr) aspect=asp size=fill label="The w-plane: the images under f, and f(z)"
            layer opacity=0.16
              each g in ticks(-wr asp, wr asp, zstep(wr)) key=g
                line (g, -wr) (g, wr) stroke=muted
              each g in ticks(-wr, wr, zstep(wr)) key=g
                line (-wr asp, g) (wr asp, g) stroke=muted
            layer
              line (-wr asp, 0) (wr asp, 0) stroke=muted
              line (0, -wr) (0, wr) stroke=muted
              each g in numbered(-wr asp, wr asp, zstep(wr), 0, true) key=g
                line (g, -3 dw) (g, 3 dw) stroke=muted
              each g in numbered(-wr, wr, zstep(wr), 0, true) key=g
                line (-3 dw, g) (3 dw, g) stroke=muted
            layer if=(mode == grid) opacity=0.7
              each c in cs key=c
                curve (f((-r + 2 r t) + c i)) stroke=info width=1.5
                curve (f(c + (-r + 2 r t) i)) stroke=warn width=1.5
            layer if=(mode == points)
              each q in zs
                place (inside(f(q.x + q.y i), wr)) if=(abs(f(q.x + q.y i)) < 2 wr)
                  stack pad=s radius=pill fill=warn stroke=surface
            layer
              place (inside(wp, wr))
                stack pad=s radius=pill fill=ink stroke=surface
            layer
              each g in numbered(-wr asp, wr asp, zstep(wr), 0, true) key=g
                label (g, -5 dw) (tick(g, zstep(wr), false)) tone=muted anchor=s
              each g in numbered(-wr, wr, zstep(wr), 0, true) key=g
                label (-6 dw, g) (tick(g, zstep(wr), true)) tone=muted anchor=w
              label (wr asp - 6 dw, 5 dw) "$\operatorname{Re} w$" tone=muted anchor=nw
              label (8 dw, wr - 4 dw) "$\operatorname{Im} w$" tone=muted anchor=se
              label (inside(wp, wr) + 8 dw + 8 dw i) "$f(z)$" tone=ink anchor=ne chip
