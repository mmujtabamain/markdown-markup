# Complex numbers as a pack type (spec 6.22): a record with operators, conversions and a display.
type complex = {re: num, im: num}
const i: complex = {re: 0, im: 1}
op from(a: num): complex = {re: a, im: 0}
op point(z: complex): point = (z.re, z.im)
op +(a: complex, b: complex): complex = {re: a.re + b.re, im: a.im + b.im}
op -(a: complex, b: complex): complex = {re: a.re - b.re, im: a.im - b.im}
op -(a: complex): complex = {re: -a.re, im: -a.im}
op *(a: complex, b: complex): complex = {re: a.re b.re - a.im b.im, im: a.re b.im + a.im b.re}
op /(a: complex, b: complex): complex = {re: (a.re b.re + a.im b.im)/(b.re^2 + b.im^2), im: (a.im b.re - a.re b.im)/(b.re^2 + b.im^2)}
# a power through polar form; 0^n is 0
op ^(a: complex, n: num): complex = if(a.re == 0 and a.im == 0, {re: 0, im: 0},
    {re: (a.re^2 + a.im^2)^(n/2) cos(n atan2(a.im, a.re)), im: (a.re^2 + a.im^2)^(n/2) sin(n atan2(a.im, a.re))})
fn exp(z: complex): complex = {re: exp(z.re) cos(z.im), im: exp(z.re) sin(z.im)}
fn arg(z: complex): num = atan2(z.im, z.re)
fn abs(z: complex): num = sqrt(z.re^2 + z.im^2)
fn conj(z: complex): complex = {re: z.re, im: -z.im}
fn re(z: complex): num = z.re
fn im(z: complex): num = z.im
fn show(z: complex): latex = $\val{z.re} + \val{z.im}\,i$
