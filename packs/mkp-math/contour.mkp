type seg = {a: point, b: point}

# where the level c crosses the edge from p (value u) to q (value v), by linear interpolation
fn cross(p: point, q: point, u: num, v: num, c: num): point = (p.x + (q.x - p.x) (c - u)/(v - u), p.y + (q.y - p.y) (c - u)/(v - u))
# the crossings of one edge: none, or one point
fn edge(p: point, q: point, u: num, v: num, c: num): list(point) = if((u >= c) != (v >= c), [cross(p, q, u, v, c)], [])
# marching squares for one cell, corners counter-clockwise from bottom-left; a saddle pairs by the centre value
fn cell(p0: point, p1: point, p2: point, p3: point, v0: num, v1: num, v2: num, v3: num, c: num): list(seg) = pair(
    edge(p0, p1, v0, v1, c) + edge(p1, p2, v1, v2, c) + edge(p2, p3, v2, v3, c) + edge(p3, p0, v3, v0, c),
    ((v0 + v1 + v2 + v3)/4 >= c) == (v0 >= c))
fn pair(e: list(point), same: bool): list(seg) = if(len(e) == 2, [{a: e[0], b: e[1]}],
    if(len(e) == 4, if(same, [{a: e[0], b: e[3]}, {a: e[1], b: e[2]}], [{a: e[0], b: e[1]}, {a: e[2], b: e[3]}]), []))

contour@1 "Contour lines of f(x, y), computed by marching squares, with a point to drag that traces the level through it."
  fields f
  in f expr(x, y) = (x^2 + y^2) "the function"
  in xmin num = -2
  in xmax num = 2
  in ymin num = -2
  in ymax num = 2
  in levels list(num) = [] "the levels to draw; empty picks nine evenly between the lowest and highest value in the ranges"
  in n int 6..48 = 28 "grid cells along the shorter side"
  in probe bool = true "a point to drag, with the level through it"
  in step num = 1 "grid spacing; 0 picks one"
  in title text = "Level curves" "the frame's title"
  budget 16000000

  # the view (plane.mkp): the ranges widened about their middle, one unit as long both ways
  asp = 1.8
  xs = xmax - xmin
  ys = ymax - ymin
  wider = xs/ys < asp
  vx0 = if(wider, (xmin + xmax)/2 - ys asp/2, xmin)
  vx1 = if(wider, (xmin + xmax)/2 + ys asp/2, xmax)
  vy0 = if(wider, ymin, (ymin + ymax)/2 - xs/asp/2)
  vy1 = if(wider, ymax, (ymin + ymax)/2 + xs/asp/2)
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) asp/720
  xstep = if(step > 0, step, nice(vx1 - vx0, 9))
  ystep = xstep
  hasx = vy0 <= 0 and vy1 >= 0
  hasy = vx0 <= 0 and vx1 >= 0
  axy = if(hasx, 0, vy0)
  axx = if(hasy, 0, vx0)
  below = axy - vy0 > 20 py
  right = axx - vx0 < 34 px
  yleft = axx - vx0 > 110 px

  p = drag x=(vx0)..(vx1) y=(vy0)..(vy1) = (1, 0.5) "probe"
  # square cells over the whole view, n along the shorter side
  hc = min(vx1 - vx0, vy1 - vy0)/n
  cols = ceil((vx1 - vx0)/hc - 0.000001)
  rows = ceil((vy1 - vy0)/hc - 0.000001)
  fn gx(a: int): num = vx0 + a hc
  fn gy(b: int): num = vy0 + b hc
  vals = map(range(0, rows), b => map(range(0, cols), a => f(gx(a), gy(b))))
  # the levels come from the given ranges, not the margins the view adds
  inbox = flatten(map(filter(range(0, rows), b => gy(b) >= ymin - hc and gy(b) <= ymax + hc), b =>
      map(filter(range(0, cols), a => gx(a) >= xmin - hc and gx(a) <= xmax + hc), a => vals[b][a])))
  lo = min(inbox)
  hi = max(inbox)
  shown = if(len(levels) > 0, levels, map(range(1, 9), k => round(100 (lo + k (hi - lo)/10))/100))
  # the segments of level c in row b of cells
  fn row(b: int, c: num): list(seg) = flatten(map(range(0, cols - 1), a => cell(
      (gx(a), gy(b)), (gx(a + 1), gy(b)), (gx(a + 1), gy(b + 1)), (gx(a), gy(b + 1)),
      vals[b][a], vals[b][a + 1], vals[b + 1][a + 1], vals[b + 1][a], c)))
  lines = map(shown, c => map(range(0, rows - 1), b => row(b, c)))
  here = f(p.x, p.y)
  mine = map(range(0, rows - 1), b => if(probe, row(b, here), []))
  said = "Levels " + join(map(shown, v => num(v, 2)), ", ") + if(min(shown) < 0, "; the negative ones are dashed.", ".")

  project md = ("*Contour lines of $f(x, y)$ on $[" + xmin + ", " + xmax + "] \times [" + ymin + ", " + ymax + "]$.* " + said)

  frame kind="Contours" title=title status=(if(probe, "$f(\val{format(p.x, 2)}, \val{format(p.y, 2)}) =$ **\val{num(here, 2)}** · the bold line is that level", said))
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=asp size=fill label="Contour lines of the function, and a point to drag"
        layer opacity=0.16
          each g in ticks(vx0, vx1, xstep) key=g
            line (g, vy0) (g, vy1) stroke=muted
          each g in ticks(vy0, vy1, ystep) key=g
            line (vx0, g) (vx1, g) stroke=muted
        layer
          line (vx0, axy) (vx1, axy) stroke=muted if=hasx
          line (axx, vy0) (axx, vy1) stroke=muted if=hasy
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            line (g, axy - 3 py) (g, axy + 3 py) stroke=muted
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            line (axx - 3 px, g) (axx + 3 px, g) stroke=muted
        layer
          each k in 0..(len(shown) - 1)
            each r in lines[k]
              each s in r
                line s.a s.b stroke=info width=1.6 if=(shown[k] >= 0)
                line s.a s.b stroke=warn width=1.6 dash if=(shown[k] < 0)
        layer opacity=0.2 if=probe
          circle p (9 px) fill=info
        layer if=probe
          each r in mine
            each s in r
              line s.a s.b stroke=ink width=2.5
          circle p (9 px) stroke=info width=1.5
          handle p tone=info
        layer
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            label (g, axy - 5 py) (tick(g, xstep, false)) tone=muted anchor=s if=below
            label (g, axy + 14 py) (tick(g, xstep, false)) tone=muted if=(not below)
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            label (axx - 6 px, g) (tick(g, ystep, false)) tone=muted anchor=w if=(not right)
            label (axx + 6 px, g) (tick(g, ystep, false)) tone=muted anchor=e if=right
          label (vx1 - 6 px, axy + if(below, 5, 26) py) "$x$" tone=muted anchor=nw
          label (axx + if(yleft, -8, if(right, 24, 8)) px, vy1 - 4 py) "$y$" tone=muted anchor=(if(yleft, sw, se))
          label (clamp(p.x, vx0, vx1 - 60 px) + 8 px, clamp(p.y, vy0 + 4 py, vy1 - 30 py) + 8 py) "$f = \val{format(here, 2)}$" tone=ink anchor=ne chip if=probe
    fill about
      text said
