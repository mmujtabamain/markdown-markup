vector-field@1 "Arrows of a vector field F(x, y) on a grid, scaled to fit, with a point to drag that reads the field."
  fields f
  in f expr(x, y): point = (-y, x) "the field, as a point (P, Q)"
  in xmin num = -2
  in xmax num = 2
  in ymin num = -2
  in ymax num = 2
  in n int 4..24 = 13 "arrows along the shorter side; the longer side gets as many as fit"
  in scale choice(fit|unit) = fit "fit: lengths in proportion, the longest fills a cell; unit: every arrow the same length"
  in step num = 1 "grid spacing; 0 picks one"
  in title text = "A vector field" "the frame's title"

  # the view (plane.mkp): the ranges widened about their middle, one unit as long both ways
  asp = 1.8
  xs = xmax - xmin
  ys = ymax - ymin
  wider = xs/ys < asp
  vx0 = if(wider, (xmin + xmax)/2 - ys asp/2, xmin)
  vx1 = if(wider, (xmin + xmax)/2 + ys asp/2, xmax)
  vy0 = if(wider, ymin, (ymin + ymax)/2 - xs/asp/2)
  vy1 = if(wider, ymax, (ymin + ymax)/2 + xs/asp/2)
  px = (vx1 - vx0)/720
  py = (vy1 - vy0) asp/720
  xstep = if(step > 0, step, nice(vx1 - vx0, 9))
  ystep = xstep
  hasx = vy0 <= 0 and vy1 >= 0
  hasy = vx0 <= 0 and vx1 >= 0
  axy = if(hasx, 0, vy0)
  axx = if(hasy, 0, vx0)
  below = axy - vy0 > 20 py
  right = axx - vx0 < 34 px
  yleft = axx - vx0 > 110 px

  p = drag x=(vx0)..(vx1) y=(vy0)..(vy1) = (1, 0.5) "probe"
  # square cells over the whole view, n along the shorter side, centred
  h = min(vx1 - vx0, vy1 - vy0)/n
  cols = floor((vx1 - vx0)/h + 0.000001)
  rows = floor((vy1 - vy0)/h + 0.000001)
  ox = vx0 + (vx1 - vx0 - cols h)/2
  oy = vy0 + (vy1 - vy0 - rows h)/2
  fn cen(i: int, j: int): point = (ox + (i + 0.5) h, oy + (j + 0.5) h)
  big = max(map(range(0, cols - 1), i => max(map(range(0, rows - 1), j => len2(f(cen(i, j).x, cen(i, j).y))))))
  # how much to shrink a vector to fit a cell
  fn k(v: point): num = if(len2(v) < 0.000000001, 0, if(scale == unit, 0.8 h/len2(v), 0.9 h/max(big, 0.000000001)))
  # q moved by s times the field's arrow there (the arrows are centred on their grid points)
  fn tip(q: point, s: num): point = (q.x + s k(f(q.x, q.y)) f(q.x, q.y).x, q.y + s k(f(q.x, q.y)) f(q.x, q.y).y)
  # an arrow centred on c along s v, with a head of length l: its shaft (a to b), its tip t and the head's corners
  fn vec(c: point, v: point, s: num, l: num): {a: point, b: point, t: point, h1: point, h2: point, len: num} = {
      a: (c.x - s v.x/2, c.y - s v.y/2),
      b: (c.x + s v.x/2 - 0.8 l v.x/max(len2(v), 0.000000001), c.y + s v.y/2 - 0.8 l v.y/max(len2(v), 0.000000001)),
      t: (c.x + s v.x/2, c.y + s v.y/2),
      h1: (c.x + s v.x/2 - l (v.x + 0.45 v.y)/max(len2(v), 0.000000001), c.y + s v.y/2 - l (v.y - 0.45 v.x)/max(len2(v), 0.000000001)),
      h2: (c.x + s v.x/2 - l (v.x - 0.45 v.y)/max(len2(v), 0.000000001), c.y + s v.y/2 - l (v.y + 0.45 v.x)/max(len2(v), 0.000000001)),
      len: s len2(v)}
  # the field's arrow at c: the head shrinks with a short arrow, as a drawn one does
  fn at2(c: point, v: point): {a: point, b: point, t: point, h1: point, h2: point, len: num} = vec(c, v, k(v), min(6 px, 0.45 k(v) len2(v)))
  # by column (an each takes 200 items at most)
  arrows = map(range(0, cols - 1), i => filter(map(range(0, rows - 1), j => at2(cen(i, j), f(cen(i, j).x, cen(i, j).y))), q => q.len > 1.5 px))
  fp = f(p.x, p.y)
  # the probe's arrow from p: half as long again as the field's there, and never shorter than a cell and a half
  ps = if(len2(fp) < 0.000000001, 0, max(1.5 k(fp), 1.5 h/len2(fp)))
  pa = vec((p.x + ps fp.x/2, p.y + ps fp.y/2), fp, ps, min(10 px, 0.45 ps len2(fp)))
  pt = pa.t

  project md = ("*The field $F(x, y)$ on $[" + xmin + ", " + xmax + "] \times [" + ymin + ", " + ymax + "]$, " + n + " arrows each way"
    + if(scale == unit, ", all the same length", ", in proportion to their length") + ".*")

  frame kind="Field" title=title status="$F(\val{format(p.x, 2)}, \val{format(p.y, 2)}) = (\val{format(fp.x, 2)}, \val{format(fp.y, 2)})$ · length **\val{num(len2(fp), 2)}**"
    zoom
      canvas x=(vx0)..(vx1) y=(vy0)..(vy1) aspect=asp size=fill label="Arrows of the field on a grid, and a point to drag"
        layer opacity=0.16
          each g in ticks(vx0, vx1, xstep) key=g
            line (g, vy0) (g, vy1) stroke=muted
          each g in ticks(vy0, vy1, ystep) key=g
            line (vx0, g) (vx1, g) stroke=muted
        layer
          line (vx0, axy) (vx1, axy) stroke=muted if=hasx
          line (axx, vy0) (axx, vy1) stroke=muted if=hasy
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            line (g, axy - 3 py) (g, axy + 3 py) stroke=muted
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            line (axx - 3 px, g) (axx + 3 px, g) stroke=muted
        layer opacity=0.75
          each col in arrows
            each q in col
              line (q.a) (q.b) stroke=info width=1.3
              path ([q.h1, q.t, q.h2]) closed fill=info stroke=none
        # the probe: its ring, its arrow, the point
        layer opacity=0.2
          circle p (9 px) fill=info
        layer
          line (pa.a) (pa.b) stroke=warn width=2.5 if=(pa.len > 0)
          path ([pa.h1, pa.t, pa.h2]) closed fill=warn stroke=none if=(pa.len > 0)
          circle p (9 px) stroke=info width=1.5
          handle p tone=info
        layer
          each g in numbered(vx0, vx1, xstep, axx, hasy) key=g
            label (g, axy - 5 py) (tick(g, xstep, false)) tone=muted anchor=s if=below
            label (g, axy + 14 py) (tick(g, xstep, false)) tone=muted if=(not below)
          each g in numbered(vy0, vy1, ystep, axy, hasx) key=g
            label (axx - 6 px, g) (tick(g, ystep, false)) tone=muted anchor=w if=(not right)
            label (axx + 6 px, g) (tick(g, ystep, false)) tone=muted anchor=e if=right
          label (vx1 - 6 px, axy + if(below, 5, 26) py) "$x$" tone=muted anchor=nw
          label (axx + if(yleft, -8, if(right, 24, 8)) px, vy1 - 4 py) "$y$" tone=muted anchor=(if(yleft, sw, se))
          label (clamp(pt.x, vx0 + 30 px, vx1 - 40 px) + 6 px, clamp(pt.y, vy0 + 4 py, vy1 - 24 py) + 6 py) "$F$" tone=warn anchor=ne chip

# a vector's length
fn len2(v: point): num = sqrt(v.x^2 + v.y^2)
