vector-field@1 "Arrows of a vector field F(x, y) on a grid, scaled to fit, with a point to drag that reads the field."
  fields f
  in f expr(x, y): point = (-y, x) "the field, as a point (P, Q)"
  in xmin num = -2
  in xmax num = 2
  in ymin num = -2
  in ymax num = 2
  in n int 4..24 = 13 "arrows each way"
  in scale choice(fit|unit) = fit "fit: lengths in proportion, the longest fills a cell; unit: every arrow the same length"
  in step num = 1 "grid spacing"
  p = drag x=(xmin)..(xmax) y=(ymin)..(ymax) = (1, 0.5) "probe"
  hx = (xmax - xmin)/n
  hy = (ymax - ymin)/n
  fn at(a: int, b: int): point = (xmin + (a + 0.5) hx, ymin + (b + 0.5) hy)
  big = max(map(range(0, n - 1), a => max(map(range(0, n - 1), b => len2(f(at(a, b).x, at(a, b).y))))))
  # how much to shrink a vector to fit a cell
  fn k(v: point): num = if(len2(v) < 0.000000001, 0, if(scale == unit, 0.8 min(hx, hy)/len2(v), 0.9 min(hx, hy)/max(big, 0.000000001)))
  # q moved by s times the field's arrow there (the arrows are centred on their grid points)
  fn tip(q: point, s: num): point = (q.x + s k(f(q.x, q.y)) f(q.x, q.y).x, q.y + s k(f(q.x, q.y)) f(q.x, q.y).y)
  fp = f(p.x, p.y)
  canvas x=(xmin)..(xmax) y=(ymin)..(ymax) size=m label="Arrows of the field on a grid, and a point to drag"
    layer opacity=0.35
      each g in ticks(xmin, xmax, step)
        line (g, ymin) (g, ymax) stroke=muted width=0.5
      each g in ticks(ymin, ymax, step)
        line (xmin, g) (xmax, g) stroke=muted width=0.5
    layer
      line (xmin, clamp(0, ymin, ymax)) (xmax, clamp(0, ymin, ymax)) stroke=muted
      line (clamp(0, xmin, xmax), ymin) (clamp(0, xmin, xmax), ymax) stroke=muted
    layer
      each a in 0..(n - 1)
        each b in 0..(n - 1)
          line (tip(at(a, b), -0.5)) (tip(at(a, b), 0.5)) stroke=info arrow
    layer
      line p (tip(p, 1.5)) stroke=accent width=2.5 arrow
      handle p
  text "$F(\val{p.x}, \val{p.y}) = (\val{fp.x}, \val{fp.y})$, length $\val{len2(fp)}$."

# a vector's length
fn len2(v: point): num = sqrt(v.x^2 + v.y^2)
