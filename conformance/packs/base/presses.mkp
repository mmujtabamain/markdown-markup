presses@1 "Every kind of press and its props, counting presses."
  var count int = 0
  var hovered bool = false
  column gap=s
    row gap=xs
      press kind=button emphasis=high id=main
        text "button"
        @click set count=(count + 1)
      press kind=tab selected
        text "tab"
      press kind=option
        text "option"
      press kind=toggle selected=hovered
        text "toggle"
      press kind=switch label="a switch"
      press kind=check mark="A"
        text "check"
      press kind=radio mark="B" selected
        text "radio"
      press kind=plain tone=accent emphasis=low
        text "plain"
      press disabled label="disabled"
        icon name=ban
      press label="hover me" id=hover
        icon name=eye
        @enter set hovered=true
        @leave set hovered=false
    meter value=count max=5 label="presses" tone=ok size=m
    text "\val{count} \val{hovered}"
