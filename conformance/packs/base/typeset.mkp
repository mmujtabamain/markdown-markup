typeset@1 "Every text prop."
  column gap=xs
    text "body, ink, regular, normal" font=body tone=ink weight=regular size=normal align=start
    text "heading, accent, bold, large" font=heading tone=accent weight=bold size=large align=center
    text "mono, muted, medium, small" font=mono tone=muted weight=medium size=small align=end
    text "kept to two lines and cut with an ellipsis, however long this sentence goes on for, which is quite long" lines=2 clip
    text "room for three lines" lines=3
    text "no wrap here at all, even when narrow" wrap=false
    text "**not bold**: literal" literal
    text "caps" caps
    text "c1 c2 c3 c4 c5 c6" tone=c4
