surface@1 "gfx@1: per-pixel colour and a mesh in 3D."
  requires gfx@1
  turn = slider 0..360 step=10 = 30 "turn"
  row gap=s
    canvas x=-2..2 y=-2..2 size=s label="pixels"
      layer
        pixels (hsl(0.5 + 0.2 sin(x), 0.7, 0.5 + 0.2 cos(y))) res=32
    canvas dims=3 x=-2..2 y=-2..2 z=-1..1 view=((turn, 30)) size=s label="mesh"
      layer
        mesh f=(sin(x) cos(y)) n=12 fill=info
