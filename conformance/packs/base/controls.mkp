controlset@1 "Every control: slider (play, loop, per step), toggle, choice, steps (none, track, per step), drag and clock."
  s = slider 0..10 step=1 play=100ms/step loop=bounce "slider"
  f = slider 0..1 = 0.5 "fine"
  t = toggle "toggle"
  c = choice(red|green|blue) = green "colour"
  n = steps 5 none=true track=true play=200ms/step loop=repeat "steps"
  d = drag x=0..2 y=0..1 "drag"
  k = clock "clock"
  column gap=xs
    text "\val{s} \val{f} \val{t} \val{c} \val{n} \val{d} \val{floor(k)}"
    controls n k
