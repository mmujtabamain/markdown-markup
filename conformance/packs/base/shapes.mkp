shapes@1 "Every canvas shape and its props, and a handle to drag."
  p = drag x=-1..1 y=-1..1 = ((0.5, 0.5)) "the point"
  canvas x=-1.2..1.2 y=-1.2..1.2 size=m height=s aspect=1.5 label="shapes"
    layer opacity=0.5
      path [(-1, 0), (1, 0)] stroke=line width=1
      path [(0, -1), (0, 1)] stroke=line dash
    layer
      circle (0, 0) 0.8 stroke=accent width=2 opacity=0.8
      circle p 0 px=6 fill=c2
      path [(-1, -1), (-0.5, -0.2), (0, -0.8)] closed fill=c3 stroke=ink opacity=0.6
      path [(0, 0), p] stroke=c2 width=2 head=arrow
      path [(0.2, -0.9), (0.9, -0.9)] head=dot
      label p "($\val{format(p.x, 1)}$, $\val{format(p.y, 1)}$)" anchor=ne halo dx=4 dy=-4
      label (-1, 1) "corner" anchor=nw size=small chip
      label (1, 1) "big" anchor=se size=large tone=accent opacity=0.7
      image "dot.svg" (0.8, -0.6) 0.3 0.3 "a dot"
      place (-0.6, 0.6)
        text "placed"
      handle p tone=c2
