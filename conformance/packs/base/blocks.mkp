# The Markdown blocks, with every prop they take.
blocks@1 "Every Markdown block: headings, paragraphs, lists, quotes and alerts, code, maths, tables, a divider, an image and a footnote."
  in level int 1..6 = 3
  column gap=s
    heading level "A heading at a level"
    paragraph "A paragraph with **bold**, *italic*, `code`, a [link](https://example.org) and $x^2$ maths.[^n]"
    list ordered start=3
      item
        text "three"
      item
        text "four"
    list
      item checked=yes
        text "done"
      item checked=no
        text "not yet"
    quote
      text "A quote."
    quote alert=warning
      text "A warning."
    code "a = 1\nb = a + 1\nprint(b)" lang="python" line=2 marks=[{line: 3, tone: info, note: "prints 2", from: 0, to: 0}, {line: 1, tone: ok, note: "", from: 1, to: 1}] pickable
    math $\mark{a}{a^2} + \mark{b}{b^2} = c^2$ marks=[{id: "a", tone: c1, note: "one side"}, {id: "b", tone: c2, note: "the other"}]
    divider
    table head=["Name", "Score"] rows=[["Ana", "9"], ["Ben", "7"]] align=[left, right]
    image "dot.svg" "a dot" size=s
    footnote "n"
      text "The footnote's text."
