links@1 "Arrows: every end, line and look, through waypoints, routed, curved and behind."
  row gap=xl align=stretch
    column id=a pad=s stroke=ink
      text "a"
    column id=lane
    column gap=l
      column id=b pad=s stroke=ink
        text "b"
      column id=c pad=s stroke=ink
        text "c"
  arrow from=a to=b "one to many" tail=one head=many tone=accent
  arrow from=a to=c head=hollow line=dashed via=(["lane"]) route=right
  arrow from=b to=c head=dot tail=ring line=dotted dim=true
  arrow from=c to=a head=cross curve bold=true
  arrow from=b to=b head=arrow
  arrow from=a to=c layer=behind opacity=0.3 head=none
  arrow from=c to=b "" head=arrow
