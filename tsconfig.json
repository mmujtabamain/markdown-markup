{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/playground/src/*"
      ],
      "@mkp/shadcn": [
        "packages/shadcn/src/index.tsx"
      ],
      "@mkp/page": [
        "packages/page/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/react/src",
    "packages/shadcn/src",
    "packages/page/src",
    "packages/cli/src",
    "apps/playground/src"
  ]
}
