{
  "name": "xtmd",
  "displayName": "Extended Mark",
  "description": "Extended Mark for VS Code: highlighting, errors as you type, hover, go to definition, outline, completion and formatting from xtmd's own language server, and a live preview drawn by VS Code's own widgets",
  "version": "0.3.0",
  "publisher": "extended-mark",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#151B26",
    "theme": "dark"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mmujtabamain/markdown-markup"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "extended mark",
    "xtmd",
    "markdown",
    "widgets"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:xtmd",
    "onLanguage:xtmd-prose",
    "workspaceContains:**/*.xt.md",
    "workspaceContains:**/*.xtpack"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xtmd",
        "aliases": [
          "Extended Mark",
          "xtmd"
        ],
        "extensions": [
          ".xt.md",
          ".xtpack"
        ],
        "filenamePatterns": [
          "*.xt.md",
          "*.xtpack"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/xtmd-light.svg",
          "dark": "./media/xtmd-dark.svg"
        }
      },
      {
        "id": "xtmd-prose",
        "aliases": [
          "Extended Mark (prose)"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/xtmd-light.svg",
          "dark": "./media/xtmd-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xtmd",
        "scopeName": "source.xtmd",
        "path": "./syntaxes/xtmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml"
        }
      },
      {
        "language": "xtmd-prose",
        "scopeName": "text.xtmd.prose",
        "path": "./syntaxes/xtmd-prose.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml"
        }
      }
    ],
    "commands": [
      {
        "command": "xtmd.preview",
        "title": "Open Preview to the Side",
        "category": "Extended Mark",
        "icon": "$(open-preview)"
      },
      {
        "command": "xtmd.resetState",
        "title": "Reset the Preview's $state",
        "category": "Extended Mark"
      },
      {
        "command": "xtmd.showIr",
        "title": "Show the IR",
        "category": "Extended Mark"
      },
      {
        "command": "xtmd.showMarkdown",
        "title": "Show as Markdown",
        "category": "Extended Mark"
      },
      {
        "command": "xtmd.checkFolder",
        "title": "Check a Folder",
        "category": "Extended Mark"
      },
      {
        "command": "xtmd.migrate",
        "title": "Migrate\u2026",
        "category": "Extended Mark"
      },
      {
        "command": "xtmd.showLog",
        "title": "Show the Log",
        "category": "Extended Mark"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xtmd.preview",
          "when": "editorLangId =~ /^xtmd/ && resourceFilename =~ /\\.xt\\.md$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "xtmd.checkFolder",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "xtmd.migrate",
          "when": "explorerResourceIsFolder || resourceFilename =~ /\\.(xt|mkp)\\.md$/",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "xtmd.preview",
          "when": "editorLangId =~ /^xtmd/"
        },
        {
          "command": "xtmd.resetState",
          "when": "xtmd.previewOpen"
        },
        {
          "command": "xtmd.showIr",
          "when": "editorLangId =~ /^xtmd/"
        },
        {
          "command": "xtmd.showMarkdown",
          "when": "editorLangId =~ /^xtmd/"
        },
        {
          "command": "xtmd.checkFolder"
        },
        {
          "command": "xtmd.migrate"
        }
      ]
    },
    "configuration": {
      "title": "Extended Mark",
      "properties": {
        "xtmd.preview.theme": {
          "type": "string",
          "enum": [
            "editor",
            "light",
            "dark"
          ],
          "default": "editor",
          "description": "The theme the preview draws the page in: the editor's, or light or dark whatever the editor's."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.ir.json",
        "url": "./dist/schemas/ir.schema.json"
      },
      {
        "fileMatch": "*.rir.json",
        "url": "./dist/schemas/rir.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/grammar.test.mjs test/language.test.mjs",
    "vscode": "node build.mjs && node test/vscode.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@extended-mark/dom": "file:../../targets/ts/dom",
    "@extended-mark/embed-live": "file:../../targets/ts/bindings/embed-live",
    "@extended-mark/live": "file:../../targets/ts/bindings/live",
    "@extended-mark/runtime": "file:../../targets/ts/runtime",
    "@extended-mark/wasm": "file:../../targets/ts/wasm",
    "@types/node": "20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "playwright-core": "1.64.1",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "vscode-languageclient": "11.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
