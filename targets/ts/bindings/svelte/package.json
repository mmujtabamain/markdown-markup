{
  "name": "@extended-mark/svelte",
  "version": "0.3.0",
  "description": "Extended Mark documents in Svelte 5, run time: <XtmdDoc src={…} /> or ir={…}, drawn by Svelte itself with core's widgets, on a server and in the browser. No compiler; @extended-mark/svelte-live compiles in the browser",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p . && node scripts/copy-svelte.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build && npm run check && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/view": "file:../view"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "xtmd": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3"
  }
}
