{
  "name": "@mkp/svelte",
  "version": "0.3.0",
  "description": "MKP pages in Svelte 5: <MkpPage ir={…} /> or use:mkp, drawn by @mkp/dom",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p . && node scripts/copy-svelte.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run build && npm run check && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mkp/embed": "file:../embed"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@mkp/cli": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3"
  }
}
