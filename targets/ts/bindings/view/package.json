{
  "name": "@extended-mark/view",
  "version": "0.3.0",
  "description": "What every framework target draws an Extended Mark page from: the page as a tree of plain elements (core's widgets as the web target draws them), and the document it runs, with its $state, refusals and snapshots",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../dom",
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/runtime": "file:../../runtime"
  },
  "devDependencies": {
    "xtmd": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
