{
  "name": "@extended-mark/vue-live",
  "version": "0.3.0",
  "description": "Extended Mark documents in Vue, compiled in the browser as they are edited: <XtmdLiveDoc source={…} />, @extended-mark/wasm's compiler and @extended-mark/vue's <XtmdDoc>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/vue": "file:../vue",
    "@extended-mark/live": "file:../live",
    "@extended-mark/view": "file:../view"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "xtmd": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vue": "3.5.45"
  }
}
