{
  "name": "@mkp/embed-live",
  "version": "0.3.0",
  "description": "MKP documents on the plain web, compiled in the browser as they are edited: new MkpLiveDoc(element, { source }), @mkp/wasm's compiler and @mkp/embed's MkpDoc, drawn by @mkp/dom",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mkp/embed": "file:../embed",
    "@mkp/live": "file:../live"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
