{
  "name": "@mkp/react",
  "version": "0.3.0",
  "description": "MKP pages in React: <MkpPage ir={…} />, drawn by @mkp/dom, safe to render on a server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mkp/embed": "file:../embed"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@mkp/cli": "file:../../cli",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
