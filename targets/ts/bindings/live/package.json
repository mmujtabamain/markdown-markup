{
  "name": "@mkp/live",
  "version": "0.3.0",
  "description": "What every real-time MKP target shares: a document's text compiled in the browser by @mkp/wasm into the IR a run-time target draws, the last page that compiled kept while a draft has errors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mkp/embed": "file:../embed",
    "@mkp/view": "file:../view",
    "@mkp/wasm": "file:../../wasm"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
