{
  "name": "@extended-mark/next",
  "version": "0.3.0",
  "description": "Extended Mark pages in Next.js: <XtmdPage> as a client component, .xtmd imports compiled at build time, and the page's Markdown as HTML for the server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./loader": "./dist/loader.cjs",
    "./xtmd-md": {
      "types": "./xtmd-md.d.ts"
    }
  },
  "files": [
    "dist",
    "xtmd-md.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "xtmd": "file:../../cli",
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/react": "file:../react"
  },
  "peerDependencies": {
    "next": ">=15.3.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
