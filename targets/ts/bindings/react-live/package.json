{
  "name": "@extended-mark/react-live",
  "version": "0.3.0",
  "description": "Extended Mark documents in React, compiled in the browser as they are edited: <XtmdLiveDoc source={…} />, @extended-mark/wasm's compiler and @extended-mark/react's <XtmdDoc>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/dom": "file:../../dom",
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/live": "file:../live",
    "@extended-mark/react": "file:../react",
    "@extended-mark/runtime": "file:../../runtime",
    "@extended-mark/view": "file:../view",
    "@extended-mark/wasm": "file:../../wasm"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "xtmd": "file:../../cli",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
