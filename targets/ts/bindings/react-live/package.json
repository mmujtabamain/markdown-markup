{
  "name": "@mkp/react-live",
  "version": "0.3.0",
  "description": "MKP documents in React, compiled in the browser as they are edited: <MkpLiveDoc source={…} />, @mkp/wasm's compiler and @mkp/react's <MkpDoc>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mkp/dom": "file:../../dom",
    "@mkp/embed": "file:../embed",
    "@mkp/live": "file:../live",
    "@mkp/react": "file:../react",
    "@mkp/runtime": "file:../../runtime",
    "@mkp/view": "file:../view",
    "@mkp/wasm": "file:../../wasm"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@mkp/cli": "file:../../cli",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
