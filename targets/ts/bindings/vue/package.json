{
  "name": "@extended-mark/vue",
  "version": "0.3.0",
  "description": "Extended Mark documents in Vue 3, run time: <XtmdDoc src={…} /> or ir={…}, drawn by Vue itself with core's widgets, on a server and in the browser. No compiler; @extended-mark/vue-live compiles in the browser",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/embed": "file:../embed",
    "@extended-mark/view": "file:../view"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "xtmd": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vue": "3.5.45"
  }
}
