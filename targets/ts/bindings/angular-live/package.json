{
  "name": "@extended-mark/angular-live",
  "version": "0.3.0",
  "description": "Extended Mark documents in Angular, compiled in the browser as they are edited: <XtmdLiveDoc source={…} />, @extended-mark/wasm's compiler and @extended-mark/angular's <XtmdDoc>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "ngc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@extended-mark/angular": "file:../angular",
    "@extended-mark/live": "file:../live",
    "@extended-mark/view": "file:../view"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "xtmd": "file:../../cli",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  }
}
