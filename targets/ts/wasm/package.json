{
  "name": "@mkp/wasm",
  "version": "0.3.0",
  "description": "The MKP compiler as WebAssembly, for a real-time target: a document's text in, the IR mkp build writes out, in the browser",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mkp.wasm": "./mkp.wasm"
  },
  "files": [
    "dist",
    "mkp.wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "wasm": "../../rust/wasm/build.sh",
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@mkp/cli": "file:../cli",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
