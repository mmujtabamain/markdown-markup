package t;

// core's own tests: every let named check_ is worked out when the file is compiled, and has to be true

let check_exact: bool = 0.1 + 0.2 == 0.3;
let check_third: bool = (1 / 3) * 3 != 1;
let check_rem: bool = 7 % 2 == 1 && -7 % 2 == -1;
let check_round: bool = (2.5).round() == 3 && (-2.5).round() == -3;
let check_floor: bool = (7 / 2).floor() == 3 && (-3.5).ceil() == -3;
let check_sqrt: bool = (16).sqrt().or(0) == 4 && (-4).sqrt() == opt.NONE;
let check_pow: bool = (2).pow(10).or(0) == 1024 && (0).pow(-1) == opt.NONE;
let check_ln: bool = (0).ln() == opt.NONE && (1).ln().or(9) == 0;
let check_fmt: bool = (3.14159).fmt(2) == "3.14" && (2).fmt(1) == "2.0";
let check_show: bool = "\{42.50}" == "42.5" && "\{7 / 2}" == "3.5";
let check_clamp: bool = (15).clamp(0, 10) == 10 && (-5).clamp(0, 10) == 0;
let check_min_max: bool = (3).min(5) == 3 && (3).max(5) == 5;
let check_sign: bool = (-3).sign() == -1 && (0).abs() == 0;
let check_pi: bool = pi > 3.1415 && pi < 3.1416;
let check_duration: bool = "\{2s}" == "2s" && "\{250ms}" == "250ms" && (2s).ms() == 2000;

let check_len: bool = "héllo".len() == 5;
let check_slice: bool = "hello".slice(1, 3) == "ell" && "hi".slice(1, 10) == "i";
let check_starts: bool = "hello".starts("he") && "hello".ends("lo") && !"hello".ends("x");
let check_like: bool = " Hello ".like("hello");
let check_replace: bool = "a-b-c".replace("-", "+") == "a+b+c";
let check_split: bool = "a,b,c".split(",").len() == 3;
let check_number: bool = "-7".number().or(0) == -7 && "07".number().or(0) == 7 && "1e3".number() == opt.NONE && " 5".number() == opt.NONE;
let check_case: bool = "abc".upper() == "ABC" && "ÄB".lower() == "äb";
let check_chars: bool = "abc".chars().join("-") == "a-b-c";
let check_order: bool = "apple" < "banana" && !("b" < "a");
let check_trim: bool = "  x ".trim() == "x" && "hello".has("ell");
