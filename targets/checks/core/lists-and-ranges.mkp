package t;

let nums: list<number> = [3, 1, 2];

let check_sorted: bool = nums.sorted() == [1, 2, 3];
let check_reversed: bool = nums.reversed() == [2, 1, 3];
let check_sum: bool = nums.sum().or(0) == 6;
let check_some_all: bool = nums.some(fn(x) { return x > 2; }) && !nums.all(fn(x) { return x > 2; });
let check_count: bool = nums.count(fn(x) { return x >= 2; }) == 2;
let check_find: bool = nums.find(fn(x) { return x < 3; }).or(0) == 1;
let check_filter: bool = nums.filter(fn(x) { return x != 1; }) == [3, 2];
let check_map: bool = nums.map(fn(x) { return x * 2; }) == [6, 2, 4];
let check_first_last: bool = nums.first().or(0) == 3 && nums.last().or(0) == 2;
let check_at: bool = nums[5] == opt.NONE && nums[1].or(0) == 1 && nums.at(0.5) == opt.NONE;
let check_has: bool = nums.has(2) && !nums.has(9);
let check_position: bool = nums.position(2).or(-1) == 2;
let check_unique: bool = [1, 1, 2].unique() == [1, 2];
let check_join: bool = nums.join(", ") == "3, 1, 2";
let check_len: bool = nums.len() == 3;

let check_in: bool = 5 in 1..10 && !(11 in 1..10) && 1 in 1...;
let check_step: bool = 6 in 0..10 step 2 && !(5 in 0..10 step 2);
let check_negate: bool = range.negate(1..10) == -10..-1;
let check_shift: bool = range.shift(1..10, 5) == 6..15;
let check_scale: bool = range.scale(1..10, 2) == 2..20 && range.scale(1..10, -1) == -10..-1;
let check_widen: bool = range.widen(1..10, 1) == 0..11;
let check_overlap: bool = range.overlap(1..10, 5..20).or(0..0) == 5..10 && range.overlap(1..3, 5..7) == opt.NONE;
let check_span: bool = range.span(1..3, 7..9) == 1..9;
let check_ends: bool = (1..10).low().or(0) == 1 && (1...).high() == opt.NONE;
