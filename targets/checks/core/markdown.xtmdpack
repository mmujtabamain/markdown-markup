package t;

fn read(s: text): rich_text {
    return rich_text.from(template.of(s)).or(rich_text.plain("<none>"));
}

fn seg(s: text): segment {
    return segment { part = part.TEXT(s) };
}

let check_plain: bool = read("hello").show() == "hello";
let check_bold: bool = read("a **b** c") == rich_text { segments = [seg("a "), segment { part = part.TEXT("b"), marks = marks { bold = true } }, seg(" c")] };
let check_italic: bool = read("*a*") == rich_text { segments = [segment { part = part.TEXT("a"), marks = marks { italic = true } }] };
let check_underscore: bool = read("snake_case_name").show() == "snake_case_name";
let check_both: bool = read("***x***") == rich_text { segments = [segment { part = part.TEXT("x"), marks = marks { bold = true, italic = true } }] };
let check_code: bool = read("use `x + 1` here") == rich_text { segments = [seg("use "), segment { part = part.CODE("x + 1") }, seg(" here")] };
let check_link: bool = read("[docs](/docs)") == rich_text { segments = [segment { part = part.TEXT("docs"), marks = marks { link = "/docs" } }] };
let check_auto: bool = read("<https://x.org>") == rich_text { segments = [segment { part = part.TEXT("https://x.org"), marks = marks { link = "https://x.org" } }] };
let check_bare: bool = read("see www.x.org.") == rich_text { segments = [seg("see "), segment { part = part.TEXT("www.x.org"), marks = marks { link = "http://www.x.org" } }, seg(".")] };
let check_escape: bool = read("\\*not\\*").show() == "*not*";
let check_entity: bool = read("&copy; &amp;").show() == "© &";
let check_html: bool = read("a <b>c</b>").show() == "a <b>c</b>";
let check_strike: bool = read("~~gone~~") == rich_text { segments = [segment { part = part.TEXT("gone"), marks = marks { strike = true } }] };
let check_break: bool = read("a\\\nb") == rich_text { segments = [seg("a"), segment { part = part.BREAK }, seg("b")] };
let check_soft: bool = read("a\nb").show() == "a\nb";
let check_image: bool = read("![a cat](cat.png)") == rich_text { segments = [segment { part = part.IMAGE("cat.png", "a cat") }] };
let check_note: bool = read("x[^1]") == rich_text { segments = [seg("x"), segment { part = part.NOTE("1") }] };
let check_maths: bool = read("$x^2$").segments.len() == 1 && read("costs $5 and $6").show() == "costs $5 and $6";
let check_bad_maths: bool = rich_text.from(template.of("$x^$")) == opt.NONE;
let check_reference: bool = rich_text.read(template.of("[a][b]"), map { entries = [{ key = "b", value = "/u" }] }) == rich_text { segments = [segment { part = part.TEXT("a"), marks = marks { link = "/u" } }] };
let check_hole: bool = rich_text.from(template { pieces = ["*a ", " b*"], holes = [hole.TEXT("x")] }).or(rich_text.plain("")).segments.len() == 3;

fn blocks(s: text): list<block> {
    return md.from(template.of(s)).or(md { blocks = [] }).blocks;
}

let check_md_blocks: bool = blocks("# T\n\n- a\n- b\n") == [block.HEADING(1, read("T")), block.BULLETS(false, 1, [list_item { body = [block.PARAGRAPH(read("a"))] }, list_item { body = [block.PARAGRAPH(read("b"))] }])];
let check_md_code: bool = blocks("```xtmd\nx\n```\n\n    y\n") == [block.CODE("x\n", "xtmd"), block.CODE("y\n", "")];
let check_md_quote: bool = blocks("> a\nb\n\n---\n") == [block.QUOTE([block.PARAGRAPH(read("a\nb"))]), block.DIVIDER];
let check_md_tasks: bool = blocks("- [x] done\n- [ ] not\n") == [block.BULLETS(false, 1, [list_item { done = true, body = [block.PARAGRAPH(read("done"))] }, list_item { done = false, body = [block.PARAGRAPH(read("not"))] }])];
let check_md_table: bool = blocks("| a | b |\n|:--|--:|\n| 1 | 2 |\n") == [block.TABLE([read("a"), read("b")], [[read("1"), read("2")]], [cell_align.START, cell_align.END])];
let check_md_reference: bool = blocks("[x][d]\n\n[d]: /u\n") == [block.PARAGRAPH(rich_text { segments = [segment { part = part.TEXT("x"), marks = marks { link = "/u" } }] })];
let check_md_empty: bool = blocks("\n\n") == [] && blocks("#\n") == [block.HEADING(1, read(""))];
let written: md = "## Hi\n\nthere";
let check_md_literal: bool = written.blocks.len() == 2;
let check_bare_ftp: bool = read("at ftp://x.org.") == rich_text { segments = [seg("at "), segment { part = part.TEXT("ftp://x.org"), marks = marks { link = "ftp://x.org" } }, seg(".")] };
