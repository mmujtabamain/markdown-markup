  "source": "a-slot-follows-the-inputs-it-reads.mkp.md",
  "target": {
    "levels": [
      "core.draw",
      "core.live"
    ]
  },
  "expect": {
    "diagnostics": []
  },
  "steps": [
    {
      "do": {"event": {"site": "s1/s0", "name": "click"}},
      "expect": {
        "state": {"votes": {"num": "1"}},
        "tree": {
          "s0/s2": {"widget": "core/label", "props": {"value": {"text": "1"}}}
        }
      }
    }
  ]
}
