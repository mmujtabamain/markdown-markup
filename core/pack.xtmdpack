package core;

//@about The standard library, imported by every file. Everything below is written in Extended Mark or declared extern, as any pack is.
pack core@1 {
    provides shown, same, ordered, numeric, scaled, literal, int;
    provides map, date, moment, template, hole, latex, can_draw_tex, md, block, list_item, rich_text, segment, part, marks;
    provides point, region, pi, euler;
    provides color_value, font_value, shadow_value, color, space, size, radius, font, shadow, stroke;
    provides align, justify, weight, text_size, press_kind, edge, overlay_mode, axis, anchor, head, width, theme, track, cols, glyph;
    provides page;
    provides flex, grid, cell, sizing, plane, spot;
    provides paragraph, heading, bullets, item, quote, code, math, table, footnote, divider, cell_align;
    provides label, image, icon, press, field, slider, overlay;
    provides canvas, layer, shape, circle, path, place, handle, pixel, shade, rect;
    provides grow, shrink, basis, min_size, max_size, aspect, column, row, stack, meter, frame, pane, blocks;
}
